#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

# CONFIG/INSTALL :: sourced by setup
# Installer functions for every tool setup manages.
# Functions only - this file is never executed on its own.

# ******************************************************************************

# DEPS :: additional -----------------------------------------------------------
install_dependencies_additional() {
  print_info2 "\n🚀 DEPS :: installing additional base services"

  if ! command -v fzf &>/dev/null; then
    print_notes "   📦 installing fzf (needed for package selection)..."
    apt_install "   ⏳ installing fzf..." fzf || return 1
  fi

  local tools=(
    "curl:URL retrieval tool"
    "git:Version control system"
    "git-delta:Git diff viewer"
    "pigz:Parallel gzip"
    "jq:JSON processor"
    "rsync:File synchronization"
    "wl-clipboard:Wayland clipboard tools"
    "eza:Modern ls replacement"
    "bat:Cat with syntax highlighting"
    "ripgrep:Fast text search"
    "fd-find:Find alternative"
  )

  local selections rc
  selections=$(fzf_multi_select "Select packages > " "📦 select packages (Tab to toggle, Enter to confirm):" select-all "${tools[@]}") || {
    rc=$?
    [[ $rc -eq 130 ]] && { print_notes "   💡 selection cancelled, skipping"; sudo_drop; return 0; }
    return "$rc"
  }

  local -a pkgs=()
  if [[ -n "$selections" ]]; then
    mapfile -t pkgs <<< "$selections"
    print_notes "   📦 installing: ${pkgs[*]}"
    apt_install "   ⏳ installing packages, this can take a minute..." "${pkgs[@]}" || return 1
  else
    print_notes "   💡 no packages selected, skipping"
  fi

  if [[ " ${pkgs[*]} " == *" rsync "* ]]; then
    print_notes "   ⚙️ disabling rsync systemd service..."
    $RUN_WITH_SUDO systemctl disable rsync.service &>/dev/null
    $RUN_WITH_SUDO systemctl mask rsync.service &>/dev/null
  fi

  sudo_drop
  print_info2 "✅ DEPS :: base services installed!"
}

# DEPS :: dev ------------------------------------------------------------------
install_dependencies_dev() {
  print_info2 "\n🚀 DEPS :: installing dev dependencies"

  require_cmds fzf || return 1

  local tools=(
    "node:Node.js runtime (snap)"
    "rustup:Rust toolchain manager (snap)"
    "go:Go programming language (snap)"
    "shellcheck:Shell script analyzer (snap)"
    "httpie:HTTPie API client (snap)"
    "python-dev:Python dev tools (pip, venv) (apt)"
    "lazygit:Git TUI (go install)"
    "uv-prek:uv + prek package tools (pip)"
  )

  local selections rc
  selections=$(fzf_multi_select "Select dev tools > " "📦 select dev packages (Tab to toggle, Enter to confirm):" "" "${tools[@]}") || {
    rc=$?
    [[ $rc -eq 130 ]] && { print_notes "   💡 selection cancelled, skipping"; return 0; }
    return "$rc"
  }

  [[ -z "$selections" ]] && { print_notes "   💡 no dev packages selected, skipping"; return 0; }

  # Keep the run order identical to the menu. fzf returns matches in score
  # order once a query is typed, which would otherwise make the log jump.
  local -a selections_arr=()
  local tool name
  for tool in "${tools[@]}"; do
    name="${tool%%:*}"
    if grep -Fxq -- "$name" <<< "$selections"; then
      selections_arr+=("$name")
    fi
  done
  print_notes "   📋 selected (${#selections_arr[@]}) :: ${selections_arr[*]}"

  local sel
  local -a apt_pkgs=()

  print_notes ""
  print_notes "   ⚙️  phase 1 :: install packages"
  for sel in "${selections_arr[@]}"; do
    case "$sel" in
      node)       print_notes "   📦 node       :: snap (classic)";        snap_install node --classic ;;
      rustup)     print_notes "   📦 rustup     :: snap (classic)";        snap_install rustup --classic ;;
      go)         print_notes "   📦 go         :: snap (classic)";        snap_install go --classic ;;
      shellcheck) print_notes "   📦 shellcheck :: snap";                 snap_install shellcheck ;;
      httpie)     print_notes "   📦 httpie     :: snap";                 snap_install httpie ;;
      python-dev) print_notes "   📦 python-dev :: apt (pip, venv, dev)"; apt_pkgs+=(python3-pip python3-venv python3-dev) ;;
    esac
  done

  if ((${#apt_pkgs[@]} > 0)); then
    apt_install "   ⏳ installing ${apt_pkgs[*]} (sudo may ask for your password)..." "${apt_pkgs[@]}" || return 1
  fi

  sudo_drop

  print_notes ""
  print_notes "   ⚙️  phase 2 :: configure tools"
  for sel in "${selections_arr[@]}"; do
    case "$sel" in
      rustup)
        print_notes "   ⚙️ rustup     :: install or update the 'stable' toolchain"
        run_quiet rustup update stable
        run_quiet rustup default stable
        ;;
      lazygit)
        if ! command -v go &>/dev/null; then
          print_error "   ❌ lazygit    :: 'go' not found - select 'go' or install it manually"
        else
          print_notes "   ⚙️ lazygit    :: go install github.com/jesseduffield/lazygit@latest"
          run_quiet go install github.com/jesseduffield/lazygit@latest
        fi
        ;;
      uv-prek)
        if ! command -v python3 &>/dev/null; then
          print_error "   ❌ uv-prek    :: 'python3' not found - select 'python-dev' or install it manually"
        else
          print_notes "   ⚙️ uv-prek    :: create $HOME/.venv (with upgraded pip) and install uv + prek"
          run_quiet python3 -m venv --upgrade-deps "$HOME/.venv"
          run_quiet "$HOME/.venv/bin/python" -m pip install uv prek
        fi
        ;;
    esac
  done

  # cargo install impala    # https://github.com/pythops/impala
  # cargo install wiremix   # https://github.com/tsowell/wiremix

  local go_bin lazygit_version shellcheck_version
  go_bin="$(go env GOPATH 2>/dev/null || true)/bin/lazygit"

  print_notes ""
  print_notes "   🧾 versions"
  for sel in "${selections_arr[@]}"; do
    case "$sel" in
      node)       print_notes "      node       :: $(installed_version node --version)" ;;
      rustup)     print_notes "      rustc      :: $(installed_version rustc --version)" ;;
      go)         print_notes "      go         :: $(installed_version go version)" ;;
      shellcheck)
        # `shellcheck --version` starts with a tagline, so read its version field.
        shellcheck_version=$(shellcheck --version 2>/dev/null | sed -n 's/^version: //p')
        print_notes "      shellcheck :: ${shellcheck_version:-not installed}"
        ;;
      httpie)     print_notes "      httpie     :: $(installed_version httpie --version)" ;;
      python-dev) print_notes "      python3    :: $(installed_version python3 --version)" ;;
      lazygit)
        lazygit_version=$(installed_version "$go_bin" --version)
        print_notes "      lazygit    :: ${lazygit_version##*version=}"
        ;;
      uv-prek)
        print_notes "      uv         :: $(installed_version "$HOME/.venv/bin/uv" --version)"
        print_notes "      prek       :: $(installed_version "$HOME/.venv/bin/prek" --version)"
        ;;
    esac
  done

  print_info2 "✅ DEPS :: dev dependencies installed!"
}

