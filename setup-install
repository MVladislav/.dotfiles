# SERVICE :: install input (Work Louder) ---------------------------------------
install_input_linux() {
  print_info2 "\n🚀 INPUT :: install Work Louder Input (AppImage, user-based)..."
  require_cmds curl || return 1

  local asset_name="input-${VERSION_INPUT_LINUX#v}.AppImage"
  local asset_url="$VERSION_INPUT_LINUX_REPO/releases/download/$VERSION_INPUT_LINUX/$asset_name"
  local target="$USER_LOCAL_PREFIX_BIN/input-linux.AppImage"
  local tmp_asset="$DEPS_INSTALL_PATH/$asset_name"
  local tmp_icon_dir="$DEPS_INSTALL_PATH/input-icon"
  local icon_name="input"
  local icon_src="$tmp_icon_dir/squashfs-root/usr/share/icons/hicolor/512x512/apps/$icon_name.png"
  local desktop_file="$LN_INPUT_LINUX_APPLICATIONS/input-linux.desktop"

  local current_version="not installed"
  [[ -x "$target" ]] && current_version="present (pinned: $VERSION_INPUT_LINUX)"
  print_notes "   💡 current installed version :: '$current_version'"

  print_notes "   ⬇️ downloading $asset_name..."
  mkdir -p "$DEPS_INSTALL_PATH" "$USER_LOCAL_PREFIX_BIN"
  curl -fsSL "$asset_url" -o "$tmp_asset"
  [[ -s "$tmp_asset" ]] || { print_error "❌ INPUT :: download produced empty file."; rm -f "$tmp_asset"; return 1; }
  install -Dm755 "$tmp_asset" "$target"
  rm -f "$tmp_asset"
  print_notes "   ✅ installed $target"

  print_notes "   📌 extracting icon..."
  rm -rf "$tmp_icon_dir"
  mkdir -p "$tmp_icon_dir"
  pushd "$tmp_icon_dir" >/dev/null
  "$target" --appimage-extract "usr/share/icons/hicolor/512x512/apps/$icon_name.png" >/dev/null 2>&1 || true
  popd >/dev/null
  if [[ -f "$icon_src" ]]; then
    install -Dm644 "$icon_src" "$LN_INPUT_LINUX_ICONS/512x512/apps/$icon_name.png"
    print_notes "   ✅ icon installed ($LN_INPUT_LINUX_ICONS/512x512/apps/$icon_name.png)"
  else
    print_notes "   ⚠️ could not extract icon from the AppImage"
  fi
  rm -rf "$tmp_icon_dir"

  print_notes "   📌 installing desktop entry -> $desktop_file"
  mkdir -p "$LN_INPUT_LINUX_APPLICATIONS"
  {
    printf '%s\n' "[Desktop Entry]"
    printf 'Name=%s\n' "Input (Work Louder)"
    printf 'Comment=%s\n' "Configure Work Louder devices"
    printf 'Exec=%s\n' "$target"
    printf 'Icon=%s\n' "$icon_name"
    printf '%s\n' "Type=Application"
    printf '%s\n' "Terminal=false"
    printf '%s\n' "Categories=Utility;"
  } >"$desktop_file"
  if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$desktop_file" || print_notes "   ⚠️ desktop-file-validate reported issues for $desktop_file"
  fi

  # System-wide udev rules for Work Louder devices (requires sudo).
  install_udev_rules "${PWD}/configs-single/70-worklouder.rules" "$LN_INPUT_LINUX_UDEV" \
    --subsystem-match=hidraw --subsystem-match=tty

  # Refresh caches so the menu and icon theme pick up the new files.
  refresh_desktop_caches "$LN_INPUT_LINUX_ICONS" "$LN_INPUT_LINUX_APPLICATIONS"

  # Soft dependency hint: AppImages need FUSE at runtime.
  if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
    print_notes "   💡 FUSE not detected. If the AppImage fails to start, install fuse3 (e.g. 'sudo apt install fuse3')."
  fi

  print_notes "   💡 new installed version :: '$VERSION_INPUT_LINUX'"
  print_notes "   💡 launch from app menu or run: $target"
  print_info2 "✅ INPUT :: Work Louder Input installed!"
}

# SERVICE :: install openlogi -------------------------------------------------
install_openlogi() {
  print_info2 "\n🚀 OPENLOGI :: install openlogi..."
  print_notes "   💡 current installed version :: '$(installed_version "$USER_LOCAL_PREFIX_BIN/openlogi" --version)'"
  # rustup installs its shims outside this script's fixed PATH.
  export PATH="$HOME/.cargo/bin:$PATH"

  require_cmds cargo rustc git || {
    print_error "❌ OPENLOGI :: 'cargo' or 'rustc' not found. Install a stable Rust toolchain first, e.g. './setup -idev' (rustup) or https://rustup.rs"
    return 1
  }

  local rustc_version rustc_major rustc_minor
  rustc_version=$(rustc --version | awk '{print $2}')
  IFS=. read -r rustc_major rustc_minor _ <<< "$rustc_version"
  if ((rustc_major < 1 || (rustc_major == 1 && rustc_minor < 99))); then
    print_error "❌ OPENLOGI :: rustc >= 1.99 required (found $rustc_version). Update with 'rustup update stable'."
    return 1
  fi

  local packages_tools=(libxkbcommon0 libxkbcommon-x11-0 libxcb1 libvulkan1 libwayland-client0 libfontconfig1 libgl1)
  local packages_build=(build-essential clang pkg-config libudev-dev libfontconfig1-dev libwayland-dev libxkbcommon-x11-dev libx11-xcb-dev libssl-dev libzstd-dev)
  install_dependencies_needs packages_tools[@] packages_build[@]

  local openlogi_dir="$DEPS_INSTALL_PATH/openlogi"
  if [[ -d "$openlogi_dir/.git" ]]; then
    print_notes "   ♻️ reusing existing checkout at $openlogi_dir..."
    git -C "$openlogi_dir" fetch -q --tags origin || print_notes "   ⚠️ could not fetch updates, building the existing checkout"
    if [[ $INSTALL_SOURCE_FROM == 'release' ]]; then
      git -C "$openlogi_dir" checkout -q "$VERSION_OPENLOGI"
      git -C "$openlogi_dir" reset -q --hard "$VERSION_OPENLOGI"
    fi
  else
    print_notes "   📦 cloning openlogi..."
    clone_repo "$VERSION_OPENLOGI_REPO" "$openlogi_dir" "$VERSION_OPENLOGI"
  fi
  pushd "$openlogi_dir" 1>/dev/null

  # Upstream release settings (fat LTO, codegen-units=1, opt-level 3, 4 jobs)
  # peak above 7 GiB. Local builds use cheaper defaults; override with
  # OPENLOGI_BUILD_JOBS / _LTO / _CODEGEN_UNITS / _OPT_LEVEL.
  local build_jobs="${OPENLOGI_BUILD_JOBS:-1}"
  local build_lto="${OPENLOGI_LTO:-false}"
  local build_codegen_units="${OPENLOGI_CODEGEN_UNITS:-16}"
  local build_opt_level="${OPENLOGI_OPT_LEVEL:-1}"
  # openlogi-desktop alone needs ~5 GiB; skip it on low-memory hosts unless
  # OPENLOGI_BUILD_DESKTOP=1.
  local build_desktop="${OPENLOGI_BUILD_DESKTOP:-auto}"
  if [[ $build_desktop == 'auto' ]]; then
    local mem_available_mib
    mem_available_mib=$(awk '/^MemAvailable:/ {m=$2} /^SwapFree:/ {s=$2} END {printf "%d", (m+s)/1024}' /proc/meminfo)
    if ((mem_available_mib < 6144)); then
      build_desktop=0
      print_notes "   ⚠️ only ${mem_available_mib} MiB RAM+swap free: skipping openlogi-desktop (needs ~5 GiB; force with OPENLOGI_BUILD_DESKTOP=1)"
    else
      build_desktop=1
    fi
  fi

  local build_crates=(openlogi openlogi-overlay openlogi-agent)
  [[ $build_desktop == 1 ]] && build_crates+=(openlogi-desktop)
  local build_args=()
  local build_crate
  for build_crate in "${build_crates[@]}"; do
    build_args+=(-p "$build_crate")
  done

  print_notes "   🔧 building and installing openlogi (crates: ${build_crates[*]}, cargo jobs: $build_jobs, LTO: $build_lto, codegen units: $build_codegen_units, opt-level: $build_opt_level)..."
  if ! run_quiet_hint "⏳ building ${#build_crates[@]} release binaries, this can take several minutes..." \
    env CARGO_PROFILE_RELEASE_LTO="$build_lto" \
      CARGO_PROFILE_RELEASE_CODEGEN_UNITS="$build_codegen_units" \
      CARGO_PROFILE_RELEASE_OPT_LEVEL="$build_opt_level" \
      cargo build --release --locked -j "$build_jobs" "${build_args[@]}"; then
    print_error "❌ OPENLOGI :: build failed."
    popd 1>/dev/null
    rm -rf "$openlogi_dir" 1>/dev/null
    install_dependencies_needs_rm || true
    return 1
  fi

  local build_dir="$openlogi_dir/target/release"
  local binary
  print_notes "   📌 installing binaries to $USER_LOCAL_PREFIX_BIN..."
  for binary in "${build_crates[@]}"; do
    install -Dm755 "$build_dir/$binary" "$USER_LOCAL_PREFIX_BIN/$binary"
  done

  if [[ $build_desktop == 1 ]]; then
    print_notes "   📌 installing desktop entry and icons..."
    mkdir -p "$LN_OPENLOGI_APPLICATIONS"
    sed "s|^Exec=openlogi-desktop$|Exec=${USER_LOCAL_PREFIX_BIN}/openlogi-desktop|" \
      "$DEPS_INSTALL_PATH/openlogi/packaging/linux/desktop/openlogi.desktop" >"$LN_OPENLOGI_APPLICATIONS/openlogi.desktop"
    chmod 644 "$LN_OPENLOGI_APPLICATIONS/openlogi.desktop"
    install -Dm644 "$DEPS_INSTALL_PATH/openlogi/design/icon/openlogi.png" \
      "$LN_OPENLOGI_ICONS/1024x1024/apps/openlogi.png"
    local size
    for size in 512 256 128 64 48 32 16; do
      install -Dm644 "$DEPS_INSTALL_PATH/openlogi/design/icon/openlogi-${size}.png" \
        "$LN_OPENLOGI_ICONS/${size}x${size}/apps/openlogi.png"
    done
  else
    print_notes "   ⏭️ skipping desktop entry and icons (openlogi-desktop not built)"
  fi

  print_notes "   📌 installing systemd user unit -> $LN_OPENLOGI_AGENT"
  mkdir -p "$(dirname "$LN_OPENLOGI_AGENT")"
  sed "s|^ExecStart=/usr/bin/openlogi-agent$|ExecStart=${USER_LOCAL_PREFIX_BIN}/openlogi-agent|" \
    "$DEPS_INSTALL_PATH/openlogi/packaging/linux/systemd/openlogi-agent.service" >"$LN_OPENLOGI_AGENT"

  refresh_desktop_caches "$LN_OPENLOGI_ICONS" "$LN_OPENLOGI_APPLICATIONS"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload || true
    if systemctl --user enable --now openlogi-agent.service; then
      print_notes "   ⚙️ enabled and started openlogi-agent.service for the current user"
    else
      print_error "   ❌ could not start openlogi-agent.service; run 'systemctl --user enable --now openlogi-agent.service' manually"
    fi
  fi

  local openlogi_rules_src="$DEPS_INSTALL_PATH/openlogi/packaging/linux/udev/70-openlogi.rules"
  install_udev_rules "$openlogi_rules_src" "$LN_OPENLOGI_UDEV" \
    --subsystem-match=hidraw \
    --trigger --subsystem-match=input \
    --trigger --subsystem-match=misc --attr-match=name=uinput

  popd 1>/dev/null
  rm -rf "$DEPS_INSTALL_PATH/openlogi" 1>/dev/null

  install_dependencies_needs_rm

  print_notes "   💡 new installed version :: '$(installed_version "$USER_LOCAL_PREFIX_BIN/openlogi" --version)'"
  print_info2 "✅ OPENLOGI :: openlogi installed!"
}

# SERVICE :: install android emulator ------------------------------------------
install_android_emulator() {
  export VM_ANDROID_PATH="${VM_ANDROID_PATH:-"$HOME/.android"}"
  export ANDROID_HOME="${ANDROID_HOME:-"$VM_ANDROID_PATH/Sdk"}"
  export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-"$ANDROID_HOME"}"
  mkdir -p "$ANDROID_HOME"

  require_cmds fzf curl unzip || return 1
  require_cmds java || {
    print_error "❌ ANDROID :: 'java' not found. Install 'openjdk-26-jre-headless' first."
    return 1
  }

  if [[ ! -x "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" ]]; then
    print_info2 "📦 downloading Android command-line tools..."
    # https://developer.android.com/studio#command-line-tools-only
    # - https://dl.google.com/android/repository/commandlinetools-<os>-<version>_latest.zip
    run_quiet_hint "⏳ downloading ~150 MB (commandlinetools), this can take a few minutes..." \
      curl -fsSL "$ANDROID_HOME/cmdline-tools.zip" \
      https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip

    unzip -q "$ANDROID_HOME/cmdline-tools.zip" -d "$ANDROID_HOME/cmdline-tools"
    mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"
    rm "$ANDROID_HOME/cmdline-tools.zip"
  fi

  local sdkmanager="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
  local avdmanager="$ANDROID_HOME/cmdline-tools/latest/bin/avdmanager"
  local emulator="$ANDROID_HOME/emulator/emulator"

  yes | "$sdkmanager" --licenses >/dev/null || true

  # "$sdkmanager" --uninstall emulator
  "$sdkmanager" --update

  local rc build_tools images devices
  local selected_build_tool selected_image selected_device

  print_info2 "📋 available build-tools:"
  build_tools=$("$sdkmanager" --list | grep -Eo 'build-tools;[0-9][^ ]+' | sort -ur) || true
  selected_build_tool=$(fzf_select "$build_tools" "Select build-tools version:" "Select build-tools version: ") || {
    rc=$?
    [[ $rc -eq 130 ]] && { print_notes "   💡 selection cancelled, skipping"; return 0; }
    return "$rc"
  }
  [[ -n "$selected_build_tool" ]] || { print_notes "   💡 no build-tools selected, skipping"; return 0; }
  "$sdkmanager" "$selected_build_tool"

  print_info2 "📋 available system images:"
  images=$("$sdkmanager" --list | grep -Eo 'system-images;android-[0-9][^ ]+' | sort -ur) || true
  selected_image=$(fzf_select "$images" "Select system image:" "Select system image: " "x86_64 api !store") || {
    rc=$?
    [[ $rc -eq 130 ]] && { print_notes "   💡 selection cancelled, skipping"; return 0; }
    return "$rc"
  }
  [[ -n "$selected_image" ]] || { print_notes "   💡 no system image selected, skipping"; return 0; }

  print_info2 "📦 installing: $selected_image ..."
  "$sdkmanager" "platform-tools" "emulator" "$selected_image"

  devices=$("$avdmanager" list devices | grep 'id:' | awk -F'"' '{print $2}' | grep 'pixel_' | sort -ur) || true
  selected_device=$(fzf_select "$devices" "Select device profile:" "Select device profile: " "pro") || {
    rc=$?
    [[ $rc -eq 130 ]] && { print_notes "   💡 selection cancelled, skipping"; return 0; }
    return "$rc"
  }
  [[ -n "$selected_device" ]] || { print_notes "   💡 no device profile selected, skipping"; return 0; }

  local selected_image_name avd_name
  selected_image_name=$(basename "$selected_image" | tr ';:' '_' | tr -d '[:punct:]')
  avd_name="${selected_image_name}_$(basename "$selected_device")_$(date +%s)"
  print_info2 "📱 creating AVD: $avd_name ..."
  "$avdmanager" create avd -n "$avd_name" -k "$selected_image" -d "$selected_device" --force

  print_info2 "✅ available AVDs:"
  "$emulator" -list-avds
}

