  create_symlink "${PWD}/ai/SKILL-vm-site-builder.md" "$skills_dir/vm-site-builder/SKILL.md"
  create_symlink "${PWD}/ai/site-builder-companion/project-brief.md" "$skills_dir/vm-site-builder/references/project-brief.md"
  create_symlink "${PWD}/ai/site-builder-companion/storage-auth-deployment.md" "$skills_dir/vm-site-builder/references/storage-auth-deployment.md"
  create_symlink "${PWD}/ai/site-builder-companion/design-and-iteration.md" "$skills_dir/vm-site-builder/references/design-and-iteration.md"
  create_symlink "${PWD}/ai/site-builder-companion/secure-delivery-checklist.md" "$skills_dir/vm-site-builder/references/secure-delivery-checklist.md"
  create_symlink "${PWD}/ai/SKILL-skill-authoring.md" "$skills_dir/vm-skill-authoring/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-unifi-network.md" "$skills_dir/vm-unifi-network/SKILL.md"
  create_symlink "${PWD}/ai/unifi-companion/UNIFI-API.md" "$skills_dir/vm-unifi-network/UNIFI-API.md"
  create_symlink "${PWD}/ai/unifi-companion/UNIFI-ONBOARDING.md" "$skills_dir/vm-unifi-network/UNIFI-ONBOARDING.md"
  create_symlink "${PWD}/ai/SKILL-opnsense-firewall.md" "$skills_dir/vm-opnsense-firewall/SKILL.md"
  create_symlink "${PWD}/ai/opnsense-companion/API.md" "$skills_dir/vm-opnsense-firewall/API.md"
  create_symlink "${PWD}/ai/opnsense-companion/ONBOARDING.md" "$skills_dir/vm-opnsense-firewall/ONBOARDING.md"
  create_symlink "${PWD}/ai/GITHUB.md" "$skills_dir/vm-github-pr-issues/GITHUB.md"

  local skills_to_install=()
  if [[ ${#OPENCODE_SKILL_NAMES[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No upstream skills available, fetch skipped"
    prune_upstream=1 # nothing wanted upstream -> drop whatever we installed before
  elif ! command -v fzf >/dev/null 2>&1; then
    print_notes "   ⚠️  fzf not found, upstream skills fetch skipped"
  else
    prune_upstream=1
    local first_label="${OPENCODE_SKILL_SOURCES[0]%%|*}"

    # name -> "repo subdir" lookup table for the fzf preview. A plain name maps
    # to the first source (its install fallback); "label/name" to that source.
    local preview_dir
    preview_dir=$(mktemp -d)
    local sources_tsv="$preview_dir/sources.tsv"
    local line label repo rev subdir name bundle_alias bundle_prefix
    for line in "${OPENCODE_SKILL_SOURCES[@]}"; do
      IFS='|' read -r label repo rev subdir <<<"$line"
      for name in "${OPENCODE_SKILL_NAMES[@]}"; do
        if [[ $name == "$label/"* ]] || [[ $name != */* && $label == "$first_label" ]]; then
          printf '%s\t%s\t%s\n' "$name" "$repo" "$subdir" >> "$sources_tsv"
        fi
      done
    done
    for line in ${OPENCODE_SKILL_BUNDLES[@]+"${OPENCODE_SKILL_BUNDLES[@]}"}; do
      IFS='|' read -r bundle_alias bundle_prefix <<<"$line"
      printf '%s\tBUNDLE\t%s\n' "$bundle_alias" "$bundle_prefix" >> "$sources_tsv"
    done
    # fzf preview: show install target + source for the current line (tsv lookup).
    # Target is the flattened leaf (opencode IDs come from the leaf dir name);
    # the source shows the full <subdir>/<path> inside the repo.
    local preview_cmd
    preview_cmd="awk -F '\t' -v n='{}' -v d='$skills_dir' '\$1 == n { if (\$2 == \"BUNDLE\") { printf \"bundle: installs all selectable skills matching %s\\n\", \$3; exit } strip = \$1; sub(/^[^\/]+\//, \"\", strip); leaf = strip; sub(/^.*\//, \"\", leaf); printf \"install target: %s/%s/\\nsource: %s/%s/%s\\n\", d, leaf, \$2, \$3, strip; exit }' '$sources_tsv'"
    local fzf_list="none"
    for line in ${OPENCODE_SKILL_BUNDLES[@]+"${OPENCODE_SKILL_BUNDLES[@]}"}; do
      IFS='|' read -r bundle_alias bundle_prefix <<<"$line"
      fzf_list+=$'\n'"$bundle_alias"
    done
    for name in "${OPENCODE_SKILL_NAMES[@]}"; do
      fzf_list+=$'\n'"$name"
    done

    local selections
    local rc=0
    selections=$(fzf_pick "$fzf_list" "${OPENCODE_SKILLS_DEFAULT:-}" \
      'TAB: toggle, ENTER: confirm - none = remove installed skills' \
      'Select skills to fetch: ' \
      "$preview_cmd") || rc=$?
    if [[ $rc -eq 130 ]]; then
      rm -rf "$preview_dir"
      print_notes "   ⛔ Cancelled by user, aborting setup"
      exit 130
    fi
    rm -rf "$preview_dir"

    if [[ -z "$selections" ]]; then
      # Nothing chosen: do NOT prune upstream skills, just leave them as-is.
      prune_upstream=0
      print_notes "   ⏭️  No skills selected, leaving installed skills untouched"
    elif echo "$selections" | grep -qx 'none'; then
      print_notes "   🧹 Cleanup mode: removing installed skills"
    else
      local -a selected_rows=()
      mapfile -t selected_rows <<< "$(echo "$selections" | grep -v '^none$')"

      # Expand selected bundles before individual names so the bundle's source
      # wins when two sources publish the same leaf skill ID.
      local -A expanded_skills=()
      local selected bundle_is_selected
      for line in ${OPENCODE_SKILL_BUNDLES[@]+"${OPENCODE_SKILL_BUNDLES[@]}"}; do
        IFS='|' read -r bundle_alias bundle_prefix <<<"$line"
        bundle_is_selected=0
        for selected in "${selected_rows[@]}"; do
          [[ $selected == "$bundle_alias" ]] && bundle_is_selected=1
        done
        if [[ $bundle_is_selected == 1 ]]; then
          for name in "${OPENCODE_SKILL_NAMES[@]}"; do
            if [[ $name == "$bundle_prefix"* && -z "${expanded_skills[$name]:-}" ]]; then
              skills_to_install+=("$name")
              expanded_skills[$name]=1
            fi
          done
        fi
      done
      for selected in "${selected_rows[@]}"; do
        bundle_is_selected=0
        for line in ${OPENCODE_SKILL_BUNDLES[@]+"${OPENCODE_SKILL_BUNDLES[@]}"}; do
          IFS='|' read -r bundle_alias bundle_prefix <<<"$line"
          [[ $selected == "$bundle_alias" ]] && bundle_is_selected=1
        done
        if [[ $bundle_is_selected != 1 && -z "${expanded_skills[$selected]:-}" ]]; then
          skills_to_install+=("$selected")
          expanded_skills[$selected]=1
        fi
      done
    fi
  fi

  if [[ ${#skills_to_install[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No skills selected, fetch skipped"
    reconcile_opencode_skills "$skills_dir" "$prune_upstream"
    print_info2 "✅ SKILLS :: skills ready."
    return 0
  fi

  # Resolve source metadata per label (falls back to the first source)
  local -A source_repos=() source_revs=() source_subdirs=()
  local line label repo rev subdir
  for line in "${OPENCODE_SKILL_SOURCES[@]}"; do
    IFS='|' read -r label repo rev subdir <<<"$line"
    source_repos[$label]=$repo
    source_revs[$label]=$rev
    source_subdirs[$label]=$subdir
  done
  local first_label
  first_label="${OPENCODE_SKILL_SOURCES[0]%%|*}"

  local tmp
  tmp=$(mktemp -d)
  local -A cloned=() installed_dest=()
  local name skill_label skill_name dest source_skill
  for name in "${skills_to_install[@]}"; do
    skill_name="${name#*/}"
    skill_label="${name%%/*}"
    if [[ $skill_name == "$name" ]]; then
      skill_label="$first_label"
    fi
    # Sources may nest skills one level deeper (mattpocock: skills/engineering/
    # tdd). opencode derives the skill ID from the leaf dir name, so install
    # flat; two selected names with the same leaf would clobber each other.
    dest="${skill_name##*/}"
    if [[ ! "$dest" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
      print_notes "   ⚠️  invalid skill directory name '$dest', skipping $name"
      continue
    fi
    if [[ -n "${installed_dest[$dest]:-}" ]]; then
      print_notes "   ⚠️  duplicate skill name '$dest' ('$name' vs '${installed_dest[$dest]}'), skipping $name"
      continue
    fi
    local repo="${source_repos[$skill_label]:-}"
    if [[ -z $repo ]]; then
      print_notes "   ⚠️  unknown skill source '$skill_label', skipping $name"
      continue
    fi
    if [[ -z ${cloned[$skill_label]:-} ]]; then
      print_info2 "📥 SKILLS :: fetching $repo..."
      if git clone --quiet --depth 1 "$repo" "$tmp/$skill_label"; then
        if [[ -n "${source_revs[$skill_label]:-}" ]]; then
          git -C "$tmp/$skill_label" fetch --quiet --depth 1 origin "${source_revs[$skill_label]}" \
            && git -C "$tmp/$skill_label" checkout --quiet FETCH_HEAD
        fi
        cloned[$skill_label]=1
      else
        print_notes "   ⚠️  could not clone $repo, skills skipped"
        continue
      fi
    fi
    local subdir="${source_subdirs[$skill_label]:-}"
    source_skill="$tmp/$skill_label/$subdir/$skill_name"
    if [[ -f "$source_skill/SKILL.md" ]]; then
      # Replace a previous managed copy cleanly (a bundle can switch a colliding
      # leaf from one upstream source to another). Never overwrite a foreign
      # directory or symlink in the user's skills dir.
      if [[ -L "$skills_dir/$dest" ]]; then
        print_notes "   ⚠️  skill target is a symlink, leaving it untouched: $dest"
        continue
      elif [[ -e "$skills_dir/$dest" ]]; then
        if grep -qxF "$dest" "$skills_dir/.managed" 2>/dev/null; then
          rm -rf -- "${skills_dir:?}/$dest"
        else
          print_notes "   ⚠️  skill target is not managed by setup-ai, leaving it untouched: $dest"
          continue
        fi
      fi
      mkdir -p "$skills_dir/$dest"
      cp -r "$source_skill/." "$skills_dir/$dest/"
      if [[ -f "$skills_dir/$dest/SKILL.md" ]]; then
        installed_dest[$dest]="$name"
        print_notes "   ✅ installed skill: $dest <- $repo/$subdir/$skill_name"
      else
        print_notes "   ⚠️  no SKILL.md after install: $dest (broken skill?)"
      fi
    else
      print_notes "   ⚠️  skill not found upstream or has no SKILL.md: $name"
    fi
  done
  rm -rf "$tmp"

  reconcile_opencode_skills "$skills_dir" "$prune_upstream" "${skills_to_install[@]}"

  print_info2 "✅ SKILLS :: skills ready."
}

