#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

# CONFIG/SETUP :: sourced by setup-ai
# Configuration functions, the fzf selectors, and the helpers they share.
# Functions only - this file is never executed on its own.

# ********************************************************************************

# HELPERS :: web search provider -------------------------------------------------
# Pin an environment-provided websearch key when unambiguous; otherwise leave
# the key unset so Console hosted search (/connect) or the first-search picker
# keeps working. OPENCODE_CONFIG_WEBSEARCH overrides detection with an ID.
opencode_websearch_provider() {
  if [[ -n "${OPENCODE_CONFIG_WEBSEARCH:-}" ]]; then
    printf '%s' "$OPENCODE_CONFIG_WEBSEARCH"
    return 0
  fi
  local -a found=()
  local pair var id
  for pair in exa:EXA_API_KEY firecrawl:FIRECRAWL_API_KEY \
    parallel:PARALLEL_API_KEY tavily:TAVILY_API_KEY tinyfish:TINYFISH_API_KEY; do
    id=${pair%%:*}
    var=${pair#*:}
    if [[ -n "${!var:-}" ]]; then
      found+=("$id")
    fi
  done
  case ${#found[@]} in
  0) return 0 ;;
  1) printf '%s' "${found[0]}" ;;
  *) printf 'random' ;;
  esac
}

# HELPERS :: REA runtime --------------------------------------------------------
# REA is a Node package launched by opencode. Warn before writing the MCP entry
# when Node is missing or outside the range published for the pinned release.
check_rea_node_version() {
  local node_version major supported=0
  node_version=$(node --version 2>/dev/null | sed 's/^v//')
  if [[ -z "$node_version" ]]; then
    print_notes "   ⚠️  Node.js not found; the rea MCP server cannot start"
    return 1
  fi

  major=${node_version%%.*}
  case "$major" in
  22) if version_ge "$node_version" "22.23.4"; then supported=1; fi ;;
  24) if version_ge "$node_version" "24.22.1"; then supported=1; fi ;;
  *)
    if [[ "$major" =~ ^[0-9]+$ ]] && ((major >= 26)); then
      if version_ge "$node_version" "26.12.1"; then supported=1; fi
    fi
    ;;
  esac

  if [[ "$supported" != 1 ]]; then
    print_notes "   ⚠️  Node ${node_version} is outside REA's supported range (${OPENCODE_CONFIG_MCP_REA_NODE_RANGE})"
    return 1
  fi
  return 0
}

# Resolve a Node executable path that REA treats as its own launcher. Snap
# installs put /snap/bin/node on PATH, but that is a symlink to the snap
# wrapper and `rea doctor` reports it as foreign. Use process.execPath as the
# fallback and normalize the snap versioned path back to `current`.
resolve_node_bin() {
  local p exec_path
  p=$(command -v node 2>/dev/null || true)
  if [[ -n "$p" && -x "$p" && "$(basename "$(readlink -f "$p")")" == "node" ]]; then
    printf '%s\n' "$p"
    return 0
  fi
  exec_path=$(node -p 'process.execPath' 2>/dev/null || true)
  if [[ -n "$exec_path" && -x "$exec_path" ]]; then
    if [[ "$exec_path" =~ ^(/snap/node)/[0-9]+(/bin/node)$ && -x "${BASH_REMATCH[1]}/current${BASH_REMATCH[2]}" ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}/current${BASH_REMATCH[2]}"
      return 0
    fi
    printf '%s\n' "$exec_path"
  fi
}

# Resolve a Java runtime that includes jdk.compiler, which the JADX bridge
# requires. Prefer JAVA_HOME, then the system default JDK; a JRE-only JAVA_HOME
# is skipped so the MCP process does not inherit a runtime JADX cannot use.
rea_java_home() {
  local candidate java_bin modules
  local -a candidates=("${JAVA_HOME:-}" /usr/lib/jvm/default-java)

  java_bin=$(readlink -f "$(command -v java 2>/dev/null)" 2>/dev/null || true)
  if [[ -n "$java_bin" ]]; then
    candidates+=("$(dirname "$(dirname "$java_bin")")")
  fi

  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -x "$candidate/bin/java" ]] || continue
    modules=$("$candidate/bin/java" --list-modules 2>/dev/null) || continue
    if grep -q '^jdk.compiler@' <<<"$modules"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
}

# Resolve the JADX bridge path. REA_JADX_MCP_JAR overrides the default location
# used by `setup-ai -irea`.
rea_jadx_jar_path() {
  local version="${OPENCODE_CONFIG_MCP_REA_JADX_VERSION:?JADX version is not configured}"
  local default="$HOME/.local/share/rea/jadx/jadx-headless-mcp-${version}-all.jar"
  printf '%s\n' "${REA_JADX_MCP_JAR:-$default}"
}

# Resolve the command opencode should launch for REA. Prefer the pinned CLI in
# ~/.local/bin so startup is offline and `rea doctor` sees the same release;
# fall back to the npx pin from the conf. Prints a JSON command array.
rea_mcp_command_json() {
  local installed="$USER_LOCAL_PREFIX_BIN/rea" node_bin version
  node_bin=$(resolve_node_bin || true)
  if [[ -x "$installed" && -n "$node_bin" ]]; then
    version=$("$installed" --version 2>/dev/null | sed -n 's/^v\{0,1\}\([0-9][0-9.]*\).*/\1/p' | head -n1) || true
    if [[ "$version" == "$OPENCODE_CONFIG_MCP_REA_VERSION" ]]; then
      jq -cn --arg node "$node_bin" --arg bin "$installed" '[$node, $bin, "mcp"]'
      return 0
    fi
  fi
  jq -cn --arg version "$OPENCODE_CONFIG_MCP_REA_VERSION" '["npx", "-y", ("rea-agents@" + $version), "mcp"]'
}

# Report analysis engines that are still missing after setup. The free engines
# are installed by `setup-ai -irea`; commercial and caller-supplied ones are
# listed in ai/REA.md. Only relevant when the CLI is installed.
report_rea_readiness() {
  local rea_bin="$USER_LOCAL_PREFIX_BIN/rea" missing
  [[ -x "$rea_bin" ]] || return 0

  missing=$("$rea_bin" doctor --client opencode --json 2>/dev/null |
    jq -r '.checks[]? | select(.ok == false and .classification == "missing_analysis_engine") | .name' |
    tr '\n' ' ') || true
  missing=${missing% }

  if [[ -n "$missing" ]]; then
    print_notes "   🔍 REA :: analysis engines not installed: ${missing} (see ai/REA.md)"
  else
    print_notes "   ✅ REA :: analysis engine checks passed"
  fi
}

# SETUP :: REA MCP -------------------------------------------------------------
# Customize the selected REA MCP entry with the resolved launcher and provider
# environment. Returns 0 when REA is selected, 1 otherwise.
setup_opencode_rea() {
  [[ -n "${OPENCODE_CONFIG_MCP_COMBINED:-}" && "$OPENCODE_CONFIG_MCP_COMBINED" != "CLEANUP" ]] || return 1
  jq -e '.servers.rea' <<<"$OPENCODE_CONFIG_MCP_COMBINED" >/dev/null 2>&1 || return 1

  check_rea_node_version || true

  local rea_command
  rea_command=$(rea_mcp_command_json)
  if [[ "$rea_command" == '["npx"'* ]] && ! command -v npx >/dev/null 2>&1; then
    print_notes "   ⚠️  npx not found; install npm or run 'setup-ai -irea' before starting opencode"
  fi

  # Pass the detected JDK and (optionally) the Hopper launcher through to the
  # MCP process: JADX needs a JDK with jdk.compiler, and Hopper needs
  # HOPPER_LAUNCHER_PATH. A desktop-launched opencode does not inherit a
  # shell-exported value.
  local rea_java
  rea_java=$(rea_java_home)
  local hopper_launcher="${HOPPER_LAUNCHER_PATH:-}"
  if [[ -z "$hopper_launcher" ]]; then
    hopper_launcher=$(command -v hopper 2>/dev/null || true)
  fi
  local jadx_jar
  jadx_jar=$(rea_jadx_jar_path)
  [[ -f "$jadx_jar" ]] || jadx_jar=""
  [[ -n "$hopper_launcher" ]] && export HOPPER_LAUNCHER_PATH="$hopper_launcher"
  [[ -n "$jadx_jar" ]] && export REA_JADX_MCP_JAR="$jadx_jar"

  OPENCODE_CONFIG_MCP_COMBINED=$(jq --argjson c "$rea_command" \
    --arg j "$rea_java" --arg h "$hopper_launcher" --arg x "$jadx_jar" \
    '.servers.rea.command = $c
    | if $j != "" then .servers.rea.environment.JAVA_HOME = $j else . end
    | if $h != "" then .servers.rea.environment.HOPPER_LAUNCHER_PATH = $h else . end
    | if $x != "" then .servers.rea.environment.REA_JADX_MCP_JAR = $x else . end' \
    <<<"$OPENCODE_CONFIG_MCP_COMBINED")
}

# SETUP :: opencode ------------------------------------------------------------
setup_opencode() {
  print_section "⚙️ OPENCODE :: configuring opencode"
  print_info2 "🔗 OPENCODE :: config directory at $LN_OPENCODE"
  mkdir -p "$LN_OPENCODE"
  link_config "OPENCODE" "${PWD}/configs-single/opencode-cli.json" "$LN_OPENCODE/cli.json"
  command -v jq >/dev/null 2>&1 || { print_notes "   ⚠️  jq not found, cannot configure opencode"; return; }

  echo ""
  select_opencode_section "PROVIDER" "providers"
  echo ""
  select_opencode_section "MCP" "MCP configs"
  local rea_selected=0
  if setup_opencode_rea; then
    rea_selected=1
  fi
  echo ""
  select_opencode_section "AGENTS" "agents"
  echo ""
  select_opencode_lsp
  echo ""
  setup_opencode_skills

  local opencode_config
  opencode_config=$(jq -n --arg schema "https://opencode.ai/config.json" '{"$schema": $schema}')
  opencode_config=$(echo "$opencode_config" | jq '.update = "notify"')
  opencode_config=$(echo "$opencode_config" | jq '.experimental.background_compaction = true')
  opencode_config=$(echo "$opencode_config" | jq --argjson p "$OPENCODE_CONFIG_PERMISSIONS" '.permissions = $p')

  local websearch_provider
  websearch_provider=$(opencode_websearch_provider)
  if [[ -n "$websearch_provider" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --arg p "$websearch_provider" '.websearch = {provider: $p}')
  fi

  echo ""
  if [[ -n "$OPENCODE_CONFIG_MCP_COMBINED" && "$OPENCODE_CONFIG_MCP_COMBINED" != "CLEANUP" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson m "$OPENCODE_CONFIG_MCP_COMBINED" '.mcp = $m')
  fi
  if [[ -n "$OPENCODE_CONFIG_AGENTS_COMBINED" && "$OPENCODE_CONFIG_AGENTS_COMBINED" != "CLEANUP" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson a "$OPENCODE_CONFIG_AGENTS_COMBINED" '.agents = $a')
  fi
  if [[ -n "$OPENCODE_CONFIG_LSP_COMBINED" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson l "$OPENCODE_CONFIG_LSP_COMBINED" '.lsp = $l')
  fi
  if [[ -n "$OPENCODE_CONFIG_PROVIDER_COMBINED" && "$OPENCODE_CONFIG_PROVIDER_COMBINED" != "CLEANUP" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson p "$OPENCODE_CONFIG_PROVIDER_COMBINED" '.providers = $p')
  fi

  local config_file="$LN_OPENCODE/opencode.jsonc"
  if [[ -f "$config_file" ]]; then
    local backup_file
    backup_file="${config_file}.$(date '+%Y%m%d-%H%M%S').bak"
    cp "$config_file" "$backup_file"
    print_notes "   💾 backed up existing config to $(basename "$backup_file")"

    [[ "$OPENCODE_CONFIG_MCP_COMBINED" == "CLEANUP" ]] &&
      jq 'del(.mcp)' "$config_file" > "${config_file}.tmp" &&
      mv "${config_file}.tmp" "$config_file" &&
      print_notes "   🧹 Removed all MCP configs"
    [[ "$OPENCODE_CONFIG_AGENTS_COMBINED" == "CLEANUP" ]] &&
      jq 'del(.agents, .agent)' "$config_file" > "${config_file}.tmp" &&
      mv "${config_file}.tmp" "$config_file" &&
      print_notes "   🧹 Removed all agent configs"
    [[ "$OPENCODE_CONFIG_PROVIDER_COMBINED" == "CLEANUP" ]] &&
      jq 'del(.providers, .provider)' "$config_file" > "${config_file}.tmp" &&
      mv "${config_file}.tmp" "$config_file" &&
      print_notes "   🧹 Removed all provider configs"

    local merge_del=".websearch"
    [[ -n "$OPENCODE_CONFIG_LSP_COMBINED" ]] && merge_del="${merge_del:+$merge_del,}.lsp"
    [[ -n "$OPENCODE_CONFIG_PROVIDER_COMBINED" && "$OPENCODE_CONFIG_PROVIDER_COMBINED" != "CLEANUP" ]] &&
      merge_del="${merge_del:+$merge_del,}.providers,.provider"
    # jq's `*` keeps existing values, so a selected entry would never move to a
    # new version unless the old one is dropped first. The rea snippets are
    # generated from the conf, so replace them while leaving unselected entries
    # and unrelated user keys alone.
    if [[ $rea_selected -eq 1 ]]; then
      merge_del="${merge_del},.mcp.servers.rea"
    fi
    if [[ -n "$OPENCODE_CONFIG_AGENTS_COMBINED" && "$OPENCODE_CONFIG_AGENTS_COMBINED" != "CLEANUP" ]] &&
      jq -e '."rea-investigator"' <<<"$OPENCODE_CONFIG_AGENTS_COMBINED" >/dev/null 2>&1; then
      merge_del="${merge_del},.agents.\"rea-investigator\""
    fi
    local existing_filter='.'
    [[ -n "$merge_del" ]] && existing_filter="del($merge_del)"
    local merge_filter
    merge_filter=".[0] as \$managed | .[1] as \$existing | (\$managed * (\$existing | $existing_filter))"
    # Permissions are fully repository-managed, so replace them rather than
    # keeping retired rules ahead of the new baseline (last match wins). This
    # also removes stale approvals after a policy rewrite.
    merge_filter+=" | .permissions = (\$managed.permissions // [])"
    merge_filter+=" | .policies = ((.policies // []) | map(select(.resource | startswith(\"shell:git\") | not)))"
    merge_filter+=" | if ((.policies // []) | length) == 0 then del(.policies) else . end"

    print_notes "   🔧 merging selected configs into existing $config_file"
    if jq -s "$merge_filter" <(echo "$opencode_config") "$config_file" > "${config_file}.tmp" \
      && mv "${config_file}.tmp" "$config_file"; then
      :
    else
      print_notes "   ⚠️ Merge failed, config unchanged"
    fi
  else
    [[ "$OPENCODE_CONFIG_MCP_COMBINED" == "CLEANUP" ]] &&
      print_notes "   ⏭️ No config file found, nothing to clean for MCPs"
    [[ "$OPENCODE_CONFIG_AGENTS_COMBINED" == "CLEANUP" ]] &&
      print_notes "   ⏭️ No config file found, nothing to clean for agents"
    [[ "$OPENCODE_CONFIG_PROVIDER_COMBINED" == "CLEANUP" ]] &&
      print_notes "   ⏭️ No config file found, nothing to clean for providers"
    print_notes "   📝 writing config to $config_file"
    echo "$opencode_config" > "$config_file"
  fi

  local env_vars
  env_vars=$(echo "$opencode_config" | jq -r '.. | objects | .[]? | select(type == "string") | capture("{env:(?<v>[^}]+)}") | .v' 2>/dev/null | sort -u || true)
  if [[ -n "$env_vars" ]]; then
    print_info2 "   ⚠️ Ensure these environment variables are set:"
    while IFS= read -r var; do
      print_info2 "      - $var"
    done <<< "$env_vars"
  fi

  if [[ $rea_selected -eq 1 ]]; then
    report_rea_readiness
  fi

  print_section_end "✅ OPENCODE :: config ready."
}

# HELPERS :: config varname of a section entry ----------------------------------
config_varname() {
  echo "OPENCODE_CONFIG_${1}_$(echo "$2" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
}

# SERVICE :: generic section selector (MCPs / agents) --------------------------
select_opencode_section() {
  local prefix="$1"
  local label="$2"

  local -n names_ref="OPENCODE_CONFIG_${prefix}_NAMES"
  local -n combined_ref="OPENCODE_CONFIG_${prefix}_COMBINED"
  local -n default_ref="OPENCODE_CONFIG_${prefix}_DEFAULT"

  if [[ ${#names_ref[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No ${label} available, skipping"
    combined_ref=""
    return 0
  fi

  command -v fzf >/dev/null 2>&1 || { print_notes "   ⚠️  fzf not found, cannot configure ${label}"; return 0; }

  local preview_dir
  preview_dir=$(mktemp -d)
  for name in "${names_ref[@]}"; do
    local varname
    varname=$(config_varname "$prefix" "$name")
    echo "${!varname}" > "$preview_dir/$name.json"
  done

  local fzf_list="none"
  for name in "${names_ref[@]}"; do
    fzf_list+=$'\n'"$name"
  done

  local selections
  local rc=0
  selections=$(fzf_pick "$fzf_list" "${default_ref:-}" 'TAB: toggle, ENTER: confirm' \
    "Select ${label} (none = cleanup): " \
    'jq . '"$preview_dir"'/{}.json 2>/dev/null || cat '"$preview_dir"'/{}.json 2>/dev/null') || rc=$?
  if [[ $rc -eq 130 ]]; then
    rm -rf "$preview_dir"
    print_notes "   ⛔ Cancelled by user, aborting setup"
    exit 130
  fi
  rm -rf "$preview_dir"

  [[ -z "$selections" ]] && {
    print_notes "   ⏭️  No ${label} selected"
    combined_ref=""
    return 0
  }

  if echo "$selections" | grep -qx 'none'; then
    print_notes "   🧹 Cleanup mode: will remove all ${label}"
    combined_ref="CLEANUP"
    return 0
  fi

  selections=$(echo "$selections" | grep -v '^none$')

  combined_ref=$(jq -n '{}')
  while IFS= read -r name; do
    local varname
    varname=$(config_varname "$prefix" "$name")
    local snippet="${!varname}"
    [[ -z "$snippet" ]] && {
      print_notes "   ⚠️  No config found for '$name' (expected \$$varname), skipping"
      continue
    }
    combined_ref=$(
      jq -c -n --argjson a "$combined_ref" --argjson b "$snippet" '$a * $b'
    )
  done <<< "$selections"

  print_notes "   ✅ ${label} selected: $(echo "$selections" | tr '\n' ' ')"
  return 0
}

# SERVICE :: opencode LSP selector ---------------------------------------------
# Built-in LSP servers start lazily (only when a matching file is opened), but
# excluding unwanted ones avoids needless installs/memory. "ALL" = lsp:true.
select_opencode_lsp() {
  if [[ ${#OPENCODE_CONFIG_LSP_NAMES[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No LSP servers available, skipping"
    OPENCODE_CONFIG_LSP_COMBINED=""
    return 0
  fi

  command -v fzf >/dev/null 2>&1 || { print_notes "   ⚠️  fzf not found, skipped LSP selection (LSP stays off)"; OPENCODE_CONFIG_LSP_COMBINED=""; return 0; }

  local fzf_list="ALL (enable all built-in LSP servers)"
  local name
  for name in "${OPENCODE_CONFIG_LSP_NAMES[@]}"; do
    fzf_list+=$'\n'"$name"
  done

  local selections
  local rc=0
  selections=$(fzf_pick "$fzf_list" "${OPENCODE_CONFIG_LSP_DEFAULT:-}" \
    'TAB: toggle, ENTER: confirm - unselected servers are disabled' \
    'Select LSP servers (ALL = everything): ') || rc=$?
  if [[ $rc -eq 130 ]]; then
    print_notes "   ⛔ Cancelled by user, aborting setup"
    exit 130
  fi
  [[ -z "$selections" ]] && {
    print_notes "   ⏭️  No LSP selected, LSP stays off"
    OPENCODE_CONFIG_LSP_COMBINED=""
    return 0
  }

  if grep -qx 'ALL (enable all built-in LSP servers)' <<< "$selections"; then
    print_notes "   📦 LSP enabled: all built-in servers"
    OPENCODE_CONFIG_LSP_COMBINED='true'
    return 0
  fi

  local all_json sel_json
  all_json=$(printf '%s\n' "${OPENCODE_CONFIG_LSP_NAMES[@]}" | jq -R -s 'split("\n") | map(select(length > 0))')
  sel_json=$(printf '%s\n' "$selections" | jq -R -s 'split("\n") | map(select(length > 0))')
  OPENCODE_CONFIG_LSP_COMBINED=$(jq -nc --argjson a "$all_json" --argjson s "$sel_json" \
    '$a - $s | map({ key: ., value: { disabled: true } }) | from_entries')

  print_notes "   📦 LSP enabled: $(echo "$selections" | tr '\n' ' ')"
  print_notes "   🚫 LSP disabled: $(echo "$OPENCODE_CONFIG_LSP_COMBINED" | jq -r 'keys | join(", ")')"
  return 0
}

# HELPERS :: prune skill dirs that are no longer wanted ------------------------
# Drop skill directories left behind by a deselected or renamed entry. Keys are
# the flattened leaf names, not the "label/[path/]name" selection strings.
# Args: <skills_dir> <prune_upstream:0|1> [upstream names to keep...]
reconcile_opencode_skills() {
  local skills_dir="$1" prune_upstream="$2"
  shift 2
  [[ -d "$skills_dir" ]] || return 0

  local -A keep=() declared=()
  local name
  for name in "$@"; do
    keep["${name##*/}"]=1
  done
  for name in ${OPENCODE_SKILL_NAMES[@]+"${OPENCODE_SKILL_NAMES[@]}"}; do
    declared["${name##*/}"]=1
  done

  local manifest="$skills_dir/.managed"
  local dir base target removed=() foreign=()
  for dir in "$skills_dir"/*/; do
    [[ -d "$dir" ]] || continue
    base="${dir%/}"
    base="${base##*/}"

    if [[ -L "$dir/SKILL.md" ]]; then
      # -e matters: readlink -f still prints a path for a dangling link, and a
      # rename in ai/ leaves exactly that behind
      target="$(readlink -f "$dir/SKILL.md" 2>/dev/null || true)"
      if [[ -e "$dir/SKILL.md" && "$target" == "$PWD/ai/"* ]]; then
        continue # linked above: ours and current
      fi
      removed+=("$base") # stale own skill: link dangling or no longer created
      continue
    fi

    [[ -n "${keep[$base]:-}" ]] && continue
    [[ "$prune_upstream" != "1" ]] && continue # no selection ran: leave upstream alone
    if [[ -n "${declared[$base]:-}" ]] || grep -qxF "$base" "$manifest" 2>/dev/null; then
      removed+=("$base") # our upstream copy, no longer selected
    else
      foreign+=("$base")
    fi
  done

  for base in ${removed[@]+"${removed[@]}"}; do
    rm -rf "${skills_dir:?}/${base}"
    print_notes "   🗑️  removed skill: $base"
  done

  # manifest = the kept upstream copies (own skills are self-identifying)
  {
    for base in "${!keep[@]}"; do
      if [[ -d "$skills_dir/$base" && ! -L "$skills_dir/$base/SKILL.md" ]]; then
        printf '%s\n' "$base"
      fi
    done | sort
  } >"$manifest"

  if [[ ${#foreign[@]} -gt 0 ]]; then
    print_notes "   ℹ️  not managed by setup-ai, left alone: ${foreign[*]}"
  fi
}

# SETUP :: opencode skills ----------------------------------------------------
setup_opencode_skills() {
  local skills_dir="$LN_OPENCODE/skills"
  local prune_upstream=0 # 1 = reconcile the upstream copies against the selection

  print_info2 "🔗 SKILLS :: linking ai/SKILL-*.md -> $skills_dir"
  create_symlink "${PWD}/ai/SKILL-git-release-notes.md" "$skills_dir/vm-git-release-notes/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-git-commit.md" "$skills_dir/vm-git-commit/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github-pr-issues.md" "$skills_dir/vm-github-pr-issues/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github-issue-research.md" "$skills_dir/vm-github-issue-research/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github-advisories.md" "$skills_dir/vm-github-advisories/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-repo-setup.md" "$skills_dir/vm-repo-setup/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-bash-script-style.md" "$skills_dir/vm-bash-script-style/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github-repo-audit.md" "$skills_dir/vm-github-repo-audit/SKILL.md"
