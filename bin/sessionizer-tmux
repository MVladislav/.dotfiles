#!/usr/bin/env bash
# Pick a project folder and open it in tmux, named after the folder.
set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$(readlink -f "$0")")/_sessionizer-common"
# shellcheck disable=SC1091 # optional, only present on some machines
[[ -r $HOME/.profile-secrets ]] && source "$HOME/.profile-secrets"

command -v fzf >/dev/null 2>&1 || {
  echo "fzf is not installed. Please install it and try again." >&2
  exit 1
}
command -v tmux >/dev/null 2>&1 || {
  echo "tmux is not installed. Please install it and try again." >&2
  exit 1
}

sessionizer_target "${1:-}" || exit 0
name=$(basename -- "$SESSIONIZER_TARGET" | tr ' ./' '__')

if [[ -n ${TMUX:-} ]]; then
  if tmux list-windows -F '#{window_name}' 2>/dev/null | grep -qxF -- "$name"; then
    exec tmux select-window -t ":$name"
  fi
  exec tmux new-window -n "$name" -c "$SESSIONIZER_TARGET"
fi

# outside tmux: create the session, or attach to it when it is already there
exec tmux new-session -A -s "$name" -c "$SESSIONIZER_TARGET"
