#!/usr/bin/env bash
# Pick a project folder and get a ready to paste "cd <path>" command.
set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$(readlink -f "$0")")/_sessionizer-common"
# shellcheck disable=SC1091 # optional, only present on some machines
[[ -r $HOME/.profile-secrets ]] && source "$HOME/.profile-secrets"

command -v fzf >/dev/null 2>&1 || {
  echo "fzf is not installed. Please install it and try again." >&2
  exit 1
}

sessionizer_target "${1:-}" || exit 0
printf -v jump 'cd %q' "$SESSIONIZER_TARGET"
sessionizer_copy "$jump" || true
printf '%s\n' "$jump"
