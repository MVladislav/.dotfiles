# SERVICE :: install jadx -----------------------------------------------------
install_jadx() {
  print_info2 "\n🚀 JADX :: install jadx-headless-mcp bridge..."
  local version="${OPENCODE_CONFIG_MCP_REA_JADX_VERSION:?JADX version is not configured}"
  local jar_sha="${OPENCODE_CONFIG_MCP_REA_JADX_SHA256:?JADX checksum is not configured}"
  local jar_name="jadx-headless-mcp-${version}-all.jar"
  local jar_url="https://github.com/1013503897/jadx-headless-mcp/releases/download/v${version}/${jar_name}"
  local jar_path jar_dir
  # Same resolution the REA MCP entry uses, including a REA_JADX_MCP_JAR override.
  jar_path=$(rea_jadx_jar_path)
  jar_dir=$(dirname "$jar_path")

  require_cmds curl sha256sum || return 1

  local packages_tools=(default-jdk-headless)
  local packages_build=()
  print_notes "   ⏳ installing a full JDK for JADX (default-jdk-headless)..."
  install_dependencies_needs packages_tools[@] packages_build[@] || return 1

  mkdir -p "$jar_dir"
  if [[ ! -f "$jar_path" ]] || [[ "$(sha256sum "$jar_path" 2>/dev/null | awk '{print $1}')" != "$jar_sha" ]]; then
    run_quiet_hint "   ⏳ downloading jadx-headless-mcp ${version}..." \
      curl -fsSL -o "$jar_path" "$jar_url" || {
        print_error "❌ JADX :: download failed"
        rm -f "$jar_path"
        return 1
      }
    local actual
    actual=$(sha256sum "$jar_path" | awk '{print $1}')
    if [[ "$actual" != "$jar_sha" ]]; then
      print_error "❌ JADX :: checksum mismatch (expected $jar_sha, got $actual)"
      rm -f "$jar_path"
      return 1
    fi
  fi

  persist_env_setting REA_JADX_MCP_JAR "$jar_path"
  print_notes "   💡 JADX bridge: $jar_path"
  print_info2 "✅ JADX :: jadx-headless-mcp installed!"
}

# SERVICE :: install hopper ----------------------------------------------------
install_hopper() {
  print_info2 "\n🚀 HOPPER :: install Hopper demo..."
  require_cmds curl jq sha1sum dpkg base64 || return 1

  # Official Linux packages are x86_64-only; this installer handles apt hosts.
  if [[ "$(uname -m)" != "x86_64" ]]; then
    print_notes "   ⏭️  Hopper Linux packages are x86_64-only; skipping on $(uname -m)"
    return 0
  fi
  command -v apt-get >/dev/null 2>&1 || {
    print_notes "   ⏭️  Hopper auto-install supports apt hosts only; set HOPPER_LAUNCHER_PATH manually"
    return 0
  }

  # Runtime deps (from rea's Hopper plan) plus gnupg for signature verification.
  local packages_tools=(xvfb xauth python3 libx11-6 libxtst6 gnupg)
  local packages_build=()
  print_notes "   ⏳ installing Hopper runtime deps (xvfb, xauth, python3, X11, gnupg)..."
  install_dependencies_needs packages_tools[@] packages_build[@] || return 1
  require_cmds gpg || return 1

  # Fetch release metadata (needs a browser-like User-Agent).
  local api_url="https://www.hopperapp.com/include/files-api.php?request=releases&public=true"
  local meta deb_url deb_sha1 deb_sig deb_name
  meta=$(curl -fsSL -A "Mozilla/5.0" "$api_url" 2>/dev/null) || {
    print_error "❌ HOPPER :: could not fetch release metadata"
    return 1
  }
  deb_url=$(echo "$meta" | jq -r '."Ubuntu / Mint".filename // empty')
  deb_sha1=$(echo "$meta" | jq -r '."Ubuntu / Mint".file_hash // empty')
  deb_sig=$(echo "$meta" | jq -r '."Ubuntu / Mint".signature // empty')
  [[ -n "$deb_url" && -n "$deb_sha1" && -n "$deb_sig" ]] || {
    print_error "❌ HOPPER :: no signed Ubuntu release in metadata"
    return 1
  }
  deb_name=$(basename "$deb_url")

  local cache_dir="$HOME/.cache/rea/hopper-releases/$deb_sha1"
  mkdir -p "$cache_dir"
  local deb_path="$cache_dir/$deb_name"

  if [[ ! -f "$deb_path" ]] || [[ "$(sha1sum "$deb_path" 2>/dev/null | awk '{print $1}')" != "$deb_sha1" ]]; then
    run_quiet_hint "   ⏳ downloading Hopper demo ($deb_name, ~34MB)..." \
      curl -fsSL -A "Mozilla/5.0" -o "$deb_path" "$deb_url" || {
        print_error "❌ HOPPER :: download failed"
        rm -f "$deb_path"
        return 1
      }
    local actual
    actual=$(sha1sum "$deb_path" | awk '{print $1}')
    if [[ "$actual" != "$deb_sha1" ]]; then
      print_error "❌ HOPPER :: checksum mismatch (expected $deb_sha1, got $actual)"
      rm -f "$deb_path"
      return 1
    fi
  fi

  # Verify the detached signature from Hopper's published key. The package
  # hash above is SHA-1; the signature binds the exact package bytes.
  local key_url="https://www.hopperapp.com/hopper-public-key.asc"
  local key_path="$cache_dir/hopper-public-key.asc"
  local sig_path="$cache_dir/release.sig"
  local gpg_home="$cache_dir/gnupg"
  if [[ ! -s "$key_path" ]]; then
    run_quiet_hint "   ⏳ downloading Hopper signing key..." \
      curl -fsSL -A "Mozilla/5.0" -o "$key_path" "$key_url" || {
        print_error "❌ HOPPER :: could not download signing key"
        rm -f "$key_path"
        return 1
      }
  fi
  if ! printf '%s' "$deb_sig" | base64 -d > "$sig_path" 2>/dev/null; then
    print_error "❌ HOPPER :: invalid signature metadata"
    return 1
  fi

  mkdir -p "$gpg_home"
  chmod 700 "$gpg_home"
  if ! gpg --homedir "$gpg_home" --batch --import "$key_path" >/dev/null 2>&1; then
    print_error "❌ HOPPER :: could not import signing key"
    return 1
  fi
  local gpg_status
  if ! gpg_status=$(gpg --homedir "$gpg_home" --batch --status-fd 1 \
    --verify "$sig_path" "$deb_path" 2>/dev/null); then
    print_error "❌ HOPPER :: package signature verification failed"
    return 1
  fi
  if ! grep -q '7C2D73BAFAF5B9A710A69DA1A26DF815099B1BCD' <<<"$gpg_status"; then # pragma: allowlist secret
    print_error "❌ HOPPER :: package was not signed by Hopper's release key"
    return 1
  fi

  # Install the verified package. RUN_WITH_SUDO is either empty or "sudo".
  # shellcheck disable=SC2086
  if ! run_quiet_hint "   ⏳ installing Hopper package..." \
    $RUN_WITH_SUDO dpkg -i "$deb_path"; then
    print_notes "   ⚠️  dpkg reported errors; fixing dependencies..."
    # shellcheck disable=SC2086
    run_quiet $RUN_WITH_SUDO "${APT_ENV[@]}" apt-get -f install -y || true
  fi

  # Install the matching libpython if the one Hopper needs is not loadable.
  local pyver
  pyver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || true)
  if [[ -n "$pyver" ]] && ! python3 -c "import ctypes; ctypes.CDLL('libpython${pyver}.so.1.0')" 2>/dev/null; then
    # install_dependencies_needs reads these arrays by nameref.
    # shellcheck disable=SC2034
    local lp_tools=("libpython${pyver}")
    # shellcheck disable=SC2034
    local lp_build=()
    install_dependencies_needs lp_tools[@] lp_build[@] 2>/dev/null || true
  fi

  local launcher
  launcher=$(command -v hopper 2>/dev/null || true)
  if [[ -z "$launcher" ]]; then
    launcher=$(find /usr/bin /opt /usr/local -type f -name 'hopper' 2>/dev/null | head -n1)
  fi
  if [[ -n "$launcher" ]]; then
    print_notes "   💡 Hopper launcher: $launcher"
    persist_env_setting HOPPER_LAUNCHER_PATH "$launcher"
  else
    print_notes "   ⚠️  Hopper installed but launcher not found on PATH"
  fi

  print_info2 "✅ HOPPER :: Hopper demo installed!"
}

# HELPERS :: optional Hopper install -------------------------------------------
# Hopper is large and optional; prompt only on a TTY. Non-interactive runs skip
# it so `setup-ai -irea` stays automation-friendly.
install_rea_optional_hopper() {
  if [[ ! -t 0 ]]; then
    print_notes "   ⏭️  non-interactive: skipping Hopper (run 'bash setup-ai -irea' interactively)"
    return 0
  fi

  local answer=""
  read -r -p "   Install Hopper (free demo) for deep binary analysis? [y/N] " answer || true
  case "$answer" in
  [Yy]*)
    install_hopper || print_notes "   ⚠️  Hopper install failed; see ai/REA.md"
    ;;
  *)
    print_notes "   ⏭️  skipping Hopper (rerun 'bash setup-ai -irea' to install it)"
    ;;
  esac
}

# SERVICE :: install llama.cpp -------------------------------------------------
install_llamacpp() {
  print_info2 "\n🚀 LLAMACPP :: install llama.cpp..."
  print_notes "   💡 current installed version :: '$(llamacpp_binary_version)'"
  rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null

  # packages_tools stay installed (runtime needs them); packages_build is removed
  # afterwards. pkg-config is REQUIRED: with GGML_BLAS=ON, CMake's FindBLAS needs
  # it to locate OpenBLAS on Debian/Ubuntu (kitware#20268).
  local packages_tools=(libopenblas-dev)
  # shellcheck disable=SC2034
  local packages_build=(git cmake build-essential pkg-config)
  if [[ $RUN_INSTALL_LLAMACPP_VULKAN -eq 1 ]]; then
    # Vulkan backend (AMD via RADV, Intel, NVIDIA); drivers stay installed
    packages_tools+=(mesa-vulkan-drivers vulkan-tools libvulkan-dev glslang-tools)
  fi
  install_dependencies_needs packages_tools[@] packages_build[@]

  # -- backend selection ------------------------------------------------------
  # Vulkan (explicit) > CUDA > HIP (ROCm) > CPU+BLAS. GGML_NATIVE (default ON)
  # already compiles for the exact host CPU, so the CPU path needs no flag.
  local gpu_flags=()
  local cmake_env=()
  if [[ $RUN_INSTALL_LLAMACPP_VULKAN -eq 1 ]]; then
    gpu_flags=(-DGGML_VULKAN=ON)
    print_notes "   🎮 Vulkan backend requested (GGML_VULKAN=ON) - works with AMD/RADV, Intel and NVIDIA"
  elif command -v nvcc >/dev/null 2>&1; then
    local cuda_archs
    cuda_archs=$(llamacpp_detect_cuda_archs)
    gpu_flags=(-DGGML_CUDA=ON)
    [[ -n "$cuda_archs" ]] && gpu_flags+=(-DCMAKE_CUDA_ARCHITECTURES="$cuda_archs")
    cmake_env=(env PATH="$(dirname "$(command -v nvcc)"):$PATH"
      LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}")
    print_notes "   🎮 NVIDIA CUDA toolkit detected - building with GGML_CUDA=ON${cuda_archs:+ (arches: $cuda_archs)}"
  elif lspci 2>/dev/null | grep -qiE 'AMD/ATI|Radeon'; then
    if [[ -d /opt/rocm ]] && command -v rocminfo >/dev/null 2>&1; then
      local gfx_target
      gfx_target=$(rocminfo 2>/dev/null | grep -m1 -oE 'gfx[0-9a-f]+' || true)
      if [[ -n "$gfx_target" ]]; then
        gpu_flags=(-DGGML_HIPBLAS=ON -DAMDGPU_TARGETS="$gfx_target")
        cmake_env=(env PATH="/opt/rocm/bin:$PATH")
        print_notes "   🎮 AMD GPU + ROCm ($gfx_target) detected - building with HIPBLAS"
        print_notes "   💡 unsupported GPU at runtime: HSA_OVERRIDE_GFX_VERSION=$gfx_target"
      else
        print_notes "   ⚠️  AMD GPU found, no gfx target from rocminfo - building CPU-only"
      fi
    else
      print_notes "   ⚠️  AMD GPU found but ROCm toolkit missing - building CPU-only"
      print_notes "   💡 install ROCm (https://rocm.docs.amd.com) or use $0 -illv for Vulkan"
    fi
  else
    print_notes "   💡 no supported GPU detected - building CPU-only with OpenBLAS"
  fi

  # -- fetch ------------------------------------------------------------------
  print_notes "   📦 cloning llama.cpp $VERSION_LLAMACPP..."
  run_quiet_hint "⏳ cloning $VERSION_LLAMACPP_REPO (a few MB, can take a minute)..." \
    git clone -q "$VERSION_LLAMACPP_REPO" "$DEPS_INSTALL_PATH/llama.cpp"
  pushd "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
  [[ $INSTALL_SOURCE_FROM == 'release' ]] && git checkout -q "$VERSION_LLAMACPP"

  # -- build ------------------------------------------------------------------
  # Only the four binaries this dotfiles setup actually uses; skipping the test
  # suite, examples and the remaining tools cuts build time by more than half.
  # Configure and build are captured: cmake progress is not our output, but a
  # failure prints the tail so the actual error is never hidden.
  print_notes "   🔧 building llama-server, llama-cli, llama-quantize, llama-bench (${gpu_flags[*]:-CPU})..."
  if ! run_quiet_hint "⏳ configuring the build (cmake)..." "${cmake_env[@]}" cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DLLAMA_BUILD_TOOLS=ON \
    -DLLAMA_BUILD_SERVER=ON \
    -DGGML_BLAS=ON \
    -DGGML_BLAS_VENDOR=OpenBLAS \
    "${gpu_flags[@]}"; then
    print_error "   ❌ cmake configure failed"
    popd 1>/dev/null
    rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
    install_dependencies_needs_rm
    return 1
  fi

  # A build log is worth keeping on failure, so only tail it live.
  local build_log="$DEPS_INSTALL_PATH/llamacpp-build.log"
  print_notes "   ⏳ this takes a few minutes on $(nproc) cores (log: $build_log)"
  if ! "${cmake_env[@]}" cmake --build build --config Release \
    -j "$(nproc)" \
    --target llama-server llama-cli llama-quantize llama-bench >"$build_log" 2>&1; then
    print_error "   ❌ build failed - last 25 lines:"
    tail -n 25 "$build_log" | while IFS= read -r line; do print_notes "      $line"; done
    print_notes "   ↳ full log: $build_log"
    popd 1>/dev/null
    rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
    install_dependencies_needs_rm
    return 1
  fi
  rm -f "$build_log"

  mkdir -p "$USER_LOCAL_PREFIX_BIN"
  local installed=() bin
  for bin in llama-server llama-cli llama-quantize llama-bench; do
    if [[ -f "build/bin/$bin" ]]; then
      cp -f "build/bin/$bin" "$USER_LOCAL_PREFIX_BIN/"
      installed+=("$bin")
    fi
  done
  popd 1>/dev/null

  if [[ ${#installed[@]} -eq 0 ]]; then
    print_error "   ❌ build produced no binaries"
    rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
    install_dependencies_needs_rm
    return 1
  fi

  # Smoke test: a build can succeed and still produce binaries that cannot
  # start (missing shared library, wrong RPATH). Catch that here rather than at
  # first use. NOTE: --version prints on stderr and exits 0, so judge by exit
  # code and by the loader's message, never by "stderr was non-empty".
  local smoke_out smoke_rc=0
  smoke_out=$("$USER_LOCAL_PREFIX_BIN/llama-server" --version 2>&1) || smoke_rc=$?
  if ((smoke_rc != 0)) || [[ "$smoke_out" == *"error while loading shared"* ]]; then
    print_error "   ❌ llama-server is installed but cannot run (exit $smoke_rc):"
    print_notes "      $(echo "$smoke_out" | head -n1)"
    print_error "   ❌ build tree kept for inspection: $DEPS_INSTALL_PATH/llama.cpp"
    install_dependencies_needs_rm
    return 1
  fi
  print_notes "   ✅ smoke test: llama-server starts"

  # Only now is the build tree disposable.
  rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
  print_notes "   💡 new installed version :: '$(llamacpp_binary_version)'"

  install_dependencies_needs_rm

  print_info2 "✅ LLAMACPP :: llama.cpp installed ($(echo "${installed[*]}" | tr ' ' ','))!"
  print_notes "   ➡️ next: $0 -sll   (pick a model + start the API server)"
}

# HELPERS :: detect CUDA architectures ------------------------------------------
# Empty result = let CMake pick the default (native/CUDA default arch).
llamacpp_detect_cuda_archs() {
  command -v nvidia-smi >/dev/null 2>&1 || return 0
  local sm
  sm=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -n1) || return 0
  [[ "$sm" =~ ^([0-9]+)\.([0-9]+)$ ]] || return 0
  # CMake wants "major;minor", nvidia-smi reports "major.minor" (8.6 -> 86).
  printf '%s;%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

# HELPERS :: llama-server version, never blank ----------------------------------
llamacpp_binary_version() {
  local bin="$USER_LOCAL_PREFIX_BIN/llama-server"
  if [[ ! -x "$bin" ]]; then
    echo "not installed"
    return 0
  fi
  local out
  out=$("$bin" --version 2>&1 | head -n1)
  out="${out%"${out##*[![:space:]]}"}"
  if [[ "$out" == *"error while loading shared"* || "$out" == *"cannot open shared object"* ]]; then
    echo "unrunnable: $out"
  elif [[ -z "$out" ]]; then
    echo "installed, but '--version' printed nothing"
  else
    echo "$out"
  fi
}
