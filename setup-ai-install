# SERVICE :: install opencode --------------------------------------------------
install_opencode() {
  print_info2 "\n🚀 OPENCODE :: install opencode..."
  print_notes "   💡 current installed version :: '$(installed_version "$USER_LOCAL_PREFIX_BIN/opencode" --version)'"
  local version
  version="${VERSION_OPENCODE#v}" # npm versions carry no leading "v", the pin does
  mkdir -p "$USER_LOCAL_PREFIX_BIN"
  # stream the member out of the tarball: unpacking into a temp dir needs ~3x the
  # binary in $TMPDIR, which is a small tmpfs on some hosts
  curl -fsSL "https://registry.npmjs.org/@opencode/cli-linux-x64/-/cli-linux-x64-${version}.tgz" |
    tar -xzO package/bin/opencode > "$USER_LOCAL_PREFIX_BIN/opencode.tmp"
  mv "$USER_LOCAL_PREFIX_BIN/opencode.tmp" "$USER_LOCAL_PREFIX_BIN/opencode"
  chmod +x "$USER_LOCAL_PREFIX_BIN/opencode"
  print_notes "   💡 new installed version :: '$(installed_version "$USER_LOCAL_PREFIX_BIN/opencode" --version)'"
  print_info2 "✅ OPENCODE :: opencode installed!"
}

