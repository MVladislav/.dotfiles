# SERVICE :: install rea ------------------------------------------------------
install_rea() {
  print_info2 "\n🚀 REA :: install rea..."
  local version="${OPENCODE_CONFIG_MCP_REA_VERSION:?REA version is not configured}"
  print_notes "   💡 current installed version :: '$(installed_version "$USER_LOCAL_PREFIX_BIN/rea" --version)'"

  require_cmds node npm || return 1
  mkdir -p "$USER_LOCAL_PREFIX"

  if ! run_quiet_hint "   ⏳ installing rea-agents@${version} into ${USER_LOCAL_PREFIX}..." \
    npm install --global --prefix "$USER_LOCAL_PREFIX" --no-fund --no-audit "rea-agents@${version}"; then
    print_error "❌ REA :: npm install failed."
    return 1
  fi
  print_notes "   💡 new installed version :: '$(installed_version "$USER_LOCAL_PREFIX_BIN/rea" --version)'"

  install_rea_engines || print_notes "   ⚠️  some free REA engines could not be installed; see ai/REA.md"
  install_jadx || print_notes "   ⚠️  JADX bridge not installed; see ai/REA.md"
  install_rea_optional_hopper

  print_notes "   💡 verify with: rea doctor --json (see ai/REA.md)"
  print_info2 "✅ REA :: rea installed!"
}

