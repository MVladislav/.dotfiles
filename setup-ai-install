#!/usr/bin/env bash
# shellcheck shell=bash
PATH="/usr/bin/:/usr/local/bin/:/bin/:/usr/sbin/:/sbin/:/snap/bin/:$HOME/.local/bin"
set -euo pipefail

# CONFIG/INSTALL :: sourced by setup-ai
# Installer functions for every tool setup-ai manages.
