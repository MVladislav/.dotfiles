# NOTE: ~~runs inside 'install_opencode'~~
setup_opencode() {
  print_section "⚙️ OPENCODE :: configuring opencode"
  print_info2 "🔗 OPENCODE :: config directory at $LN_OPENCODE"
  mkdir -p "$LN_OPENCODE"
  command -v jq >/dev/null 2>&1 || { print_notes "   ⚠️  jq not found, cannot configure opencode"; return; }

  echo ""
  select_opencode_section "PROVIDER" "providers"
  echo ""
  select_opencode_section "MCP" "MCP configs"
  echo ""
  select_opencode_section "AGENTS" "agents"
  echo ""
  select_opencode_lsp
  echo ""
  setup_opencode_skills

  local opencode_config
  opencode_config=$(jq -n --arg schema "https://opencode.ai/config.json" '{"$schema": $schema}')
  opencode_config=$(echo "$opencode_config" | jq --arg timeout "3600000" '.timeout = $timeout')

  echo ""
  if [[ -n "$OPENCODE_CONFIG_MCP_COMBINED" && "$OPENCODE_CONFIG_MCP_COMBINED" != "CLEANUP" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson m "$OPENCODE_CONFIG_MCP_COMBINED" '.mcp = $m')
  fi
  if [[ -n "$OPENCODE_CONFIG_AGENTS_COMBINED" && "$OPENCODE_CONFIG_AGENTS_COMBINED" != "CLEANUP" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson a "$OPENCODE_CONFIG_AGENTS_COMBINED" '.agent = $a')
  fi
  if [[ -n "$OPENCODE_CONFIG_LSP_COMBINED" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson l "$OPENCODE_CONFIG_LSP_COMBINED" '.lsp = $l')
  fi
  if [[ -n "$OPENCODE_CONFIG_PROVIDER_COMBINED" && "$OPENCODE_CONFIG_PROVIDER_COMBINED" != "CLEANUP" ]]; then
    opencode_config=$(echo "$opencode_config" | jq --argjson p "$OPENCODE_CONFIG_PROVIDER_COMBINED" '.provider = $p')
  fi

  local config_file="$LN_OPENCODE/opencode.jsonc"
  if [[ -f "$config_file" ]]; then
    local backup_file
    backup_file="${config_file}.$(date '+%Y%m%d-%H%M%S').bak"
    cp "$config_file" "$backup_file"
    print_notes "   💾 backed up existing config to $(basename "$backup_file")"

    [[ "$OPENCODE_CONFIG_MCP_COMBINED" == "CLEANUP" ]] &&
      jq 'del(.mcp)' "$config_file" > "${config_file}.tmp" &&
      mv "${config_file}.tmp" "$config_file" &&
      print_notes "   🧹 Removed all MCP configs"
    [[ "$OPENCODE_CONFIG_AGENTS_COMBINED" == "CLEANUP" ]] &&
      jq 'del(.agent)' "$config_file" > "${config_file}.tmp" &&
      mv "${config_file}.tmp" "$config_file" &&
      print_notes "   🧹 Removed all agent configs"
    [[ "$OPENCODE_CONFIG_PROVIDER_COMBINED" == "CLEANUP" ]] &&
      jq 'del(.provider)' "$config_file" > "${config_file}.tmp" &&
      mv "${config_file}.tmp" "$config_file" &&
      print_notes "   🧹 Removed all provider configs"

    local merge_del=""
    [[ -n "$OPENCODE_CONFIG_LSP_COMBINED" ]] && merge_del=".lsp"
    [[ -n "$OPENCODE_CONFIG_PROVIDER_COMBINED" && "$OPENCODE_CONFIG_PROVIDER_COMBINED" != "CLEANUP" ]] &&
      merge_del="${merge_del:+$merge_del,}.provider"
    local merge_filter='.[0] * .[1]'
    [[ -n "$merge_del" ]] && merge_filter=".[0] * (.[1] | del($merge_del))"

    print_notes "   🔧 merging selected configs into existing $config_file"
    if jq -s "$merge_filter" <(echo "$opencode_config") "$config_file" > "${config_file}.tmp" \
      && mv "${config_file}.tmp" "$config_file"; then
      :
    else
      print_notes "   ⚠️ Merge failed, config unchanged"
    fi
  else
    [[ "$OPENCODE_CONFIG_MCP_COMBINED" == "CLEANUP" ]] &&
      print_notes "   ⏭️ No config file found, nothing to clean for MCPs"
    [[ "$OPENCODE_CONFIG_AGENTS_COMBINED" == "CLEANUP" ]] &&
      print_notes "   ⏭️ No config file found, nothing to clean for agents"
    [[ "$OPENCODE_CONFIG_PROVIDER_COMBINED" == "CLEANUP" ]] &&
      print_notes "   ⏭️ No config file found, nothing to clean for providers"
    print_notes "   📝 writing config to $config_file"
    echo "$opencode_config" > "$config_file"
  fi

  local env_vars
  env_vars=$(echo "$opencode_config" | jq -r '.. | objects | .[]? | select(type == "string") | capture("{env:(?<v>[^}]+)}") | .v' 2>/dev/null | sort -u || true)
  if [[ -n "$env_vars" ]]; then
    print_info2 "   ⚠️ Ensure these environment variables are set:"
    while IFS= read -r var; do
      print_info2 "      - $var"
    done <<< "$env_vars"
  fi

  print_section_end "✅ OPENCODE :: config ready."
}

# HELPERS :: config varname of a section entry ----------------------------------
config_varname() {
  echo "OPENCODE_CONFIG_${1}_$(echo "$2" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
}

# SERVICE :: generic section selector (MCPs / agents) --------------------------
select_opencode_section() {
  local prefix="$1"
  local label="$2"

  local -n names_ref="OPENCODE_CONFIG_${prefix}_NAMES"
  local -n combined_ref="OPENCODE_CONFIG_${prefix}_COMBINED"
  local -n default_ref="OPENCODE_CONFIG_${prefix}_DEFAULT"

  if [[ ${#names_ref[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No ${label} available, skipping"
    combined_ref=""
    return 0
  fi

  command -v fzf >/dev/null 2>&1 || { print_notes "   ⚠️  fzf not found, cannot configure ${label}"; return 0; }

  local preview_dir
  preview_dir=$(mktemp -d)
  for name in "${names_ref[@]}"; do
    local varname
    varname=$(config_varname "$prefix" "$name")
    echo "${!varname}" > "$preview_dir/$name.json"
  done

  local fzf_list="none"
  for name in "${names_ref[@]}"; do
    fzf_list+=$'\n'"$name"
  done

  local selections
  selections=$(fzf_pick "$fzf_list" "${default_ref:-}" 'TAB: toggle, ENTER: confirm' \
    "Select ${label} (none = cleanup): " \
    'jq . '"$preview_dir"'/{}.json 2>/dev/null || cat '"$preview_dir"'/{}.json 2>/dev/null')
  rm -rf "$preview_dir"

  [[ -z "$selections" ]] && {
    print_notes "   ⏭️  No ${label} selected"
    combined_ref=""
    return 0
  }

  if echo "$selections" | grep -qx 'none'; then
    print_notes "   🧹 Cleanup mode: will remove all ${label}"
    combined_ref="CLEANUP"
    return 0
  fi

  selections=$(echo "$selections" | grep -v '^none$')

  combined_ref=$(jq -n '{}')
  while IFS= read -r name; do
    local varname
    varname=$(config_varname "$prefix" "$name")
    local snippet="${!varname}"
    [[ -z "$snippet" ]] && {
      print_notes "   ⚠️  No config found for '$name' (expected \$$varname), skipping"
      continue
    }
    combined_ref=$(
      jq -c -n --argjson a "$combined_ref" --argjson b "$snippet" '$a * $b'
    )
  done <<< "$selections"

  print_notes "   ✅ ${label} selected: $(echo "$selections" | tr '\n' ' ')"
  return 0
}

# SERVICE :: opencode LSP selector ---------------------------------------------
# Built-in LSP servers start lazily (only when a matching file is opened), but
# excluding unwanted ones avoids needless installs/memory. "ALL" = lsp:true.
select_opencode_lsp() {
  if [[ ${#OPENCODE_CONFIG_LSP_NAMES[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No LSP servers available, skipping"
    OPENCODE_CONFIG_LSP_COMBINED=""
    return 0
  fi

  command -v fzf >/dev/null 2>&1 || { print_notes "   ⚠️  fzf not found, skipped LSP selection (LSP stays off)"; OPENCODE_CONFIG_LSP_COMBINED=""; return 0; }

  local fzf_list="ALL (enable all built-in LSP servers)"
  local name
  for name in "${OPENCODE_CONFIG_LSP_NAMES[@]}"; do
    fzf_list+=$'\n'"$name"
  done

  local selections
  selections=$(fzf_pick "$fzf_list" "${OPENCODE_CONFIG_LSP_DEFAULT:-}" \
    'TAB: toggle, ENTER: confirm - unselected servers are disabled' \
    'Select LSP servers (ALL = everything): ')
  [[ -z "$selections" ]] && {
    print_notes "   ⏭️  No LSP selected, LSP stays off"
    OPENCODE_CONFIG_LSP_COMBINED=""
    return 0
  }

  if grep -qx 'ALL (enable all built-in LSP servers)' <<< "$selections"; then
    print_notes "   📦 LSP enabled: all built-in servers"
    OPENCODE_CONFIG_LSP_COMBINED='true'
    return 0
  fi

  local all_json sel_json
  all_json=$(printf '%s\n' "${OPENCODE_CONFIG_LSP_NAMES[@]}" | jq -R -s 'split("\n") | map(select(length > 0))')
  sel_json=$(printf '%s\n' "$selections" | jq -R -s 'split("\n") | map(select(length > 0))')
  OPENCODE_CONFIG_LSP_COMBINED=$(jq -nc --argjson a "$all_json" --argjson s "$sel_json" \
    '$a - $s | map({ key: ., value: { disabled: true } }) | from_entries')

  print_notes "   📦 LSP enabled: $(echo "$selections" | tr '\n' ' ')"
  print_notes "   🚫 LSP disabled: $(echo "$OPENCODE_CONFIG_LSP_COMBINED" | jq -r 'keys | join(", ")')"
  return 0
}

# SETUP :: opencode skills ----------------------------------------------------
setup_opencode_skills() {
  local skills_dir="$LN_OPENCODE/skills"

  print_info2 "🔗 SKILLS :: linking ai/SKILL-*.md -> $skills_dir"
  create_symlink "${PWD}/ai/SKILL-git-release.md" "$skills_dir/git-release/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-git-commit.md" "$skills_dir/git-commit/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github.md" "$skills_dir/github/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github-research.md" "$skills_dir/github-research/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github-security.md" "$skills_dir/github-security/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-project-bootstrap.md" "$skills_dir/project-bootstrap/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-bash-script.md" "$skills_dir/bash-script/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-github-project-audit.md" "$skills_dir/github-project-audit/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-docker-stack-maintainer.md" "$skills_dir/docker-stack-maintainer/SKILL.md"
  create_symlink "${PWD}/ai/SKILL-unifi.md" "$skills_dir/unifi/SKILL.md"
  create_symlink "${PWD}/ai/unifi-companion/UNIFI-API.md" "$skills_dir/unifi/UNIFI-API.md"
  create_symlink "${PWD}/ai/unifi-companion/UNIFI-ONBOARDING.md" "$skills_dir/unifi/UNIFI-ONBOARDING.md"
  create_symlink "${PWD}/ai/SKILL-opnsense.md" "$skills_dir/opnsense/SKILL.md"
  create_symlink "${PWD}/ai/opnsense-companion/API.md" "$skills_dir/opnsense/API.md"
  create_symlink "${PWD}/ai/opnsense-companion/ONBOARDING.md" "$skills_dir/opnsense/ONBOARDING.md"
  create_symlink "${PWD}/ai/GITHUB.md" "$skills_dir/github/GITHUB.md"

  local skills_to_install=()
  if [[ ${#OPENCODE_SKILL_NAMES[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No upstream skills available, fetch skipped"
  elif ! command -v fzf >/dev/null 2>&1; then
    print_notes "   ⚠️  fzf not found, upstream skills fetch skipped"
  else
    local first_label="${OPENCODE_SKILL_SOURCES[0]%%|*}"

    # name -> "repo subdir" lookup table for the fzf preview. A plain name maps
    # to the first source (its install fallback); "label/name" to that source.
    local preview_dir
    preview_dir=$(mktemp -d)
    local sources_tsv="$preview_dir/sources.tsv"
    local line label repo rev subdir name
    for line in "${OPENCODE_SKILL_SOURCES[@]}"; do
      IFS='|' read -r label repo rev subdir <<<"$line"
      for name in "${OPENCODE_SKILL_NAMES[@]}"; do
        if [[ $name == "$label/"* ]] || [[ $name != */* && $label == "$first_label" ]]; then
          printf '%s\t%s\t%s\n' "$name" "$repo" "$subdir" >> "$sources_tsv"
        fi
      done
    done
    # fzf preview: show install target + source for the current line (tsv lookup)
    local preview_cmd
    preview_cmd="awk -F '\t' -v n='{}' -v d='$skills_dir' '\$1 == n { strip = \$1; sub(/^[^\/]+\//, \"\", strip); printf \"install target: %s/%s/\\nsource: %s/%s/%s\\n\", d, strip, \$2, \$3, strip; exit }' '$sources_tsv'"
    local fzf_list="none"
    for name in "${OPENCODE_SKILL_NAMES[@]}"; do
      fzf_list+=$'\n'"$name"
    done

    local selections
    selections=$(fzf_pick "$fzf_list" "${OPENCODE_SKILLS_DEFAULT:-}" \
      'TAB: toggle, ENTER: confirm - none = remove installed skills' \
      'Select skills to fetch: ' \
      "$preview_cmd")
    rm -rf "$preview_dir"

    if [[ -z "$selections" ]]; then
      :
    elif echo "$selections" | grep -qx 'none'; then
      print_notes "   🧹 Cleanup mode: removing installed skills"
      for name in "${OPENCODE_SKILL_NAMES[@]}"; do
        local dir_name="${name#*/}"
        if [[ -d "$skills_dir/$dir_name" ]]; then
          rm -rf "${skills_dir:?}/$dir_name"
          print_notes "   🗑️  removed skill: $dir_name"
        fi
      done
    else
      mapfile -t skills_to_install <<< "$(echo "$selections" | grep -v '^none$')"
    fi
  fi

  if [[ ${#skills_to_install[@]} -eq 0 ]]; then
    print_notes "   ⏭️  No skills selected, fetch skipped"
    print_info2 "✅ SKILLS :: skills ready."
    return 0
  fi

  # Resolve source metadata per label (falls back to the first source)
  local -A source_repos=() source_revs=() source_subdirs=()
  local line label repo rev subdir
  for line in "${OPENCODE_SKILL_SOURCES[@]}"; do
    IFS='|' read -r label repo rev subdir <<<"$line"
    source_repos[$label]=$repo
    source_revs[$label]=$rev
    source_subdirs[$label]=$subdir
  done
  local first_label
  first_label="${OPENCODE_SKILL_SOURCES[0]%%|*}"

  local tmp
  tmp=$(mktemp -d)
  local -A cloned=()
  local name skill_label skill_name
  for name in "${skills_to_install[@]}"; do
    skill_name="${name#*/}"
    skill_label="${name%%/*}"
    if [[ $skill_name == "$name" ]]; then
      skill_label="$first_label"
    fi
    local repo="${source_repos[$skill_label]:-}"
    if [[ -z $repo ]]; then
      print_notes "   ⚠️  unknown skill source '$skill_label', skipping $name"
      continue
    fi
    if [[ -z ${cloned[$skill_label]:-} ]]; then
      print_info2 "📥 SKILLS :: fetching $repo..."
      if git clone --quiet --depth 1 "$repo" "$tmp/$skill_label"; then
        if [[ -n "${source_revs[$skill_label]:-}" ]]; then
          git -C "$tmp/$skill_label" fetch --quiet --depth 1 origin "${source_revs[$skill_label]}" \
            && git -C "$tmp/$skill_label" checkout --quiet FETCH_HEAD
        fi
        cloned[$skill_label]=1
      else
        print_notes "   ⚠️  could not clone $repo, skills skipped"
        continue
      fi
    fi
    local subdir="${source_subdirs[$skill_label]:-}"
    if [[ -d "$tmp/$skill_label/$subdir/$skill_name" ]]; then
      mkdir -p "$skills_dir/$skill_name"
      cp -r "$tmp/$skill_label/$subdir/$skill_name/." "$skills_dir/$skill_name/"
      if [[ -f "$skills_dir/$skill_name/SKILL.md" ]]; then
        print_notes "   ✅ installed skill: $skill_name <- $repo"
      else
        print_notes "   ⚠️  no SKILL.md after install: $skill_name (broken skill?)"
      fi
    else
      print_notes "   ⚠️  skill not found upstream: $name"
    fi
  done
  rm -rf "$tmp"

  print_info2 "✅ SKILLS :: skills ready."
}

