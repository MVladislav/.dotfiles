# SETUP :: filebrowser -----------------------------------------------------------
# NOTE: runs inside 'install_filebrowser'
setup_filebrowser() {
  print_section "FILEBROWSER :: config"
  print_info2 "🔗 FILEBROWSER :: config dir at $LN_FILEBROWSER (config.yaml + filebrowser.db)"
  mkdir -p "$LN_FILEBROWSER"
  mkdir -p "$FILEBROWSER_ROOT"

  local config_file="$LN_FILEBROWSER/config.yaml"
  local db_file="$LN_FILEBROWSER/filebrowser.db"

  if [[ ! -f "$config_file" ]]; then
    sed -e "s|@FILEBROWSER_DB@|$db_file|g" \
        -e "s|@FILEBROWSER_CACHE@|$LN_FILEBROWSER/tmp|g" \
        -e "s|@FILEBROWSER_ROOT@|$FILEBROWSER_ROOT|g" \
        "${PWD}/configs-single/filebrowser.yml" > "$config_file"
    print_notes "   📝 wrote $config_file from configs-single/filebrowser.yml (root: $FILEBROWSER_ROOT, port 8080)"
  else
    print_notes "   ⏭️  config exists, keeping it (edit $config_file to change port/root)"
  fi

  # first run: create DB + admin (full access) + readonly (read-only, scoped to
  # root). The binary logs to stderr — capture it, show errors only on failure.
  local out
  if [[ -f "$db_file" ]]; then
    print_notes "   ⏭️  database exists — users kept as-is (passwords: filebrowser set -u <user>,<pass> [-a] -c $config_file)"
  elif [[ ! -x "$USER_LOCAL_PREFIX_BIN/filebrowser" ]]; then
    print_notes "   ⚠️  filebrowser binary not found — run '$0 -ifb' first to create the users"
  else
    if out=$("$USER_LOCAL_PREFIX_BIN/filebrowser" set -u admin,admin -a -c "$config_file" 2>&1); then
      print_notes "   ✅ admin user created (default password: admin)"
    else
      print_notes "   ⚠️  could not create admin user: $(echo "$out" | tail -1)"
    fi
    if out=$("$USER_LOCAL_PREFIX_BIN/filebrowser" set -u readonly,readonly -c "$config_file" 2>&1); then
      print_notes "   ✅ readonly user created (default password: readonly)"
    else
      print_notes "   ⚠️  could not create readonly user: $(echo "$out" | tail -1)"
    fi
    print_notes "   ⚠️  DEFAULT PASSWORDS: admin/admin and readonly/readonly — change them with:"
    print_notes "       $USER_LOCAL_PREFIX_BIN/filebrowser set -u admin,<newpass> -a -c $config_file"
    print_notes "       $USER_LOCAL_PREFIX_BIN/filebrowser set -u readonly,<newpass> -c $config_file"
  fi

  print_notes "   🚀 start the server: $USER_LOCAL_PREFIX_BIN/filebrowser -c $config_file"
  print_notes "   🌐 browse: http://localhost:8080 (admin = full access | readonly = read-only, only $FILEBROWSER_ROOT)"
  print_notes "   🔒 per-user access control: manage users/sources in the UI, or 'filebrowser set rule'"
  print_notes "   ℹ️  no systemd unit / firewall rules created — run it manually or set up your own service"
  print_section_end "✅ FILEBROWSER :: config ready."
}

