# SETUP :: filebrowser -----------------------------------------------------------
# NOTE: runs inside 'install_filebrowser'
setup_filebrowser() {
  print_section "FILEBROWSER :: config"
  print_info2 "🔗 FILEBROWSER :: config dir at $LN_FILEBROWSER (config.yaml + filebrowser.db)"
  mkdir -p "$LN_FILEBROWSER"
  mkdir -p "$FILEBROWSER_ROOT"

  local config_file="$LN_FILEBROWSER/config.yaml"
  local db_file="$LN_FILEBROWSER/filebrowser.db"

  if [[ ! -f "$config_file" ]]; then
    sed -e "s|@FILEBROWSER_DB@|$db_file|g" \
        -e "s|@FILEBROWSER_CACHE@|$LN_FILEBROWSER/tmp|g" \
        -e "s|@FILEBROWSER_ROOT@|$FILEBROWSER_ROOT|g" \
        "${PWD}/configs-single/filebrowser.yml" > "$config_file"
    print_notes "   📝 wrote $config_file from configs-single/filebrowser.yml (root: $FILEBROWSER_ROOT, port 8080)"
  else
    print_notes "   ⏭️  config exists, keeping it (edit $config_file to change port/root)"
  fi

  # first run: create DB + admin (full access) + readonly (read-only, scoped to
  # root). The binary logs to stderr - capture it, show errors only on failure.
  local out
  if [[ -f "$db_file" ]]; then
    print_notes "   ⏭️  database exists - users kept as-is (passwords: filebrowser set -u <user>,<pass> [-a] -c $config_file)"
  elif [[ ! -x "$USER_LOCAL_PREFIX_BIN/filebrowser" ]]; then
    print_notes "   ⚠️  filebrowser binary not found - run '$0 -ifb' first to create the users"
  else
    if out=$("$USER_LOCAL_PREFIX_BIN/filebrowser" set -u admin,admin -a -c "$config_file" 2>&1); then
      print_notes "   ✅ admin user created (default password: admin)"
    else
      print_notes "   ⚠️  could not create admin user: $(echo "$out" | tail -1)"
    fi
    if out=$("$USER_LOCAL_PREFIX_BIN/filebrowser" set -u readonly,readonly -c "$config_file" 2>&1); then
      print_notes "   ✅ readonly user created (default password: readonly)"
    else
      print_notes "   ⚠️  could not create readonly user: $(echo "$out" | tail -1)"
    fi
    print_notes "   ⚠️  DEFAULT PASSWORDS: admin/admin and readonly/readonly - change them with:"
    print_notes "       $USER_LOCAL_PREFIX_BIN/filebrowser set -u admin,<newpass> -a -c $config_file"
    print_notes "       $USER_LOCAL_PREFIX_BIN/filebrowser set -u readonly,<newpass> -c $config_file"
  fi

  print_notes "   🚀 start the server: $USER_LOCAL_PREFIX_BIN/filebrowser -c $config_file"
  print_notes "   🌐 browse: http://localhost:8080 (admin = full access | readonly = read-only, only $FILEBROWSER_ROOT)"
  print_notes "   🔒 per-user access control: manage users/sources in the UI, or 'filebrowser set rule'"
  print_notes "   ℹ️  no systemd unit / firewall rules created - run it manually or set up your own service"
  print_section_end "✅ FILEBROWSER :: config ready."
}

# HELPERS :: split a model catalog line into the LLAMACPP_M_* globals ------------
# Takes the line verbatim (no pipe subshell, so the globals survive).
llamacpp_parse_model() {
  IFS='|' read -r LLAMACPP_M_ID LLAMACPP_M_DISPLAY LLAMACPP_M_REPO LLAMACPP_M_QUANT \
    LLAMACPP_M_SIZE_GIB LLAMACPP_M_KV_KIB LLAMACPP_M_CTX_MAX LLAMACPP_M_REASONING \
    LLAMACPP_M_TIER <<<"$1"
}

# HELPERS :: memory / disk facts used to size and gate the model choice ---------
llamacpp_mem_available_mib() {
  local kb
  kb=$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo 2>/dev/null) || true
  [[ -n "$kb" ]] && echo $((kb / 1024)) || echo 8192
}

llamacpp_mem_total_mib() {
  local kb
  kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null) || true
  [[ -n "$kb" ]] && echo $((kb / 1024)) || echo 8192
}

llamacpp_disk_free_gib() {
  local cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
  df -BG --output=avail "$cache_home" 2>/dev/null | tail -n1 | tr -dc '0-9' || echo 0
}

# HELPERS :: "6.26" (GiB) -> integer MiB ------------------------------------------
# Catalog sizes are decimal strings, which bash arithmetic cannot evaluate
# directly, so every comparison goes through this first.
llamacpp_gib_to_mib() {
  local gib="$1" whole frac=0
  whole="${gib%%.*}"
  [[ "$gib" == *.* ]] && frac="${gib#*.}"
  echo $((10#${whole:-0} * 1024 + 10#${frac:-0} * 1024 / 100))
}

# HELPERS :: MiB -> human "12.3 GiB" ---------------------------------------------
llamacpp_human_mib() {
  local mib="$1"
  if ((mib >= 10240)); then
    printf '%s GiB' "$(awk -v m="$mib" 'BEGIN{printf "%.1f", m/1024}')"
  elif ((mib >= 1024)); then
    printf '%s GiB' "$(awk -v m="$mib" 'BEGIN{printf "%.2f", m/1024}')"
  else
    printf '%s MiB' "$mib"
  fi
}

# HELPERS :: KV cache bytes-per-element as a percentage of f16 --------------------
llamacpp_kv_pct() {
  case "$1" in
  q8_0) echo "$LLAMACPP_KV_PCT_Q8_0" ;;
  q5_1) echo "$LLAMACPP_KV_PCT_Q5_1" ;;
  q4_0) echo "$LLAMACPP_KV_PCT_Q4_0" ;;
  *) echo "$LLAMACPP_KV_PCT_F16" ;;
  esac
}

# HELPERS :: KV cache size in MiB for a context window ---------------------------
llamacpp_kv_mib() { # kv_kib ctx kv_type
  echo $(( $1 * $2 * $(llamacpp_kv_pct "$3") / 100 / 1024 ))
}

# HELPERS :: largest ctx that still fits, given weights + a KV type ---------------
llamacpp_max_ctx_for_ram() { # model_mib kv_kib kv_type
  local budget_mib=$(( $(llamacpp_mem_available_mib) - $1 - LLAMACPP_COMPUTE_RESERVE_MIB ))
  ((budget_mib <= 0)) && {
    echo 0
    return 0
  }
  # budget MiB -> KiB, divide by per-token KiB scaled by the kv type
  echo $((budget_mib * 1024 * 100 / ($2 * $(llamacpp_kv_pct "$3"))))
}

# SETUP :: llama.cpp ------------------------------------------------------------
# Picks a model and a KV/ctx memory profile, then writes the server env file,
# installs the systemd --user unit and regenerates the opencode provider.
setup_llamacpp() {
  print_section "LLAMACPP :: config"
  local llama_bin="$USER_LOCAL_PREFIX_BIN/llama-server"
  if [[ ! -x "$llama_bin" ]]; then
    print_notes "   ⚠️  llama-server not found - run '$0 -ill' first"
    print_section_end "⚠️  LLAMACPP :: skipped."
    return 0
  fi
  print_notes "   🔗 LLAMACPP :: server $(llamacpp_binary_version)"

  local mem_avail mem_total disk_free
  mem_avail=$(llamacpp_mem_available_mib)
  mem_total=$(llamacpp_mem_total_mib)
  disk_free=$(llamacpp_disk_free_gib)
  print_notes "   💡 RAM $(llamacpp_human_mib "$mem_avail") free / $(llamacpp_human_mib "$mem_total") total | disk ${disk_free}G free | $(nproc) cpus | cpu: $(llamacpp_cpu_simd)"
  # No AVX means scalar kernels. Say so before the user reads the token rate as
  # a broken configuration.
  case "$(llamacpp_cpu_simd)" in
  *avx* | *fma*) ;;
  *)
    print_notes "      no AVX/FMA detected - ggml uses scalar kernels, expect a few tokens/s"
    print_notes "      (check with 'llama-bench -hf <repo>:<quant>')"
    ;;
  esac

  # -- model + weight quantisation ----------------------------------------------
  local idx
  idx=$(llamacpp_select_model) || idx=""
  if [[ -z "$idx" ]]; then
    print_notes "   ⚠️  no model selected - skipping llama.cpp config"
    print_section_end "⚠️  LLAMACPP :: skipped."
    return 0
  fi
  llamacpp_parse_model "${LLAMACPP_MODELS[$idx]}"
  local model_id="$LLAMACPP_M_ID" model_mib model_reasoning=false
  model_mib=$(llamacpp_gib_to_mib "$LLAMACPP_M_SIZE_GIB")
  [[ "$LLAMACPP_M_REASONING" == "1" ]] && model_reasoning=true

  print_notes "   📦 ${LLAMACPP_M_DISPLAY} [${LLAMACPP_M_TIER}, ${LLAMACPP_M_SIZE_GIB} GiB]"

  # -- KV cache / context profile -----------------------------------------------
  # Two coupled knobs: the KV type trades quality for room, ctx consumes that
  # room. Offer the whole grid with the resulting footprint spelled out.
  local kv_type ctx
  kv_type=$(llamacpp_select_kv_type "$model_mib" "$LLAMACPP_M_KV_KIB")
  ctx=$(llamacpp_select_ctx "$model_mib" "$LLAMACPP_M_KV_KIB" "$kv_type" "$LLAMACPP_M_CTX_MAX")
  [[ -z "$kv_type" || -z "$ctx" ]] && {
    print_notes "   ⚠️  no KV profile selected - keeping defaults"
    kv_type="$LLAMACPP_KV_DEFAULT"
    ctx="$LLAMACPP_CTX_DEFAULT"
  }

  local kv_mib total_mib
  kv_mib=$(llamacpp_kv_mib "$LLAMACPP_M_KV_KIB" "$ctx" "$kv_type")
  total_mib=$((model_mib + kv_mib + LLAMACPP_COMPUTE_RESERVE_MIB))
  print_notes "   🧠 KV ${kv_type} @ ${ctx} ctx = $(llamacpp_human_mib "$kv_mib") | footprint ≈ $(llamacpp_human_mib "$total_mib") (weights $(llamacpp_human_mib "$model_mib") + KV + $(llamacpp_human_mib "$LLAMACPP_COMPUTE_RESERVE_MIB") buffers)"
  if ((total_mib > mem_avail)); then
    print_notes "   ⚠️  that is $(llamacpp_human_mib $((total_mib - mem_avail))) more than RAM has free - expect swapping or OOM"
  fi

  # -- reasoning history ---------------------------------------------------------
  LLAMACPP_REASONING_PRESERVE=$(llamacpp_select_reasoning_preserve)
  print_notes "   💭 reasoning history :: $([[ "$LLAMACPP_REASONING_PRESERVE" == "1" ]] && echo "kept" || echo "dropped after each turn")"

  # -- prediction ----------------------------------------------------------------
  local spec_type="$LLAMACPP_SPEC_TYPE" spec_draft="$LLAMACPP_SPEC_DRAFT"
  spec_type=$(llamacpp_select_spec "$spec_type" "$spec_draft") || spec_type="none"
  [[ "$spec_type" == "draft-"* && -z "$spec_draft" ]] && spec_type="none"

  # -- who may reach the API -----------------------------------------------------
  local bind
  bind=$(llamacpp_select_bind)
  LLAMACPP_BIND="$bind"
  local bind_scope
  bind_scope=$(llamacpp_ip_scope "$bind")
  print_notes "   🌐 bind :: $bind ($bind_scope)"

  # Exposing without a key means anything routable can spend this host's RAM.
  if [[ "$bind_scope" != "private" && "$LLAMACPP_API_KEY" != "1" ]]; then
    print_error "   ⚠️  binding $bind without LLAMACPP_API_KEY=1 - set it to 1 in ai/setup-ai-llamacpp.conf"
  fi

  llamacpp_write_config "$idx" "$kv_type" "$ctx" "$spec_type" "$spec_draft"
  llamacpp_install_service "$llama_bin"

  # -- opencode provider ---------------------------------------------------------
  llamacpp_generate_opencode_provider "$idx" "$kv_type" "$ctx" "$model_reasoning"
  print_notes "   🔗 LLAMACPP :: opencode provider regenerated for '$model_id'"

  print_notes "   🔍 verify: curl http://$(llamacpp_client_host):${LLAMACPP_PORT}/v1/models"
  print_notes "   📄 config: $LLAMACPP_ENV_FILE"
  print_notes "   🔄 restart: systemctl --user restart $LLAMACPP_UNIT_NAME"
  print_notes "   🧠 re-plan: $0 -sll"

  # -- how to reach it -----------------------------------------------------------
  # Model id as clients see it: in router mode that is the preset section name,
  # which is suffixed with the quant when a model has several weight tiers.
  llamacpp_parse_model "${LLAMACPP_MODELS[$idx]}"
  local example_id="$LLAMACPP_M_ID"
  if [[ "$LLAMACPP_ROUTER" == "1" ]]; then
    local same=0 j
    for j in "${!LLAMACPP_MODELS[@]}"; do
      [[ "${LLAMACPP_MODELS[$j]%%|*}" == "$LLAMACPP_M_ID" ]] && same=$((same + 1))
    done
    ((same > 1)) && example_id="${LLAMACPP_M_ID}@${LLAMACPP_M_QUANT}"
  fi

  print_notes ""
  print_notes "   ▶️ try it:"
  if [[ "$LLAMACPP_API_KEY" == "1" ]]; then
    print_notes "      export LLAMACPP_API_KEY=\$(grep -vE '^[[:space:]]*(#|$)' '$LLAMACPP_API_KEY_FILE' | head -n1)"
    # one print so the colour reset does not land on a line-continuation backslash
    print_notes "      curl -s http://$(llamacpp_client_host):${LLAMACPP_PORT}/v1/chat/completions \\
        -H \"Authorization: Bearer \$LLAMACPP_API_KEY\" -H 'Content-Type: application/json' \\
        -d '{\"model\":\"$example_id\",\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}'"
  else
    print_notes "      curl -s http://$(llamacpp_client_host):${LLAMACPP_PORT}/v1/chat/completions \\
        -H 'Content-Type: application/json' \\
        -d '{\"model\":\"$example_id\",\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}'"
  fi
  print_notes "      add '| jq -r .choices[0].message.content' to read just the reply, or"
  print_notes "      '.timings.predicted_per_second' for the generation rate"

  if [[ "$LLAMACPP_API_KEY" == "1" ]]; then
    print_notes "   🔑 auth: on. Rotate by deleting $LLAMACPP_API_KEY_FILE and re-running $0 -sll"
  fi
  if [[ "$bind_scope" == "private" ]]; then
    print_notes "   🌐 reachable from $bind_scope addresses, e.g. http://$bind:${LLAMACPP_PORT}/v1"
    print_notes "   🔒 change it any time with $0 -sll"
  else
    print_notes "   🌐 bound to $bind - everything routable can reach the API"
  fi
  print_section_end "✅ LLAMACPP :: config ready."
}

# SETUP :: llama.cpp model picker -------------------------------------------------
# fzf list is "<idx>|<label>"; only the index is parsed back. Returns the index
# into LLAMACPP_MODELS. Weight quantisation is part of the choice (3/4/6/8-bit).
llamacpp_select_model() {
  if [[ ${#LLAMACPP_MODELS[@]} -eq 0 ]]; then
    print_notes "   ⏭️  no models in ai/setup-ai-llamacpp.conf - skipping"
    return 0
  fi

  local mem_avail disk_free disk_mib
  mem_avail=$(llamacpp_mem_available_mib)
  disk_free=$(llamacpp_disk_free_gib)
  disk_mib=$((disk_free * 1024))

  local preview_dir fzf_list entry label size_mib fit kv_max i
  preview_dir=$(mktemp -d)
  fzf_list=""
  for i in "${!LLAMACPP_MODELS[@]}"; do
    entry="${LLAMACPP_MODELS[$i]}"
    llamacpp_parse_model "$entry"
    size_mib=$(llamacpp_gib_to_mib "$LLAMACPP_M_SIZE_GIB")
    kv_max=$(llamacpp_max_ctx_for_ram "$size_mib" "$LLAMACPP_M_KV_KIB" "$LLAMACPP_KV_DEFAULT")
    if ((size_mib > disk_mib)); then
      fit="no disk space"
    elif ((size_mib + LLAMACPP_COMPUTE_RESERVE_MIB + LLAMACPP_RAM_FLOOR_MIB > mem_avail)); then
      fit="tight RAM"
    else
      fit="fits"
    fi
    label="$LLAMACPP_M_DISPLAY [$LLAMACPP_M_TIER]"
    {
      echo "model      : $LLAMACPP_M_DISPLAY"
      echo "model id   : $LLAMACPP_M_ID"
      echo "weights    : $LLAMACPP_M_SIZE_GIB GiB ($LLAMACPP_M_TIER)"
      echo "hf repo    : https://huggingface.co/${LLAMACPP_M_REPO}:${LLAMACPP_M_QUANT}"
      echo "disk free  : ${disk_free} GiB"
      echo "ram free   : $(llamacpp_human_mib "$mem_avail")"
      echo "kv cache   : ${LLAMACPP_M_KV_KIB} KiB/token (f16); fits ~${kv_max} ctx in free RAM"
      echo "reasoning  : $([[ "$LLAMACPP_M_REASONING" == "1" ]] && echo yes || echo no)"
      echo "fit        : $fit"
    } >"$preview_dir/$i.info"
    fzf_list+="$i | $label | ${LLAMACPP_M_SIZE_GIB}G | $fit"$'\n'
  done

  # pre-select the configured default: the first tier matching its id
  local defaults="" entry_id
  for i in "${!LLAMACPP_MODELS[@]}"; do
    entry="${LLAMACPP_MODELS[$i]}"
    entry_id="${entry%%|*}"
    [[ "$entry_id" == "$LLAMACPP_MODELS_DEFAULT" ]] && {
      defaults="$i"
      break
    }
  done
  local default_line=""
  [[ -n "$defaults" ]] && default_line="$defaults | $(echo "$fzf_list" | awk -F'|' -v i="$defaults" '$1==i{print $2}' | sed 's/^ *//')"

  local selections
  selections=$(fzf_pick "$fzf_list" "$default_line" \
    'TAB: toggle, ENTER: confirm - weights = quantisation tier, lower bits = smaller/faster' \
    'Select model + weight quantisation: ' \
    "cat '$preview_dir'/$(echo {} | cut -d'|' -f1 | tr -d ' ').info 2>/dev/null")
  rm -rf "$preview_dir"
  [[ -z "$selections" ]] && return 0
  echo "$selections" | head -n1 | cut -d'|' -f1 | tr -d ' '
}

# SETUP :: reasoning preservation picker ------------------------------------------
# llama.cpp keeps the model's thinking in the history by default. That is useful
# for long "reason then refine" chats and wasteful for everything else, since the
# trace is resent every turn and crowds out a small context window.
llamacpp_select_reasoning_preserve() {
  local list="0 | off - history holds the answer only (default)
1 | on  - thinking stays in the history, costs context each turn"
  llamacpp_pick_one "$list" "$LLAMACPP_REASONING_PRESERVE" \
    'keep traces when you refine an answer across several turns' \
    'Keep reasoning traces in the conversation history? '
}

# HELPERS :: one-shot fzf choice over "value | label" lines ----------------------
# Echoes the value (first field) of the chosen line. Falls back to $2 both when
# fzf is missing and when the user aborts, so a cancelled prompt never discards
# an earlier choice. Args: list, default value, header, prompt.
llamacpp_pick_one() {
  local list="$1" default="$2" header="$3" prompt="$4" sel=""
  if command -v fzf >/dev/null 2>&1; then
    sel=$(fzf_pick "$list" "$default" "$header" "$prompt")
  fi
  if [[ -z "$sel" ]]; then
    echo "$default"
    return 0
  fi
  echo "$sel" | head -n1 | cut -d'|' -f1 | tr -d ' '
}

# SETUP :: KV cache type picker ---------------------------------------------------
llamacpp_select_kv_type() {
  local model_mib="$1" kv_kib="$2"
  local kv list kv_max kv_mib
  list=""
  for kv in $LLAMACPP_KV_TYPES; do
    kv_max=$(llamacpp_max_ctx_for_ram "$model_mib" "$kv_kib" "$kv")
    kv_mib=$(llamacpp_kv_mib "$kv_kib" "$LLAMACPP_CTX_DEFAULT" "$kv")
    list+="$kv | $(llamacpp_kv_pct "$kv")% of f16 | $(llamacpp_human_mib "$kv_mib") @ ${LLAMACPP_CTX_DEFAULT} ctx | max ~${kv_max} ctx"$'\n'
  done
  llamacpp_pick_one "$list" "$LLAMACPP_KV_DEFAULT" \
    'q8_0 = half the RAM of f16, effectively lossless' \
    'Select KV cache type: '
}

# SETUP :: context window picker --------------------------------------------------
llamacpp_select_ctx() {
  local model_mib="$1" kv_kib="$2" kv_type="$3" ctx_max="$4"
  local mem_avail ctx list kv_mib total fits best
  mem_avail=$(llamacpp_mem_available_mib)
  list=""
  best=""
  for ctx in $LLAMACPP_CTX_CHOICES; do
    # never offer more than the model itself supports
    ((ctx > ctx_max)) && continue
    kv_mib=$(llamacpp_kv_mib "$kv_kib" "$ctx" "$kv_type")
    total=$((model_mib + kv_mib + LLAMACPP_COMPUTE_RESERVE_MIB))
    if ((total <= mem_avail - LLAMACPP_RAM_FLOOR_MIB)); then
      fits="OK"
    elif ((total <= mem_avail)); then
      fits="tight"
    else
      fits="won't fit"
    fi
    list+="$ctx | KV $(llamacpp_human_mib "$kv_mib") | total $(llamacpp_human_mib "$total") | $fits"$'\n'
    # remember the largest offered ctx so it can be the fallback
    best="$ctx"
  done
  [[ -z "$list" ]] && {
    echo "$ctx_max"
    return 0
  }
  local defaults="$LLAMACPP_CTX_DEFAULT"
  ((defaults > ctx_max || defaults > best)) && defaults="$best"
  llamacpp_pick_one "$list" "$defaults" \
    'total = weights + KV + compute buffers; compared against free RAM' \
    'Select context window (tokens): '
}

# SETUP :: speculative decoding picker -------------------------------------------
llamacpp_select_spec() {
  local cur="$1" draft="$2"
  local list="none | off"
  [[ "$cur" != "none" ]] && list+=$'\n'"$cur | enabled"
  list+=$'\n'"ngram-simple | free speedup, reuses patterns from this conversation"
  [[ -n "$draft" ]] && list+=$'\n'"draft-simple | small draft model ($draft)"
  llamacpp_pick_one "$list" "$cur" \
    'speculative decoding speeds generation, not prompt processing' \
    'Enable prediction (speculative decoding)? '
}

# HELPERS :: write env file (+ router preset when enabled) ------------------------
llamacpp_write_config() {
  local idx="$1" kv_type="$2" ctx="$3" spec_type="$4" spec_draft="$5"
  mkdir -p "$LLAMACPP_CONFIG_DIR"
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/llama.cpp"
  mkdir -p "$cache_dir"

  local bind
  bind=$(llamacpp_bind_host)
  local -a common_env=(
    "LLAMA_CACHE=$cache_dir"
    "LLAMA_ARG_HOST=$bind"
    "LLAMA_ARG_PORT=$LLAMACPP_PORT"
    "LLAMA_ARG_THREADS=$(nproc)"
    "LLAMA_ARG_UI=$LLAMACPP_UI"
    "LLAMA_ARG_MMPROJ_AUTO=$LLAMACPP_MMPROJ"
    "LLAMA_ARG_ENDPOINT_METRICS=$LLAMACPP_METRICS"
    # Derived from the bind address; silences llama.cpp's "no API key is set
    # and CORS allows all origins" warning and keeps the API unreadable from
    # unrelated pages.
    "LLAMA_ARG_CORS_ORIGINS=$(llamacpp_cors_origins)"
  )
  # GPU options only when this build actually has a GPU backend; otherwise
  # llama-server logs four "will be ignored" warnings on every start.
  if llamacpp_gpu_available; then
    common_env+=(
      "LLAMA_ARG_N_GPU_LAYERS=$LLAMACPP_NGL"
      "LLAMA_ARG_SPLIT_MODE=$LLAMACPP_SPLIT_MODE"
    )
    [[ -n "$LLAMACPP_TENSOR_SPLIT" ]] && common_env+=("LLAMA_ARG_TENSOR_SPLIT=$LLAMACPP_TENSOR_SPLIT")
  fi

  llamacpp_parse_model "${LLAMACPP_MODELS[$idx]}"
  local env_body="" line mode="single model"

  # Auth: a key file is referenced, never the key itself, so the secret lives in
  # exactly one chmod-600 file instead of being duplicated into the env file.
  if [[ "$LLAMACPP_API_KEY" == "1" ]]; then
    llamacpp_ensure_api_key >/dev/null
    common_env+=("LLAMA_ARG_API_KEY_FILE=$LLAMACPP_API_KEY_FILE")
  fi

  # -- single-model (classic) mode ---
  if [[ "$LLAMACPP_ROUTER" != "1" ]]; then
    # No preset here, so these must come from the environment.
    common_env+=(
      "LLAMA_ARG_CTX_SIZE=$ctx"
      "LLAMA_ARG_N_PARALLEL=$LLAMACPP_N_PARALLEL"
      "LLAMA_ARG_CACHE_TYPE_K=$kv_type"
      "LLAMA_ARG_CACHE_TYPE_V=$kv_type"
      "LLAMA_ARG_REASONING_PRESERVE=$LLAMACPP_REASONING_PRESERVE"
      "LLAMA_ARG_HF_REPO=${LLAMACPP_M_REPO}:${LLAMACPP_M_QUANT}"
      "LLAMA_ARG_ALIAS=${LLAMACPP_M_ID}"
    )
    if [[ "$spec_type" != "none" ]]; then
      common_env+=("LLAMA_ARG_SPEC_TYPE=$spec_type" "LLAMA_ARG_SPEC_DRAFT_N_MAX=$LLAMACPP_SPEC_N_MAX")
      [[ -n "$spec_draft" && "$spec_type" == draft-* ]] &&
        common_env+=("LLAMA_ARG_SPEC_DRAFT_HF_REPO=$spec_draft")
    fi
  else
    mode="router (all catalog models, load on demand)"
    # ctx / KV / parallel deliberately stay OUT of the environment here: the
    # router passes them to each child as CLI args taken from the preset [*]
    # block, and having both makes every child log "env var is set, but will be
    # overwritten". HOST and PORT are the exception - the router binds them
    # itself and has to be told where to listen.
    llamacpp_write_preset "$ctx" "$kv_type" "$spec_type"
    common_env+=(
      "LLAMA_ARG_MODELS_PRESET=$LLAMACPP_PRESET_FILE"
      "LLAMA_ARG_MODELS_MAX=$LLAMACPP_MODELS_MAX"
      "LLAMA_ARG_MODELS_AUTOLOAD=$LLAMACPP_MODELS_AUTOLOAD"
    )
  fi

  for line in "${common_env[@]}"; do
    env_body+="$line"$'\n'
  done

  if [[ -f "$LLAMACPP_ENV_FILE" ]]; then
    cp "$LLAMACPP_ENV_FILE" "$LLAMACPP_ENV_FILE.$(date '+%Y%m%d-%H%M%S').bak"
    # the env file names the secret key file, so backups get the same mode
    chmod 600 "$LLAMACPP_ENV_FILE".*.bak 2>/dev/null
    print_notes "   💾 backed up previous env file"
  fi

  {
    echo "# llama.cpp server :: generated by setup-ai -sll on $(date '+%Y-%m-%d %H:%M:%S')"
    echo "# Regenerate: setup-ai -sll   Apply: systemctl --user restart $LLAMACPP_UNIT_NAME"
    echo "#"
    echo "# MODE    : $mode"
    echo "# KV      : $kv_type @ ${ctx} ctx"
    echo "# PREDICT : $spec_type"
    echo "#"
    echo "$env_body"
  } >"$LLAMACPP_ENV_FILE"
  chmod 600 "$LLAMACPP_ENV_FILE"
  print_notes "   📝 wrote $LLAMACPP_ENV_FILE"
}

# HELPERS :: router preset --------------------------------------------------------
# In router mode the model id clients use is the INI section name, so each
# catalog line becomes one section keyed by a stable id (id@quant when a model
# has several weight tiers, so the client can pick the quant too).
llamacpp_write_preset() {
  local ctx="$1" kv_type="$2" spec_type="$3"
  local i entry id quant tier model_line
  {
    echo "version = 1"
    echo ""
    echo "; shared defaults applied to every model"
    echo "[*]"
    echo "ctx-size = $ctx"
    echo "cache-type-k = $kv_type"
    echo "cache-type-v = $kv_type"
    echo "parallel = $LLAMACPP_N_PARALLEL"
    echo "reasoning-preserve = $LLAMACPP_REASONING_PRESERVE"
    if llamacpp_gpu_available; then
      echo "n-gpu-layers = $LLAMACPP_NGL"
      echo "split-mode = $LLAMACPP_SPLIT_MODE"
    fi
    echo "jinja = true"
    [[ "$spec_type" != "none" ]] && echo "spec-type = $spec_type"
    [[ "$spec_type" != "none" ]] && echo "spec-draft-n-max = $LLAMACPP_SPEC_N_MAX"
    echo ""
    for i in "${!LLAMACPP_MODELS[@]}"; do
      entry="${LLAMACPP_MODELS[$i]}"
      llamacpp_parse_model "$entry"
      id="$LLAMACPP_M_ID"
      quant="$LLAMACPP_M_QUANT"
      tier="$LLAMACPP_M_TIER"
      # multiple tiers for the same id -> qualify the model name with the quant
      local same=0 j
      for j in "${!LLAMACPP_MODELS[@]}"; do
        [[ "${LLAMACPP_MODELS[$j]%%|*}" == "$id" ]] && same=$((same + 1))
      done
      ((same > 1)) && id="${id}@${quant}"
      model_line="$LLAMACPP_M_REPO:$quant"
      echo "[$id]"
      echo "; $LLAMACPP_M_DISPLAY [$tier] $(llamacpp_human_mib "$(llamacpp_gib_to_mib "$LLAMACPP_M_SIZE_GIB")")"
      echo "hf-repo = $model_line"
      # Never preload: with MODELS_MAX small, loading every model at boot would
      # blow the memory budget. Models appear on first use (autoload).
      echo "load-on-startup = false"
      # per-model ctx ceiling: the global value can exceed a small model's limit
      if [[ "$ctx" -gt "$LLAMACPP_M_CTX_MAX" ]]; then
        echo "ctx-size = $LLAMACPP_M_CTX_MAX"
      fi
      echo ""
    done
  } >"$LLAMACPP_PRESET_FILE"
  print_notes "   📝 wrote $LLAMACPP_PRESET_FILE"
}

# HELPERS :: install / enable the systemd --user unit -----------------------------
llamacpp_install_service() {
  local llama_bin="$1"
  if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user is-system-running >/dev/null 2>&1; then
    print_notes "   ⚠️  systemd --user unavailable - start manually:"
    print_notes "       set -a; source $LLAMACPP_ENV_FILE; set +a; $llama_bin"
    return 0
  fi

  create_symlink "${PWD}/configs-single/llamacpp.service" "$UNIT_LLAMACPP"
  print_notes "   🔗 LLAMACPP :: linked configs-single/llamacpp.service -> $UNIT_LLAMACPP"

  # A --user unit only starts at boot when lingering is enabled.
  if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]]; then
    if loginctl enable-linger "$USER" 2>/dev/null; then
      print_notes "   🔗 LLAMACPP :: enabled lingering (starts at boot)"
    else
      print_notes "   ⚠️  could not enable lingering - enable it manually or start by hand"
    fi
  fi

  systemctl --user daemon-reload
  if systemctl --user enable "$LLAMACPP_UNIT_NAME" >/dev/null 2>&1; then
    print_notes "   🔗 LLAMACPP :: enabled $LLAMACPP_UNIT_NAME"
  else
    print_notes "   ⚠️  could not enable $LLAMACPP_UNIT_NAME"
  fi

  # First start downloads the model; only auto-restart once something is cached.
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/llama.cpp"
  if [[ -n "$(find "$cache_dir" -name '*.gguf' -print -quit 2>/dev/null)" ]]; then
    if systemctl --user restart "$LLAMACPP_UNIT_NAME"; then
      print_notes "   🚀 LLAMACPP :: restarted $LLAMACPP_UNIT_NAME"
    else
      print_notes "   ⚠️  start failed - check: journalctl --user -u $LLAMACPP_UNIT_NAME -n 30"
    fi
  else
    print_notes "   ⏸️  not started yet - first start downloads the model into $cache_dir"
    print_notes "   🚀 start with: systemctl --user start $LLAMACPP_UNIT_NAME"
  fi
}

# HELPERS :: build the opencode provider block -----------------------------------
# Router mode exposes every catalog model (ids match the preset section names);
# classic mode exposes just the selected one. baseURL and limit.context always
# come from the same values written into the server env file, so they cannot
# drift apart.
llamacpp_generate_opencode_provider() {
  local idx="$1" kv_type="$2" ctx="$3" reasoning="$4"
  local base
  base="http://$(llamacpp_client_host):${LLAMACPP_PORT}/v1"
  # API keys MUST be env-var references in opencode config, never literal values.
  local auth=""
  [[ "$LLAMACPP_API_KEY" == "1" ]] && auth='{"apiKey":"{env:LLAMACPP_API_KEY}"}'

  if [[ "$LLAMACPP_ROUTER" != "1" ]]; then
    llamacpp_parse_model "${LLAMACPP_MODELS[$idx]}"
    # shellcheck disable=SC2034
    OPENCODE_CONFIG_PROVIDER_LLAMACPP=$(jq -nc \
      --arg id "$LLAMACPP_M_ID" --arg name "$LLAMACPP_M_DISPLAY [$LLAMACPP_M_TIER]" \
      --argjson reasoning "$reasoning" --argjson ctx "$ctx" --arg url "$base" \
      --argjson auth "$auth" \
      '{"llama.cpp":{"npm":"@ai-sdk/openai-compatible","name":"llama-server (local)",
        "options":({baseURL:$url} + $auth),
        "models":{($id):{"name":$name,"reasoning":$reasoning,
          "limit":{"context":$ctx,"output":$ctx}}}}}')
    return 0
  fi

  # router: every catalog model is addressable; id mirrors the preset section
  local models="{}" i entry id quant same j
  for i in "${!LLAMACPP_MODELS[@]}"; do
    entry="${LLAMACPP_MODELS[$i]}"
    llamacpp_parse_model "$entry"
    id="$LLAMACPP_M_ID"
    quant="$LLAMACPP_M_QUANT"
    same=0
    for j in "${!LLAMACPP_MODELS[@]}"; do
      [[ "${LLAMACPP_MODELS[$j]%%|*}" == "$id" ]] && same=$((same + 1))
    done
    ((same > 1)) && id="${id}@${quant}"
    local r=false
    [[ "$LLAMACPP_M_REASONING" == "1" ]] && r=true
    models=$(jq -nc \
      --argjson acc "$models" --arg id "$id" \
      --arg name "$LLAMACPP_M_DISPLAY [$LLAMACPP_M_TIER]" \
      --argjson reasoning "$r" --argjson ctx "$ctx" \
      '$acc + {($id):{"name":$name,"reasoning":$reasoning,"limit":{"context":$ctx,"output":$ctx}}}')
  done
  # shellcheck disable=SC2034
  OPENCODE_CONFIG_PROVIDER_LLAMACPP=$(jq -nc \
    --argjson models "$models" --arg url "$base" \
    '{"llama.cpp":{"npm":"@ai-sdk/openai-compatible","name":"llama-server (local, router)",
      "options":{"baseURL":$url},"models":$models}}')
}

