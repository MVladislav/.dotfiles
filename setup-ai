# CLI :: usage -----------------------------------------------------------------
usage() {
  print_info "\n📖 Usage: $0 [options]"
  print_info "   Symlink AI dotfiles and optionally install AI tools"
  print_info ""
  print_info "   🎯 Examples:"
  print_info "     $0 -ioc                               Install opencode + config dir"
  print_info "     $0 -soc                               Only create config dir, skip install"
  print_info "     $0 -ihrd                              Install herdr + config dir"
  print_info "     $0 -ds                                Skip config dir setup"
  print_info "     $0 -upc                               Check for newer versions"
  print_info ""
  print_info "   ⚙️ Install flags:"
  print_info "     -ioc       --install-opencode               Install opencode"
  print_info "     -ihrd      --install-herdr                  Install herdr"
  print_info "     -igh       --install-github-cli             Install GitHub CLI from releases"
  print_info "     -ighd      --install-gh-dash                Install gh-dash (gh extension) + config"
  print_info "     -ifb       --install-filebrowser            Install filebrowser (Quantum fork) from releases"
  print_info "     -ill       --install-llamacpp               Build + install llama.cpp (CPU/OpenBLAS, auto-detect CUDA/ROCm/Vulkan)"
  print_info "     -illv      --install-llamacpp-vulkan        Build + install llama.cpp with the Vulkan backend"
  print_info ""
  print_info "   🔗 Setup flags (disabled by default):"
  print_info "     -soc       --setup-opencode                 Create opencode config dir"
  print_info "     -shrd      --setup-herdr                    Create herdr config dir"
  print_info "     -sgd       --setup-gh-dash                  Create gh-dash config dir"
  print_info "     -sfb       --setup-filebrowser              Create filebrowser config + users (admin/readonly)"
  print_info "     -sll       --setup-llamacpp                 Pick model/quant + KV-ctx profile, enable the API server"
  print_info "     -ds        --disable-setups                 Skip all symlink setups"
  print_info ""
  print_info "   🛠️ Meta flags:"
  print_info "     -h         --help                           Show this help"
  print_info "     -d         --debug                          Enable bash debug mode (set -x)"
  print_info "     -upc       --update-check                   Check tools for newer versions"
}

# CLI :: parse args ------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
    -h | --help)
      usage
      exit 0
      ;;
    -ioc | --install-opencode)
      RUN_INSTALL_OPENCODE=1
      ;;
    -ihrd | --install-herdr)
      RUN_INSTALL_HERDR=1
      ;;
    -igh | --install-github-cli)
      RUN_INSTALL_GH=1
      ;;
    -ighd | --install-gh-dash)
      RUN_INSTALL_GH_DASH=1
      ;;
    -ifb | --install-filebrowser)
      RUN_INSTALL_FILEBROWSER=1
      ;;
    -ill | --install-llamacpp)
      RUN_INSTALL_LLAMACPP=1
      ;;
    -illv | --install-llamacpp-vulkan)
      RUN_INSTALL_LLAMACPP=1
      RUN_INSTALL_LLAMACPP_VULKAN=1
      ;;
    -soc | --setup-opencode)
      RUN_SETUP_OPENCODE=1
      ;;
    -shrd | --setup-herdr)
      RUN_SETUP_HERDR=1
      ;;
    -sgd | --setup-gh-dash)
      RUN_SETUP_GH_DASH=1
      ;;
    -sfb | --setup-filebrowser)
      RUN_SETUP_FILEBROWSER=1
      ;;
    -sll | --setup-llamacpp)
      RUN_SETUP_LLAMACPP=1
      ;;
    -ds | --disable-setups)
      RUN_SETUP_OPENCODE=0
      RUN_SETUP_HERDR=0
      RUN_SETUP_GH_DASH=0
      RUN_SETUP_FILEBROWSER=0
      RUN_SETUP_LLAMACPP=0
      ;;
    -d | --debug)
      set -x
      ;;
    -upc | --update-check)
      RUN_INSTALL_OPENCODE=0
      RUN_INSTALL_HERDR=0
      RUN_INSTALL_LLAMACPP=0
      RUN_INSTALL_LLAMACPP_VULKAN=0
      RUN_SETUP_OPENCODE=0
      RUN_SETUP_HERDR=0
      RUN_SETUP_LLAMACPP=0
      echo
      check_for_newer_tag "$VERSION_OPENCODE_REPO" "$VERSION_OPENCODE" "^v[0-9]"
      check_for_newer_tag "$VERSION_HERDR_REPO" "$VERSION_HERDR"
      check_for_newer_tag "$VERSION_GH_REPO" "$VERSION_GH" "^v[0-9]"
      check_for_newer_tag "$VERSION_FILEBROWSER_REPO" "$VERSION_FILEBROWSER" "stable$"
      check_for_newer_tag "$VERSION_LLAMACPP_REPO" "$VERSION_LLAMACPP" "^v[0-9]"
      exit 0
      ;;
    *)
      print_error "❌ Unknown option: $key"
      usage
      exit 1
      ;;
    esac
    shift
  done
}

# ******************************************************************************

print_info2 "▶️ Starting script $0 ..."

parse_args "$@"

main
exit 0
