#!/usr/bin/env bash
PATH="/usr/bin/:/usr/local/bin/:/bin:/usr/sbin/:/sbin:/snap/bin/:$HOME/.local/bin"
set -euo pipefail

# editorconfig-checker-disable
cat <<'EOF'
   .--.
  |o_o |
  |:_/ |
 //   \ \
( |   | )
 \ \_ _/
  \___)

  /\
 {  }
  \/
   AI Tux: Activating dotfiles...
   Neural networks: ONLINE
   Linux core: STABLE

EOF
# editorconfig-checker-enable

[[ -f "./setup-helper" ]] || { echo 'ERROR: "./setup-helper" not found.'; exit 1; }
# shellcheck disable=SC1091
source "./setup-helper"

[[ -f "./ai/setup-ai-opencode.conf" ]] || { echo 'ERROR: "./ai/setup-ai-opencode.conf" not found.'; exit 1; }
# shellcheck source=ai/setup-ai-opencode.conf
# shellcheck disable=SC1091
# NOTE: lint with 'shellcheck -x setup-ai' (follows the sourced conf)
source "./ai/setup-ai-opencode.conf"

# ******************************************************************************

# CONFIG :: toggle flags -------------------------------------------------------
RUN_INSTALL_OPENCODE=0
RUN_INSTALL_HERDR=0
RUN_INSTALL_GH=0
RUN_INSTALL_GH_DASH=0

RUN_SETUP_OPENCODE=0
RUN_SETUP_HERDR=0
RUN_SETUP_GH_DASH=0

# CONFIG :: version pins -------------------------------------------------------
VERSION_OPENCODE=v1.18.11
VERSION_OPENCODE_REPO=https://github.com/anomalyco/opencode
VERSION_HERDR=v0.8.0
VERSION_HERDR_REPO=https://github.com/herdrdev/herdr

# CONFIG :: paths --------------------------------------------------------------
LN_OPENCODE="${LN_OPENCODE:-"$HOME/.config/opencode"}"
LN_HERDR="${LN_HERDR:-"$HOME/.config/herdr/config.toml"}"
LN_GHDASH="${LN_GHDASH:-"$HOME/.config/gh-dash/config.yml"}"

# ******************************************************************************

# MAIN :: entry point ----------------------------------------------------------
main() {
  sudo_drop

  run_if $RUN_INSTALL_OPENCODE && install_opencode
  run_if $RUN_INSTALL_HERDR && install_herdr
  run_if $RUN_INSTALL_GH && install_gh
  run_if $RUN_INSTALL_GH_DASH && install_gh_dash
  # https://github.com/aliasrobotics/cai

  run_if $RUN_SETUP_OPENCODE && setup_opencode
  run_if $RUN_SETUP_HERDR && setup_herdr
  run_if $RUN_SETUP_GH_DASH && setup_ghdash

  print_info2 "\n✅ All finished!"
}

# ******************************************************************************

# SERVICE :: install opencode --------------------------------------------------
install_opencode() {
  print_info2 "\n🚀 OPENCODE :: install opencode..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/opencode" --version 2>/dev/null)'"
  download_github_binary "$VERSION_OPENCODE_REPO" 'opencode-linux-x64\.tar\.gz'
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/opencode" --version 2>/dev/null)'"
  print_info2 "✅ OPENCODE :: opencode installed!"

  # setup_opencode
}

# SERVICE :: install herdr --------------------------------------------------
install_herdr() {
  print_info2 "\n🚀 HERDR :: install herdr..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/herdr" --version 2>/dev/null)'"
  mkdir -p "$USER_LOCAL_PREFIX_BIN"
  curl -fsSLo "$USER_LOCAL_PREFIX_BIN/herdr" "$VERSION_HERDR_REPO/releases/download/$VERSION_HERDR/herdr-linux-x86_64"
  chmod +x "$USER_LOCAL_PREFIX_BIN/herdr"
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/herdr" --version 2>/dev/null)'"
  print_info2 "✅ HERDR :: herdr installed!"

  setup_herdr
}

# SERVICE :: install gh (GitHub CLI) -------------------------------------------
install_gh() {
  print_info2 "\n🚀 GH :: install GitHub CLI..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/gh" --version 2>/dev/null | head -1)'"
  download_github_binary 'https://github.com/cli/cli' 'gh_.*_linux_amd64\.tar\.gz'
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/gh" --version 2>/dev/null | head -1)'"
  print_notes "   💡 authenticate: gh auth login (or reuse GITHUB_TOKEN, see ai/GITHUB.md)"
  print_info2 "✅ GH :: GitHub CLI installed!"
}

# SERVICE :: install gh-dash (GitHub dashboard) ---------------------------------
# NOTE: installed as a gh extension; requires gh + gh auth (see ai/GITHUB.md)
install_gh_dash() {
  print_info2 "\n🚀 GH-DASH :: install gh-dash..."
  command -v gh >/dev/null 2>&1 || {
    print_notes "   ⚠️  gh not found — install GitHub CLI first (setup-ai -igh)"
    return 0
  }
  if gh extension list | grep -q '^gh-dash'; then
    print_notes "   💡 gh-dash already installed, upgrading..."
    gh extension upgrade gh-dash --force 1>/dev/null
  else
    gh extension install dlvhdr/gh-dash 1>/dev/null
  fi
  print_notes "   💡 start it with: gh dash (token via gh auth / GITHUB_TOKEN, see ai/GITHUB.md)"
  print_info2 "✅ GH-DASH :: gh-dash installed!"

  setup_ghdash
}

