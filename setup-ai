set -euo pipefail

# editorconfig-checker-disable
cat <<'EOF'
   .--.
  |o_o |
  |:_/ |
 //   \ \
( |   | )
 \ \_ _/
  \___)

  /\
 {  }
  \/
   AI Tux: Activating dotfiles...
   Neural networks: ONLINE
   Linux core: STABLE

EOF
# editorconfig-checker-enable

