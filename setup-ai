  print_info2 "✅ FILEBROWSER :: filebrowser installed!"

  setup_filebrowser
}

# SERVICE :: install llama.cpp -------------------------------------------------
# Install-only: builds llama.cpp and drops the binaries in ~/.local/bin.
# Runtime configuration lives in setup_llamacpp() ('-sll').
install_llamacpp() {
  print_info2 "\n🚀 LLAMACPP :: install llama.cpp..."
  print_notes "   💡 current installed version :: '$(llamacpp_binary_version)'"
  rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null

  # -- dependencies -----------------------------------------------------------
  # packages_tools stay installed (runtime needs them), packages_build is
  # removed again afterwards.
  # pkg-config is REQUIRED, not optional: with -DGGML_BLAS=ON, CMake's FindBLAS
  # leaves BLAS_INCLUDE_DIRS empty on Debian/Ubuntu (kitware#20268), and
  # ggml/src/ggml-blas/CMakeLists.txt then does find_package(PkgConfig REQUIRED)
  # to locate the library. Without it the configure step dies with
  # "Could NOT find PkgConfig (missing: PKG_CONFIG_EXECUTABLE)".
  local packages_tools=(libopenblas-dev)
    # shellcheck disable=SC2034
  local packages_build=(git cmake build-essential pkg-config)
  if [[ $RUN_INSTALL_LLAMACPP_VULKAN -eq 1 ]]; then
    # Vulkan backend (AMD via RADV, Intel, NVIDIA); drivers stay installed
    # shellcheck disable=SC2034
    packages_tools+=(mesa-vulkan-drivers vulkan-tools libvulkan-dev glslang-tools)
  fi
  install_dependencies_needs packages_tools[@] packages_build[@]

  # -- backend selection ------------------------------------------------------
  # Vulkan (explicit) > CUDA > HIP (ROCm) > CPU+BLAS. GGML_NATIVE (default ON)
  # already compiles for the exact host CPU, so the CPU path needs no flag.
  local gpu_flags=()
  local cmake_env=()
  if [[ $RUN_INSTALL_LLAMACPP_VULKAN -eq 1 ]]; then
    gpu_flags=(-DGGML_VULKAN=ON)
    print_notes "   🎮 Vulkan backend requested (GGML_VULKAN=ON) - works with AMD/RADV, Intel and NVIDIA"
  elif command -v nvcc >/dev/null 2>&1; then
    local cuda_archs
    cuda_archs=$(llamacpp_detect_cuda_archs)
    gpu_flags=(-DGGML_CUDA=ON)
    [[ -n "$cuda_archs" ]] && gpu_flags+=(-DCMAKE_CUDA_ARCHITECTURES="$cuda_archs")
    cmake_env=(env PATH="$(dirname "$(command -v nvcc)"):$PATH"
      LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}")
    print_notes "   🎮 NVIDIA CUDA toolkit detected - building with GGML_CUDA=ON${cuda_archs:+ (arches: $cuda_archs)}"
  elif lspci 2>/dev/null | grep -qiE 'AMD/ATI|Radeon'; then
    if [[ -d /opt/rocm ]] && command -v rocminfo >/dev/null 2>&1; then
      local gfx_target
      gfx_target=$(rocminfo 2>/dev/null | grep -m1 -oE 'gfx[0-9a-f]+' || true)
      if [[ -n "$gfx_target" ]]; then
        gpu_flags=(-DGGML_HIPBLAS=ON -DAMDGPU_TARGETS="$gfx_target")
        cmake_env=(env PATH="/opt/rocm/bin:$PATH")
        print_notes "   🎮 AMD GPU + ROCm ($gfx_target) detected - building with HIPBLAS"
        print_notes "   💡 unsupported GPU at runtime: HSA_OVERRIDE_GFX_VERSION=$gfx_target"
      else
        print_notes "   ⚠️  AMD GPU found, no gfx target from rocminfo - building CPU-only"
      fi
    else
      print_notes "   ⚠️  AMD GPU found but ROCm toolkit missing - building CPU-only"
      print_notes "   💡 install ROCm (https://rocm.docs.amd.com) or use $0 -illv for Vulkan"
    fi
  else
    print_notes "   💡 no supported GPU detected - building CPU-only with OpenBLAS"
  fi

  # -- fetch ------------------------------------------------------------------
  print_notes "   📦 cloning llama.cpp $VERSION_LLAMACPP..."
  run_quiet_hint "⏳ cloning $VERSION_LLAMACPP_REPO (a few MB, can take a minute)..." \
    git clone -q "$VERSION_LLAMACPP_REPO" "$DEPS_INSTALL_PATH/llama.cpp"
  pushd "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
  [[ $INSTALL_SOURCE_FROM == 'release' ]] && git checkout -q "$VERSION_LLAMACPP"

  # -- build ------------------------------------------------------------------
  # Only the four binaries this dotfiles setup actually uses; skipping the test
  # suite, examples and the remaining tools cuts build time by more than half.
  # Configure and build are captured: cmake progress is not our output, but a
  # failure prints the tail so the actual error is never hidden.
  print_notes "   🔧 building llama-server, llama-cli, llama-quantize, llama-bench (${gpu_flags[*]:-CPU})..."
  if ! run_quiet_hint "⏳ configuring the build (cmake)..." "${cmake_env[@]}" cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DLLAMA_BUILD_TOOLS=ON \
    -DLLAMA_BUILD_SERVER=ON \
    -DGGML_BLAS=ON \
    -DGGML_BLAS_VENDOR=OpenBLAS \
    "${gpu_flags[@]}"; then
    print_error "   ❌ cmake configure failed"
    popd 1>/dev/null
    rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
    install_dependencies_needs_rm
    return 1
  fi

  # A build log is worth keeping on failure, so only tail it live.
  local build_log="$DEPS_INSTALL_PATH/llamacpp-build.log"
  print_notes "   ⏳ this takes a few minutes on $(nproc) cores (log: $build_log)"
  if ! "${cmake_env[@]}" cmake --build build --config Release \
    -j "$(nproc)" \
    --target llama-server llama-cli llama-quantize llama-bench >"$build_log" 2>&1; then
    print_error "   ❌ build failed - last 25 lines:"
    tail -n 25 "$build_log" | while IFS= read -r line; do print_notes "      $line"; done
    print_notes "   ↳ full log: $build_log"
    popd 1>/dev/null
    rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
    install_dependencies_needs_rm
    return 1
  fi
  rm -f "$build_log"

  mkdir -p "$USER_LOCAL_PREFIX_BIN"
  local installed=() bin
  for bin in llama-server llama-cli llama-quantize llama-bench; do
    if [[ -f "build/bin/$bin" ]]; then
      cp -f "build/bin/$bin" "$USER_LOCAL_PREFIX_BIN/"
      installed+=("$bin")
    fi
  done
  popd 1>/dev/null

  if [[ ${#installed[@]} -eq 0 ]]; then
    print_error "   ❌ build produced no binaries"
    rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
    install_dependencies_needs_rm
    return 1
  fi

  # Smoke test: a build can succeed and still produce binaries that cannot
  # start (missing shared library, wrong RPATH). Catch that here rather than at
  # first use. NOTE: --version prints on stderr and exits 0, so judge by exit
  # code and by the loader's message, never by "stderr was non-empty".
  local smoke_out smoke_rc=0
  smoke_out=$("$USER_LOCAL_PREFIX_BIN/llama-server" --version 2>&1) || smoke_rc=$?
  if ((smoke_rc != 0)) || [[ "$smoke_out" == *"error while loading shared"* ]]; then
    print_error "   ❌ llama-server is installed but cannot run (exit $smoke_rc):"
    print_notes "      $(echo "$smoke_out" | head -n1)"
    print_error "   ❌ build tree kept for inspection: $DEPS_INSTALL_PATH/llama.cpp"
    install_dependencies_needs_rm
    return 1
  fi
  print_notes "   ✅ smoke test: llama-server starts"

  # Only now is the build tree disposable.
  rm -rf "$DEPS_INSTALL_PATH/llama.cpp" 1>/dev/null
  print_notes "   💡 new installed version :: '$(llamacpp_binary_version)'"

  install_dependencies_needs_rm

  print_info2 "✅ LLAMACPP :: llama.cpp installed ($(echo "${installed[*]}" | tr ' ' ','))!"
  print_notes "   ➡️ next: $0 -sll   (pick a model + start the API server)"
}

# HELPERS :: detect CUDA architectures ------------------------------------------
# Empty result = let CMake pick the default (native/CUDA default arch).
llamacpp_detect_cuda_archs() {
  command -v nvidia-smi >/dev/null 2>&1 || return 0
  local sm
  sm=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -n1) || return 0
  [[ "$sm" =~ ^([0-9]+)\.([0-9]+)$ ]] || return 0
  # CMake wants "major;minor", nvidia-smi reports "major.minor" (8.6 -> 86).
  printf '%s;%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

# HELPERS :: is there a real GPU backend in this build? --------------------------
# 'llama-server --list-devices' lists only what was compiled in. A CPU-only
# build shows just "BLAS: ..." and warns on every start that --gpu-layers and
# --split-mode are ignored, so only emit those when a GPU is actually present.
llamacpp_gpu_available() {
  local bin="$USER_LOCAL_PREFIX_BIN/llama-server"
  [[ -x "$bin" ]] || return 1
  local devs name
  devs=$("$bin" --list-devices 2>/dev/null | sed -n 's/^[[:space:]]*\([A-Za-z0-9_]*\):.*/\1/p')
  [[ -z "$devs" ]] && return 1
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    case "$name" in
    BLAS | CPU) ;;
    *) return 0 ;;
    esac
  done <<<"$devs"
  return 1
}

# SETUP :: bind address picker ---------------------------------------------------
# Who may reach the API. Static config is easy to get wrong (binding 0.0.0.0 by
# accident, or exposing a public IP), so offer loopback, the wildcard and each
# address this host actually owns, labelled with its scope.
llamacpp_select_bind() {
  local current
  current=$(llamacpp_bind_host)

  if ! command -v fzf >/dev/null 2>&1; then
    echo "$current"
    return 0
  fi

  # addr -> "interface | scope description" (empty interface for built-ins)
  local preview_dir addr iface fzf_list sel sorted defaults
  preview_dir=$(mktemp -d)
  declare -A rows=()

  while IFS='|' read -r addr iface; do
    [[ -z "$addr" ]] && continue
    rows["$addr"]="$iface | $(llamacpp_ip_scope "$addr") address"
  done < <(llamacpp_detect_ips)
  rows["$LLAMACPP_HOST"]="loopback | this machine"
  rows["0.0.0.0"]="all interfaces | anything routable to this host"

  defaults=""
  fzf_list=""
  for addr in "${!rows[@]}"; do
    [[ "$addr" == "$current" ]] && defaults="$addr"
    {
      echo "bind address : $addr"
      echo "scope        : $(llamacpp_ip_scope "$addr")"
      echo ""
      echo "loopback (127.0.0.1)  reachable only from this machine."
      echo "wildcard (0.0.0.0)    reachable from every host that can route here."
      echo "a specific address    reachable from its own subnet only."
      echo ""
      echo "The first request for a model downloads its GGUF, so an"
      echo "exposed host can be made to fetch tens of GB."
    } >"$preview_dir/$addr.info"
    fzf_list+="$addr | ${rows[$addr]}"$'\n'
  done
  sorted=$(printf '%s\n' "$fzf_list" | sort -t'|' -k1,1)

  sel=$(fzf_pick "$sorted" "$defaults" \
    'PUBLIC = routable from the internet; the API key is the only thing in front of it' \
    'Which addresses may reach the API? ' \
    "cat '$preview_dir'/\$(echo {} | cut -d'|' -f1 | tr -d ' ').info 2>/dev/null")
  rm -rf "$preview_dir"
  [[ -z "$sel" ]] && {
    echo "$current"
    return 0
  }
  echo "$sel" | cut -d'|' -f1 | tr -d ' '
}

# HELPERS :: API key file ---------------------------------------------------------
# Generated once, never stored in the repo. Printed only as a location, never
# echoed in full, so it does not end up in scrollback or logs.
llamacpp_ensure_api_key() {
  local file="$LLAMACPP_API_KEY_FILE"
  if [[ ! -s "$file" ]]; then
    mkdir -p "$(dirname "$file")"
    local key
    if command -v openssl >/dev/null 2>&1; then
      key=$(openssl rand -hex 24)
    else
      key=$(head -c 48 /dev/urandom | od -An -tx1 | tr -d ' \n')
    fi
    printf '# llama.cpp API key - generated %s\n# Send as: Authorization: Bearer <key below>\n%s\n' \
      "$(date '+%Y-%m-%d')" "$key" >"$file"
    chmod 600 "$file"
    print_notes "   🔑 generated a new API key -> $file (chmod 600, not in git)"
  fi
  grep -vE '^[[:space:]]*(#|$)' "$file" | head -n1
}

# HELPERS :: effective bind address ----------------------------------------------
llamacpp_bind_host() {
  printf '%s' "${LLAMACPP_BIND:-$LLAMACPP_HOST}"
}

# HELPERS :: address a client on THIS machine should connect to --------------------
# A wildcard bind (0.0.0.0 / ::) includes loopback, so a local client should use
# 127.0.0.1. A specific-address bind (192.168.x.x) is the only thing listening,
# so the client has to use that same address.
llamacpp_client_host() {
  case "$(llamacpp_bind_host)" in
  0.0.0.0 | :: | '[::]') printf '127.0.0.1' ;;
  *) llamacpp_bind_host ;;
  esac
}

# HELPERS :: classify an address for the picker -----------------------------------
# HELPERS :: CORS allow-list -------------------------------------------------------
# CORS is enforced by browsers only, so it never affects curl, opencode or the
# HTTP SDKs - it just stops a page in your browser from reading replies.
#
# NOTE: llama.cpp implements only three cases, despite the help text claiming a
# comma-separated list (tools/server/server-http.cpp):
#   "*"        -> reflect whatever Origin arrives
#   "localhost"-> reflect the Origin only when it is a localhost origin
#   anything else -> emit that string VERBATIM as Access-Control-Allow-Origin
# So a comma-joined value is NOT parsed; it becomes one literal header that no
# browser origin matches, silently blocking every browser. Emit exactly one.
llamacpp_cors_origins() {
  if [[ -n "$LLAMACPP_CORS_ORIGINS" ]]; then
    printf '%s' "$LLAMACPP_CORS_ORIGINS"
    return 0
  fi
  case "$(llamacpp_bind_host)" in
  # loopback and wildcard both serve pages on this machine
  127.* | localhost | 0.0.0.0 | :: | '[::]') printf 'localhost' ;;
  # a specific address: allow only that exact origin. A browser page served
  # from some other host needs its origin set explicitly in the conf.
  *) printf 'http://%s:%s' "$(llamacpp_bind_host)" "$LLAMACPP_PORT" ;;
  esac
}

llamacpp_ip_scope() {
  case "$1" in
  0.0.0.0 | :: | '[::]') echo "wildcard" ;;
  127.* | localhost) echo "private" ;;
  10.* | 192.168.*) echo "private" ;;
  172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) echo "private" ;;
  169.254.*) echo "link-local" ;;
  *) echo "PUBLIC" ;;
  esac
}

# HELPERS :: non-loopback IPv4 addresses with their interface ---------------------
# One "addr|iface" line per global-scope address; empty when none is found.
llamacpp_detect_ips() {
  local addr iface
  if command -v ip >/dev/null 2>&1; then
    while read -r addr iface; do
      [[ -z "$addr" || "$addr" == 127.* || "$addr" == 169.254.* ]] && continue
      printf '%s|%s\n' "$addr" "$iface"
    done < <(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1], $2}')
    return 0
  fi
  # fallbacks when iproute2 is unavailable
  for addr in $(hostname -I 2>/dev/null); do
    [[ "$addr" == 127.* ]] && continue
    printf '%s|%s\n' "$addr" "?"
  done
}

# HELPERS :: CPU SIMD capabilities -----------------------------------------------
# ggml compiles the kernels it is allowed to use, and without AVX/FMA it falls
# back to scalar paths that are several times slower. Worth saying out loud,
# because otherwise a low tokens/second reads as a misconfiguration.
llamacpp_cpu_simd() {
  local flags out=""
  flags=$(awk -F: '/^flags/{print $2; exit}' /proc/cpuinfo 2>/dev/null) || true
  [[ -z "$flags" ]] && {
    echo "unknown"
    return 0
  }
  local feature
  for feature in avx512f avx2 avx fma sse4_2; do
    [[ " $flags " == *" $feature "* ]] && out+="${feature} "
  done
  echo "${out:-none}"
}

# HELPERS :: llama-server version, never blank ----------------------------------
# Two traps this avoids:
#  - llama.cpp prints its version banner on STDERR, not stdout, so "2>/dev/null"
#    hides it and yields an empty string.
#  - a binary that cannot start (missing shared library) also fails on stderr.
# Capture both streams, then tell the two apart.
llamacpp_binary_version() {
  local bin="$USER_LOCAL_PREFIX_BIN/llama-server"
  if [[ ! -x "$bin" ]]; then
    echo "not installed"
    return 0
  fi
  local out
  out=$("$bin" --version 2>&1 | head -n1)
  out="${out%"${out##*[![:space:]]}"}"
  if [[ "$out" == *"error while loading shared"* || "$out" == *"cannot open shared object"* ]]; then
    echo "unrunnable: $out"
  elif [[ -z "$out" ]]; then
    echo "installed, but '--version' printed nothing"
  else
    echo "$out"
  fi
}

