#!/usr/bin/env bash
PATH="/usr/bin/:/usr/local/bin/:/bin:/usr/sbin/:/sbin:/snap/bin/:$HOME/.local/bin"
set -euo pipefail

# editorconfig-checker-disable
cat <<'EOF'
   .--.
  |o_o |
  |:_/ |
 //   \ \
( |   | )
 \ \_ _/
  \___)

  /\
 {  }
  \/
   AI Tux: Activating dotfiles...
   Neural networks: ONLINE
   Linux core: STABLE

EOF
# editorconfig-checker-enable

[[ -f "./setup-helper" ]] || { echo 'ERROR: "./setup-helper" not found.'; exit 1; }
# shellcheck disable=SC1091
source "./setup-helper"

[[ -f "./setup-ai-install" ]] || { echo 'ERROR: "./setup-ai-install" not found.'; exit 1; }
# shellcheck source=setup-ai-install
# shellcheck disable=SC1091
source "./setup-ai-install"

[[ -f "./setup-ai-config" ]] || { echo 'ERROR: "./setup-ai-config" not found.'; exit 1; }
# shellcheck source=setup-ai-config
# shellcheck disable=SC1091
source "./setup-ai-config"

[[ -f "./ai/setup-ai-opencode.conf" ]] || { echo 'ERROR: "./ai/setup-ai-opencode.conf" not found.'; exit 1; }
# shellcheck source=ai/setup-ai-opencode.conf
# shellcheck disable=SC1091
# NOTE: lint with 'shellcheck -x setup-ai' (follows the sourced conf)
source "./ai/setup-ai-opencode.conf"

[[ -f "./ai/setup-ai-llamacpp.conf" ]] || { echo 'ERROR: "./ai/setup-ai-llamacpp.conf" not found.'; exit 1; }
# shellcheck source=ai/setup-ai-llamacpp.conf
# shellcheck disable=SC1091
source "./ai/setup-ai-llamacpp.conf"

# ******************************************************************************

# CONFIG :: toggle flags -------------------------------------------------------
RUN_INSTALL_OPENCODE=0
RUN_INSTALL_HERDR=0
RUN_INSTALL_GH=0
RUN_INSTALL_GH_DASH=0
RUN_INSTALL_FILEBROWSER=0
RUN_INSTALL_LLAMACPP=0
RUN_INSTALL_LLAMACPP_VULKAN=0

RUN_SETUP_OPENCODE=0
RUN_SETUP_HERDR=0
RUN_SETUP_GH_DASH=0
RUN_SETUP_FILEBROWSER=0
RUN_SETUP_LLAMACPP=0

# CONFIG :: version pins -------------------------------------------------------
VERSION_OPENCODE=v2.0.31
VERSION_OPENCODE_REPO=https://github.com/anomalyco/opencode
VERSION_HERDR=v0.9.3
VERSION_HERDR_REPO=https://github.com/herdrdev/herdr
VERSION_FILEBROWSER=v2.0.0-stable
VERSION_FILEBROWSER_REPO=https://github.com/gtsteffaniak/filebrowser
VERSION_GH=v2.102.0
VERSION_GH_REPO=https://github.com/cli/cli
# llama.cpp now publishes stable semver releases; the rolling bNNNNN tags are
# prereleases, so pin the release like every other tool here.
VERSION_LLAMACPP=v0.6.0
VERSION_LLAMACPP_REPO=https://github.com/ggml-org/llama.cpp

# CONFIG :: paths --------------------------------------------------------------
LN_OPENCODE="${LN_OPENCODE:-"$HOME/.config/opencode"}"
LN_HERDR="${LN_HERDR:-"$HOME/.config/herdr/config.toml"}"
LN_GHDASH="${LN_GHDASH:-"$HOME/.config/gh-dash/config.yml"}"
LN_FILEBROWSER="${LN_FILEBROWSER:-"$HOME/.config/filebrowser"}"
FILEBROWSER_ROOT="${FILEBROWSER_ROOT:-"$HOME/projects"}"
# systemd --user unit (linked into ~/.config/systemd/user, not a symlinked config)
UNIT_LLAMACPP="${UNIT_LLAMACPP:-"$HOME/.config/systemd/user/$LLAMACPP_UNIT_NAME"}"

# ******************************************************************************

# MAIN :: entry point ----------------------------------------------------------
main() {
  sudo_drop

  run_if $RUN_INSTALL_OPENCODE && install_opencode
  run_if $RUN_INSTALL_HERDR && install_herdr
  run_if $RUN_INSTALL_GH && install_gh
  run_if $RUN_INSTALL_GH_DASH && install_gh_dash
  run_if $RUN_INSTALL_FILEBROWSER && install_filebrowser
  run_if $RUN_INSTALL_LLAMACPP && install_llamacpp
  # https://github.com/aliasrobotics/cai
  # https://hermes-agent.nousresearch.com/docs/getting-started/installation

# llama.cpp config runs first: it generates OPENCODE_CONFIG_PROVIDER_LLAMACPP
  # from the model the user just picked, which setup_opencode then merges.
  run_if $RUN_SETUP_LLAMACPP && setup_llamacpp
  run_if $RUN_SETUP_OPENCODE && setup_opencode
  run_if $RUN_SETUP_HERDR && setup_herdr
  run_if $RUN_SETUP_GH_DASH && setup_ghdash
  run_if $RUN_SETUP_FILEBROWSER && setup_filebrowser

  print_info2 "\n✅ All finished!"
}

# CLI :: usage -----------------------------------------------------------------
usage() {
  print_info "\n📖 Usage: $0 [options]"
  print_info "   Symlink AI dotfiles and optionally install AI tools"
  print_info ""
  print_info "   🎯 Examples:"
  print_info "     $0 -ioc                               Install opencode binary"
  print_info "     $0 -soc                               Only create config dir, skip install"
  print_info "     $0 -ihrd                              Install herdr binary"
  print_info "     $0 -ds                                Skip config dir setup"
  print_info "     $0 -upc                               Check for newer versions"
  print_info ""
  print_info "     Install and config are separate steps. Pair the -i flag"
  print_info "     with the matching -s flag:"
  print_info "     $0 -ioc -soc                          Install opencode, then write its config"
  print_info "     $0 -ihrd -shrd                        Install herdr, then link its config"
  print_info "     $0 -ighd -sgd                         Install gh-dash, then link its config"
  print_info "     $0 -ifb -sfb                          Install filebrowser, then write config + users"
  print_info "     $0 -ill -sll                          Install llama.cpp, then build the local model server"
  print_info ""
  print_info "   ⚙️ Install flags:"
  print_info "     -ioc       --install-opencode               Install opencode"
  print_info "     -ihrd      --install-herdr                  Install herdr"
  print_info "     -igh       --install-github-cli             Install GitHub CLI from releases"
  print_info "     -ighd      --install-gh-dash                Install gh-dash (gh extension) + config"
  print_info "     -ifb       --install-filebrowser            Install filebrowser (Quantum fork) from releases"
  print_info "     -ill       --install-llamacpp               Build + install llama.cpp (CPU/OpenBLAS, auto-detect CUDA/ROCm/Vulkan)"
  print_info "     -illv      --install-llamacpp-vulkan        Build + install llama.cpp with the Vulkan backend"
  print_info ""
  print_info "   🔗 Setup flags (disabled by default):"
  print_info "     -soc       --setup-opencode                 Create opencode config dir"
  print_info "     -shrd      --setup-herdr                    Create herdr config dir"
  print_info "     -sgd       --setup-gh-dash                  Create gh-dash config dir"
  print_info "     -sfb       --setup-filebrowser              Create filebrowser config + users (admin/readonly)"
  print_info "     -sll       --setup-llamacpp                 Pick model/quant + KV-ctx profile, enable the API server"
  print_info "     -ds        --disable-setups                 Skip all symlink setups"
  print_info ""
  print_info "   🛠️ Meta flags:"
  print_info "     -h         --help                           Show this help"
  print_info "     -d         --debug                          Enable bash debug mode (set -x)"
  print_info "     -upc       --update-check                   Check tools for newer versions"
}

# CLI :: parse args ------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
    -h | --help)
      usage
      exit 0
      ;;
    -ioc | --install-opencode)
      RUN_INSTALL_OPENCODE=1
      ;;
    -ihrd | --install-herdr)
      RUN_INSTALL_HERDR=1
      ;;
    -igh | --install-github-cli)
      RUN_INSTALL_GH=1
      ;;
    -ighd | --install-gh-dash)
      RUN_INSTALL_GH_DASH=1
      ;;
    -ifb | --install-filebrowser)
      RUN_INSTALL_FILEBROWSER=1
      ;;
    -ill | --install-llamacpp)
      RUN_INSTALL_LLAMACPP=1
      ;;
    -illv | --install-llamacpp-vulkan)
      RUN_INSTALL_LLAMACPP=1
      RUN_INSTALL_LLAMACPP_VULKAN=1
      ;;
    -soc | --setup-opencode)
      RUN_SETUP_OPENCODE=1
      ;;
    -shrd | --setup-herdr)
      RUN_SETUP_HERDR=1
      ;;
    -sgd | --setup-gh-dash)
      RUN_SETUP_GH_DASH=1
      ;;
    -sfb | --setup-filebrowser)
      RUN_SETUP_FILEBROWSER=1
      ;;
    -sll | --setup-llamacpp)
      RUN_SETUP_LLAMACPP=1
      ;;
    -ds | --disable-setups)
      RUN_SETUP_OPENCODE=0
      RUN_SETUP_HERDR=0
      RUN_SETUP_GH_DASH=0
      RUN_SETUP_FILEBROWSER=0
      RUN_SETUP_LLAMACPP=0
      ;;
    -d | --debug)
      set -x
      ;;
    -upc | --update-check)
      RUN_INSTALL_OPENCODE=0
      RUN_INSTALL_HERDR=0
      RUN_INSTALL_LLAMACPP=0
      # shellcheck disable=SC2034
      RUN_INSTALL_LLAMACPP_VULKAN=0
      RUN_SETUP_OPENCODE=0
      RUN_SETUP_HERDR=0
      RUN_SETUP_LLAMACPP=0
      echo
      # opencode v2 is TAGGED but not RELEASED on GitHub (releases/latest is
      # still v1.19.x), so the update check must read tags or it always offers
      # a v1 downgrade. The npm tarball is what install_opencode actually pulls.
      check_for_newer_tag "$VERSION_OPENCODE_REPO" "$VERSION_OPENCODE" "^v[0-9]" "tags"
      check_for_newer_tag "$VERSION_HERDR_REPO" "$VERSION_HERDR" "" "releases"
      check_for_newer_tag "$VERSION_GH_REPO" "$VERSION_GH" "^v[0-9]" "releases"
      check_for_newer_tag "$VERSION_FILEBROWSER_REPO" "$VERSION_FILEBROWSER" "stable$" "releases"
      check_for_newer_tag "$VERSION_LLAMACPP_REPO" "$VERSION_LLAMACPP" "^v[0-9]"
      exit 0
      ;;
    *)
      print_error "❌ Unknown option: $key"
      usage
      exit 1
      ;;
    esac
    shift
  done
}


# ******************************************************************************

print_info2 "▶️ Starting script $0 ..."

parse_args "$@"

main
exit 0
