#!/usr/bin/env bash
### DOCKER ###
if check_command_q docker; then
  alias docker='DOCKER_BUILDKIT=1 docker'
fi

if check_command_q docker; then
  alias docker-compose='docker compose'
  docker-swarm-compose() {
    # Usage: docker-swarm-compose [-f <file> ...] [--env-file <file> ...]
    #                            [never|always|changed] <STACK_NAME>
    #                            [--prune] [--dry-run|--config] [--show-warnings]
    local COMPOSE_FILES=()
    local RESOLVE_IMAGE="never"
    local ENV_FILES=()
    local PRUNE=0
    local DRY_RUN=0
    local SHOW_WARNINGS=0
    local ARGS=()

    # 1) Parse flags and collect everything else into ARGS
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -f | --file)
          if [[ -n "${2:-}" && -f "$2" ]]; then
            COMPOSE_FILES+=("$2")
            shift 2
          else
            echo "Error: Missing or invalid file after $1" >&2
            return 1
          fi
          ;;
        --env-file)
          if [[ -n "${2:-}" && -f "$2" ]]; then
            ENV_FILES+=("$2")
            shift 2
          else
            echo "Error: Missing or invalid env file after $1" >&2
            return 1
          fi
          ;;
        --prune)
          PRUNE=1
          shift
          ;;
        --dry-run | --config)
          DRY_RUN=1
          shift
          ;;
        --show-warnings)
          SHOW_WARNINGS=1
          shift
          ;;
        never | always | changed)
          # Only treat as the resolve-image setting before the stack name.
          if [[ ${#ARGS[@]} -eq 0 ]]; then
            RESOLVE_IMAGE="$1"
            shift
          else
            ARGS+=("$1")
            shift
          fi
          ;;
        -h | --help)
          echo "Usage: docker-swarm-compose [-f <file> ...] [--env-file <file> ...] [never|always|changed] <STACK_NAME>" >&2
          echo "       [--prune] [--dry-run|--config] [--show-warnings]" >&2
          return 0
          ;;
        *)
          ARGS+=("$1")
          shift
          ;;
      esac
    done

    # 2) Default compose file if none provided (prefer .yaml, fall back to .yml)
    if [[ "${#COMPOSE_FILES[@]}" -eq 0 ]]; then
      if [[ -f docker-compose.yaml ]]; then
        COMPOSE_FILES=(docker-compose.yaml)
      elif [[ -f docker-compose.yml ]]; then
        COMPOSE_FILES=(docker-compose.yml)
      else
        COMPOSE_FILES=(docker-compose.yaml)
      fi
    fi

    # 3) Validate compose files up front
    for f in "${COMPOSE_FILES[@]}"; do
      if [[ ! -f "$f" ]]; then
        echo "Error: Compose file not found: $f" >&2
        return 1
      fi
    done

    # 4) Default env file from ENV_FILE when present
    if [[ "${#ENV_FILES[@]}" -eq 0 && -n "${ENV_FILE:-}" && -f "$ENV_FILE" ]]; then
      ENV_FILES=("$ENV_FILE")
    fi
    for f in "${ENV_FILES[@]}"; do
      if [[ ! -f "$f" ]]; then
        echo "Error: Env file not found: $f" >&2
        return 1
      fi
    done

    # 5) Stack name is required unless --dry-run
    if [[ "$DRY_RUN" -eq 0 && "${#ARGS[@]}" -lt 1 ]]; then
      echo "Usage: docker-swarm-compose [-f <file> ...] [--env-file <file> ...] [never|always|changed] <STACK_NAME>" >&2
      echo "       [--prune] [--dry-run|--config] [--show-warnings]" >&2
      return 1
    fi

    # Reject stray positionals instead of silently misusing them.
    if [[ "${#ARGS[@]}" -gt 1 ]]; then
      echo "Error: only one STACK_NAME is allowed (got: ${ARGS[*]})" >&2
      return 1
    fi

    # 6) Re-assign positional params to what's in ARGS
    set -- "${ARGS[@]}"

    # 7) Extract stack name (optional in dry-run)
    local STACK_NAME="${1:-dry-run}"

    # 8) Swarm preflight: deploy needs an active manager (skip in dry-run)
    if [[ "$DRY_RUN" -eq 0 ]]; then
      local swarm_state
      swarm_state="$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null || true)"
      if [[ "$swarm_state" != "active" ]]; then
        echo "Error: Docker Swarm is not active on this node (state: ${swarm_state:-unknown})." >&2
        echo "       Initialize or join a swarm before deploying." >&2
        return 1
      fi
    fi

    if [[ "$DRY_RUN" -eq 0 ]]; then
      echo "Deploying stack '$STACK_NAME' with files: ${COMPOSE_FILES[*]} :: [resolve=$RESOLVE_IMAGE]"
    else
      echo "Rendering config for files: ${COMPOSE_FILES[*]} :: [resolve=$RESOLVE_IMAGE]"
    fi

    # 9) Build the '-f file' args for docker compose
    local FILE_ARGS=()
    for f in "${COMPOSE_FILES[@]}"; do
      FILE_ARGS+=(-f "$f")
    done

    local ENV_ARGS=()
    for f in "${ENV_FILES[@]}"; do
      ENV_ARGS+=(--env-file "$f")
    done

    local DEPLOY_ARGS=(--resolve-image="$RESOLVE_IMAGE" --with-registry-auth --detach=false)
    if [[ "$PRUNE" -eq 1 ]]; then
      DEPLOY_ARGS+=(--prune)
    fi
    DEPLOY_ARGS+=(--compose-file - "$STACK_NAME")

    local TMP_STDERR
    TMP_STDERR="$(mktemp)" || return 1

    # Single source of truth for the compose -> swarm sanitization. Both the
    # dry-run (config) and deploy paths use this, so the conversions never
    # drift apart.
    local -a sanitize_sed=(
      -e 's|cpus: \([0-9]\+\(\.[0-9]\+\)*\)|cpus: "\1"|'
      -e '1{/^name:/d}'
      -e '1{/^version:/d}'
      -e 's/published: "\(.*\)"/published: \1/'
      -e 's|mode: "\([0-9]\+\)"|mode: \1|'
    )

    local rc=0
    if [[ "$DRY_RUN" -eq 1 ]]; then
      (
        set -o pipefail
        docker compose "${ENV_ARGS[@]}" --compatibility "${FILE_ARGS[@]}" config 2>"$TMP_STDERR" |
          sed "${sanitize_sed[@]}"
      )
      rc=$?
    else
      (
        set -o pipefail
        docker compose "${ENV_ARGS[@]}" --compatibility "${FILE_ARGS[@]}" config 2>"$TMP_STDERR" |
          sed "${sanitize_sed[@]}" |
          docker stack deploy "${DEPLOY_ARGS[@]}"
      )
      rc=$?
    fi

    # Filter known benign compose/swarm warnings; keep real errors.
    if [[ "$SHOW_WARNINGS" -eq 0 ]]; then
      grep -v -E 'level=warning.*(Swarm (services|mode|scheduler)|routing mesh|not supported outside Swarm mode|rolling updates in Swarm mode)|Ignoring unsupported options:' "$TMP_STDERR" >&2 || true
    else
      cat "$TMP_STDERR" >&2
    fi

    rm -f "$TMP_STDERR"
    return "$rc"
  }

  docker-context() {
    if [ "$#" -lt 2 ]; then
      echo "Usage: $0 <CONTEXT-NAME> <SSH-HOST>"
      return 1
    fi
    docker context create "$1" --docker "host=ssh://$2"
  }

  # shellcheck disable=SC2139
  vm_quick_docker_ubuntu() {
    local ubuntu_version tmp_folder
    ubuntu_version=${1:-26.04}
    tmp_folder="${HOME}/.tmp/docker-$(date +'%Y-%m-%d')"
    mkdir -p "$tmp_folder"
    docker run -it --rm --network host --user root -v "$tmp_folder":/tmp/docker --name="ubuntu-server-$ubuntu_version" "ubuntu:$ubuntu_version"
  }
fi

### KUBERNETES ###
if check_command_q helm; then
  alias h='helm'
fi
if check_command_q kubectl; then
  alias k='kubectl'
  alias kn='k config set-context --current --namespace'
  alias ka='kubectl apply -f'
  alias kg='kubectl get'
  alias kd='kubectl describe'
  alias kdel='kubectl delete'
  alias kl='kubectl logs -f'
  alias kgpo='kubectl get pod'
  alias kgd='kubectl get deployments'
  alias ke='kubectl exec -it'
  alias kcns='kubectl config set-context --current --namespace'
fi
check_command_q kubectx && alias kc='kubectx'
check_command_q kubens && alias kns='kubens'

### TERRAFORM ###
check_command_q terraform && alias tf='terraform'

######################################################################
##
## OpenShift: (oc) Helper Functions
##
######################################################################
if check_command_q oc; then
  # Alias to quickly view the current project
  alias ocp='oc project'

  # Switch projects interactively using fzf
  vm_oc_switch() {
    local project
    project=$(oc projects -q | fzf --prompt="Select project: ")
    if [ -z "$project" ]; then
      echo "No project selected."
      return 1
    fi
    oc project "$project"
  }

  # Follow logs for a selected pod (interactive selection via fzf)
  vm_oc_logs() {
    local pod
    pod=$(oc get pods --no-headers 2>/dev/null | fzf --prompt="Select pod for logs: " | awk '{print $1}')
    if [ -z "$pod" ]; then
      echo "No pod selected."
      return 1
    fi
    oc logs -f "$pod"
  }

  vm_oc_logs_search() {
    local pod container containers

    # Select a pod using fzf
    pod=$(oc get pods --no-headers 2>/dev/null | fzf --prompt="Select pod for logs: " | awk '{print $1}')
    if [ -z "$pod" ]; then
      echo "No pod selected."
      return 1
    fi

    # Check if the selected pod has multiple containers and prompt for one if so.
    containers=$(oc get pod "$pod" -o jsonpath='{.spec.containers[*].name}' 2>/dev/null)
    if [ "$(echo "$containers" | wc -w)" -gt 1 ]; then
      container=$(echo "$containers" | tr ' ' '\n' | fzf --prompt="Select container: ")
    fi

    echo "Streaming logs for pod '$pod'${container:+ (container: $container)}. Press Ctrl-C to exit."

    # Tail the logs and pipe them to fzf for interactive searching.
    if [ -n "$container" ]; then
      oc logs -f "$pod" -c "$container" 2>&1 | fzf --ansi --cycle
    else
      oc logs -f "$pod" 2>&1 | fzf --ansi --cycle
    fi
  }

  # Open an interactive shell in a selected pod's container
  vm_oc_shell() {
    local pod container containers
    pod=$(oc get pods --no-headers 2>/dev/null | fzf --prompt="Select pod for shell: " | awk '{print $1}')
    if [ -z "$pod" ]; then
      echo "No pod selected."
      return 1
    fi

    # Retrieve container names for the pod
    containers=$(oc get pod "$pod" -o jsonpath='{.spec.containers[*].name}')
    if [[ $(echo "$containers" | wc -w) -gt 1 ]]; then
      container=$(echo "$containers" | tr ' ' '\n' | fzf --prompt="Select container: ")
    fi

    # Try bash first, fallback to sh if bash is unavailable
    if [ -n "$container" ]; then
      oc exec -it "$pod" -c "$container" -- bash 2>/dev/null || oc exec -it "$pod" -c "$container" -- sh
    else
      oc exec -it "$pod" -- bash 2>/dev/null || oc exec -it "$pod" -- sh
    fi
  }

  # Describe a resource interactively.
  vm_oc_describe() {
    local resource_type resource

    # List of common resource types. Extend this list as needed.
    local resource_types=("pods" "svc" "deployment" "dc" "route" "configmap" "secret" "pvc" "buildconfig")

    resource_type=$(printf "%s\n" "${resource_types[@]}" | fzf --prompt="Select resource type: ")
    if [ -z "$resource_type" ]; then
      echo "No resource type selected."
      return 1
    fi

    resource=$(oc get "$resource_type" --no-headers 2>/dev/null | fzf --prompt="Select $resource_type: " | awk '{print $1}')
    if [ -z "$resource" ]; then
      echo "No $resource_type selected."
      return 1
    fi

    oc describe "$resource_type" "$resource"
  }

  # Additional example: Follow logs for a deployment config (dc)
  vm_oc_dc_logs() {
    local dc
    dc=$(oc get dc --no-headers 2>/dev/null | fzf --prompt="Select deployment config: " | awk '{print $1}')
    if [ -z "$dc" ]; then
      echo "No deployment config selected."
      return 1
    fi
    oc logs -f dc/"$dc"
  }
fi

######################################################################
##
## MultiPass: create and remove multipass ubuntu VM
##
######################################################################
if check_command_q multipass; then
  vm_quick_multipass_ubuntu() {
    if [[ -z "$1" ]]; then
      echo "Usage: $0 <VM_NAME_VERSION> [<optional post-creation command>]"
      return 1
    fi

    TMP_CLOUD_INIT=~/vm_quick_ubuntu_cloud_init.yaml
    {
      echo '#cloud-config'
      echo 'packages_update: true'
      echo 'packages_upgrade: true'
      echo 'packages:'
      echo '  - cowsay'
      echo '  - neofetch'
      echo 'ssh_authorized_keys:'
      echo '  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJOBsi+JPb9GLFKA83kRpaphBrvb2uM9r0U0S+SPx1Mo ansible-admin'
    } >"$TMP_CLOUD_INIT"

    # Clean up VM name by removing dots and replacing colons with hyphens
    VM_NAME_VERSION=$(echo "$1" | sed 's|\.||g' | tr ':' '-')

    # Launch the VM with multipass
    multipass launch "$1" -n "ubuntu-$VM_NAME_VERSION" -c 2 -d 16G -m 4G --cloud-init "$TMP_CLOUD_INIT" || {
      echo "Failed to launch VM."
      rm "$TMP_CLOUD_INIT"
      return 1
    }

    # Remove cloud-init file after VM creation
    rm "$TMP_CLOUD_INIT"

    # Run an optional post-creation command, default to 'neofetch' if not provided
    multipass exec "ubuntu-$VM_NAME_VERSION" -- sh -c "${2:-neofetch}"
  }

  vm_quick_multipass_ubuntu_rm() {
    if [[ -z "$1" ]]; then
      echo "Usage: $0 <VM_NAME_VERSION>"
      return 1
    fi

    # Clean up VM name
    VM_NAME_VERSION=$(echo "$1" | sed 's|\.||g' | tr ':' '-')

    # Stop, delete, and purge the VM
    multipass stop "ubuntu-$VM_NAME_VERSION" || {
      echo "Failed to stop VM."
      return 1
    }
    multipass delete "ubuntu-$VM_NAME_VERSION" || {
      echo "Failed to delete VM."
      return 1
    }
    multipass purge || {
      echo "Failed to purge VM resources."
      return 1
    }

    # Show current list of VMs
    multipass list
  }
fi
