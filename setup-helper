# SERVICE :: check if new version available ------------------------------------
check_for_newer_tag() {
  local repo_url="$1"
  local current_tag="$2"
  local tag_filter="${3:-}"
  # Where to read the newest version from: 'tags' for tools installed with
  # 'git clone && git checkout <tag>', 'releases' for tools installed from
  # /releases/latest. The two can diverge - anomalyco/opencode tags v2.x while
  # only releasing v1.18.x - so comparing against the wrong one reports a
  # version the install path never actually provides.
  local latest_from="${4:-tags}"

  require_cmds curl jq || return 1

  # Derive owner/repo from URL (https://github.com/owner/repo[.git])
  local repo_name
  if [[ "$repo_url" =~ ^https://github\.com/([^/]+)/([^/]+)$ ]]; then
    repo_name="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    repo_name="${repo_name%.git}"
  else
    print_error "❌ Could not parse GitHub repository path from URL: $repo_url"
    return 1
  fi

  # Fetch all tags via GitHub API
  local tags_json
  if [[ "$latest_from" == "releases" ]]; then
    tags_json=$(github_api "https://api.github.com/repos/$repo_name/releases?per_page=100")
  else
    tags_json=$(github_api "https://api.github.com/repos/$repo_name/tags")
  fi

  if [[ -z $tags_json ]]; then
    print_error "⚠️ No response from GitHub API for $repo_name."
    return 0
  fi

  # Validate response is a JSON array (GitHub returns an error object instead)
  if ! echo "$tags_json" | jq -e 'type == "array"' >/dev/null 2>&1; then
    local api_error
    api_error=$(echo "$tags_json" | jq -r '.message // "unknown error"' 2>/dev/null)
    print_error "⚠️ GitHub API error for $repo_name: $api_error"
    return 0
  fi

  # Extract tag names. Release checks ignore prereleases: a beta tag sorts
  # above the current stable version and would report a downgrade-to-beta as
  # an available update.
  local tags
  if [[ "$latest_from" == "releases" ]]; then
    tags=$(echo "$tags_json" | jq -r '.[] | select(.prerelease == false) | .tag_name')
  else
    tags=$(echo "$tags_json" | jq -r '.[].name')
  fi

  # Handle tag filtering
  if [[ -n $tag_filter ]]; then
    if [[ $tag_filter == -* ]]; then
      # Exclude tags matching the pattern
      local exclude_filter="${tag_filter:1}"
      tags=$(echo "$tags" | grep -Ev -- "$exclude_filter" || true)
    else
      # Include only matching tags
      tags=$(echo "$tags" | grep -E -- "$tag_filter" || true)
    fi
  fi

  # Determine the latest tag by version-sort
  local latest_tag
  latest_tag=$(echo "$tags" | sort -V | tail -n1)

  # Fallback: no matching tags → try latest release
  if [[ -z $latest_tag || $latest_tag == "null" ]]; then
    local release_json
    release_json=$(github_api "https://api.github.com/repos/$repo_name/releases/latest")
    latest_tag=$(echo "$release_json" | jq -r '.tag_name' 2>/dev/null)
    # Ensure the release tag matches the filter (if it's an inclusion filter)
    if [[ -n $tag_filter && $tag_filter != -* && ! $latest_tag =~ $tag_filter ]]; then
      print_info2 "⚠️ No releases matching filter '$tag_filter' for $repo_name."
      return 0
    fi
    # If exclusion filter, skip if it matches the exclusion
    if [[ -n $tag_filter && $tag_filter == -* && $latest_tag =~ ${tag_filter:1} ]]; then
      print_info2 "⚠️ Latest release '$latest_tag' excluded by filter '$tag_filter'."
      return 0
    fi
  fi

  # Final validation
  if [[ -z $latest_tag || $latest_tag == "null" ]]; then
    print_error "⚠️ No tags or releases found for $repo_name."
    return 0
  fi

  # Compare and report
  if [[ $current_tag != "$latest_tag" ]]; then
    print_info2 "⬆️ A newer version for '$repo_name' is available: $latest_tag (current: $current_tag)"
    print_info2 "    https://github.com/$repo_name/releases/tag/$latest_tag"
  else
    print_info2 "✅ You already have the latest version for '$repo_name': $current_tag"
  fi
}

# Returns 0 when "$1" sorts at or above "$2" (version-sort).
version_ge() {
  local have="$1" need="$2"
  [[ "$(printf '%s\n%s\n' "$have" "$need" | sort -V | head -n1)" == "$need" ]]
}

# Zig does not tag releases on GitHub (the newest tag there is 0.15.2), so its
# version is read from the official download index instead.
check_for_newer_zig() {
  local current_version="$1"

  require_cmds curl jq || return 1

  local index_json
  index_json=$(curl -sL "https://ziglang.org/download/index.json") || {
    print_error "⚠️ Could not fetch https://ziglang.org/download/index.json."
    return 0
  }

  local latest_version
  latest_version=$(echo "$index_json" | jq -r 'keys[] | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))' | sort -V | tail -n1)

  if [[ -z "$latest_version" ]]; then
    print_error "⚠️ No Zig release version found on ziglang.org."
    return 0
  fi

  if [[ "$current_version" != "$latest_version" ]]; then
    print_info2 "⬆️ A newer Zig version is available: $latest_version (current: $current_version)"
    print_info2 "    https://ziglang.org/download/#release-${latest_version}"
  else
    print_info2 "✅ You already have the latest Zig version: $current_version"
  fi
}

