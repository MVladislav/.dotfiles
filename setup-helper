# HELPERS :: create symlink ----------------------------------------------------
create_symlink() {
  local target="$1" link_name="$2"
  mkdir -p "$(dirname "$link_name")"
  rm -f "$link_name"
  ln -sf "$target" "$link_name"
}

# HELPERS :: link a repo path and report it ------------------------------------
# Prints the "linking <src> -> <dst>" line and creates the symlink. <src> is
# shown relative to the repository root. Args: <label> <src> <dst>
link_config() {
  local label="$1" src="$2" dest="$3"
  print_info2 "🔗 $label :: linking ${src#"$PWD"/} -> $dest"
  create_symlink "$src" "$dest"
}

# HELPERS :: copy config -------------------------------------------------------
copy_config() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  rm -f "$dest"
  cp -f "$src" "$dest"
}

# HELPERS :: run if flag set ---------------------------------------------------
run_if() {
  local flag=$1
  [[ $flag -eq 1 ]]
}

# HELPERS :: sudo drop ---------------------------------------------------------
sudo_drop() {
  [[ $IS_SUDO_INSTALL -eq 1 ]] && sudo -k
}

# HELPERS :: clone at pinned version -------------------------------------------
# Clone <repo> into <dir> and, when building from a release, check out <version>.
clone_repo() {
  local repo="$1" dir="$2" version="${3:-}"
  rm -rf "$dir" 1>/dev/null
  git clone -q "$repo" "$dir"
  if [[ $INSTALL_SOURCE_FROM == 'release' && -n "$version" ]]; then
    git -C "$dir" checkout -q "$version"
  fi
}

# HELPERS :: install udev rules ------------------------------------------------
# Install <src> to <dst> with sudo when available; otherwise print the manual
# commands. Remaining args are passed to 'udevadm trigger'. Separate multiple
# trigger calls with '--trigger' (for example
# --subsystem-match=hidraw --trigger --subsystem-match=input).
install_udev_rules() {
  local src="$1" dst="$2"
  shift 2

  local -a trigger_sets=() current=()
  local arg trigger
  for arg in "$@"; do
    if [[ $arg == '--trigger' ]]; then
      ((${#current[@]})) && trigger_sets+=("${current[*]}")
      current=()
    else
      current+=("$arg")
    fi
  done
  ((${#current[@]})) && trigger_sets+=("${current[*]}")

  [[ -f "$src" ]] || { print_notes "   ⚠️ udev rules source not found: $src"; return 0; }
  if [[ -n "$RUN_WITH_SUDO" ]] && sudo -n true 2>/dev/null; then
    print_notes "   📌 installing udev rules -> $dst (sudo)"
    $RUN_WITH_SUDO install -Dm644 "$src" "$dst"
    if command -v udevadm >/dev/null 2>&1; then
      $RUN_WITH_SUDO udevadm control --reload-rules
      for trigger in "${trigger_sets[@]}"; do
        # trigger holds a pre-validated flag group; splitting it is intended.
        # shellcheck disable=SC2086
        $RUN_WITH_SUDO udevadm trigger $trigger || true
      done
      $RUN_WITH_SUDO udevadm settle || true
    fi
    sudo_drop
    print_notes "   ✅ udev rules installed ($dst)"
  else
    print_notes "   ⚠️ sudo not usable non-interactively; skipping udev rules."
    print_notes "   💡 root must install them manually:"
    print_notes "      sudo install -Dm644 '$src' '$dst'"
    if ((${#trigger_sets[@]} > 0)); then
      print_notes "      sudo udevadm control --reload-rules"
      for trigger in "${trigger_sets[@]}"; do
        print_notes "      sudo udevadm trigger $trigger"
      done
    fi
  fi
}

# HELPERS :: refresh desktop/icon caches ---------------------------------------
refresh_desktop_caches() {
  local icons="${1:-}" apps="${2:-}"
  if [[ -n "$icons" ]] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -qtf "$icons" || true
  fi
  if [[ -n "$apps" ]] && command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q "$apps" || true
  fi
}

# HELPERS :: fzf single select -------------------------------------------------
# Print one selected line. ESC/abort returns 130.
# Args: $1 list, $2 header, $3 prompt, $4 (optional) initial --query string.
fzf_select() {
  local list="$1" header="$2" prompt="$3" query="${4:-}"
  [[ -n "$list" ]] || return 0
  local args=(--sync --height=~40% --cycle --border --header "$header" --prompt "$prompt")
  [[ -n "$query" ]] && args+=(--query "$query")
  local out rc=0
  out=$(echo "$list" | fzf "${args[@]}") || rc=$?
  [[ $rc -eq 130 ]] && return 130
  [[ $rc -ne 0 ]] && return "$rc"
  printf '%s\n' "$out"
}

# HELPERS :: fzf multi-select of "name:description" lines ----------------------
# Prints the selected names (text before the first colon). ESC/abort returns
# 130 so callers can skip without tripping 'set -e'.
# Args: prompt, footer, select-all ("select-all" or empty), then the items.
fzf_multi_select() {
  local prompt="$1" footer="$2" select_all="$3"
  shift 3
  [[ $# -gt 0 ]] || return 0
  local bind=()
  [[ "$select_all" == "select-all" ]] && bind=(--bind 'start:select-all+down')
  local out rc=0
  out=$(printf '%s\n' "$@" | fzf --height=~40% --multi --cycle --border \
    "${bind[@]}" --prompt="$prompt" --preview-window=hidden \
    --footer="$footer" | awk -F: '{print $1}') || rc=$?
  [[ $rc -eq 130 ]] && return 130
  [[ $rc -ne 0 ]] && return "$rc"
  printf '%s\n' "$out" | sed '/^$/d'
}
