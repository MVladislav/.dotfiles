#!/usr/bin/env bash
PATH="/usr/bin/:/usr/local/bin/:/bin:/usr/sbin/:/sbin:/snap/bin/:$HOME/.local/bin"
set -euo pipefail
trap 'echo -e "${BRED}ERROR: Unexpected error on line $LINENO (command: $BASH_COMMAND).${NC}" >&2' ERR

# ******************************************************************************

RUN_WITH_SUDO=''
IS_SUDO_INSTALL=0
if command -v sudo &>/dev/null; then
  RUN_WITH_SUDO=sudo
  IS_SUDO_INSTALL=1
fi

# ******************************************************************************

# COLOR ------------------------------------------------------------------------
# https://stackoverflow.com/questions/5947742/how-to-change-the-output-color-of-echo-in-linux)
NC='\033[0m'         # No Color
BRED='\033[1;31m'    # Red
BPURPLE='\033[1;35m' # Purple
BYELLOW='\033[1;33m' # Yellow
BCYAN='\033[1;36m'   # Cyan

# ******************************************************************************

VM_SEC_TMP="${VM_SEC_TMP:-"$HOME/.tmp"}" # /tmp

# shellcheck disable=SC2034
DEPS_INSTALL_PATH="${VM_SEC_TMP}"
USER_LOCAL_PREFIX="${HOME}/.local"
USER_LOCAL_PREFIX_BIN="$USER_LOCAL_PREFIX/bin"

DEPS_PACKAGES_TO_REMOVE=()

# apt env: `env` runs as the sudo'ed command so these actually reach apt. sudo
# strips the environment; without them debconf opens a dialog and maintainer
# scripts reprint the perl locale warnings.
APT_ENV=(env DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true LC_ALL=C)

# shellcheck disable=SC2034
INSTALL_SOURCE_FROM=release # source | release

# ******************************************************************************

print_info() { echo -e "${BPURPLE}$1${NC}"; }
print_info2() { echo -e "${BYELLOW}$1${NC}"; }
print_read() { printf "%b%s%b" "${BYELLOW}" "$1" "${NC}"; }
print_notes() { echo -e "${BCYAN}$1${NC}"; }
print_warn() { echo -e "${BYELLOW}$1${NC}" >&2; }
print_error() { echo -e "${BRED}$1${NC}" >&2; }

# HELPERS :: print section divider ---------------------------------------------
print_section() {
  echo -e "\n${BCYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  print_info2 "  $1"
  echo -e "${BCYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""
}

# HELPERS :: print section footer ----------------------------------------------
print_section_end() {
  echo ""
  print_info2 "$1"
  echo -e "${BCYAN}################################################################${NC}"
}

# HELPERS :: fzf preselect bind -------------------------------------------------
# Build a --bind "start:..." string that pre-toggles the given defaults.
# List lines are matched exactly, so the default names can appear anywhere.
fzf_preselect_bind() {
  local list="$1" defaults="$2"
  local bind="start:"
  local def line
  for def in $defaults; do
    line=$(echo "$list" | grep -Fnx -- "$def" | cut -d: -f1 || true)
    [[ -n "$line" ]] && bind+="pos($line)+toggle+"
  done
  [[ "$bind" == "start:" ]] && return 0
  echo "${bind}pos(1)"
}

# HELPERS :: fzf multiselect ----------------------------------------------------
# Run a multi-select fzf prompt. Prints the selected lines; empty when nothing
# was chosen. ESC/abort (exit 130) is returned to the caller, NOT treated as an
# error - otherwise 'set -euo pipefail' in the caller kills the script.
# Args: $1 list (newline-joined), $2 space-separated preselect defaults,
#       $3 header, $4 prompt, $5 (optional) preview command ({} = current line),
#       $6 (optional) initial --query string.
fzf_pick() {
  local list="$1" defaults="$2" header="$3" prompt="$4" preview="${5:-}" query="${6:-}"
  local preselect_bind=() bind_value
  bind_value=$(fzf_preselect_bind "$list" "$defaults")
  [[ -n "$bind_value" ]] && preselect_bind=(--bind "$bind_value")

  local args=(--sync --height=~40% --multi --cycle --border
    "${preselect_bind[@]}" --header "$header" --prompt "$prompt")
  [[ -n "$preview" ]] && args+=(--preview "$preview")
  [[ -n "$query" ]] && args+=(--query "$query")

  local out rc
  out=$(echo "$list" | fzf "${args[@]}") || rc=$?
  [[ ${rc:-0} -eq 130 ]] && return 130
  [[ ${rc:-0} -ne 0 ]] && return "${rc:-1}"
  echo "$out"
}

# ******************************************************************************

# HELPERS :: require commands --------------------------------------------------
require_cmds() {
  local missing=() cmd
  for cmd in "$@"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done
  [[ ${#missing[@]} -eq 0 ]] && return 0
  print_error "❌ Required commands not found: ${missing[*]}"
  return 1
}

# HELPERS :: package installed? ------------------------------------------------
is_package_installed() {
  dpkg-query -s "$1" 2>/dev/null | grep -q '^Status: .* installed$'
}

# HELPERS :: apt update --------------------------------------------------------
apt_update() {
  if ! run_quiet_hint "   ⏳ refreshing package lists (sudo may ask for your password)..." \
    $RUN_WITH_SUDO "${APT_ENV[@]}" apt-get update -qqq; then
    print_error "❌ Failed to update package list"
    return 1
  fi
}

# HELPERS :: apt install -------------------------------------------------------
# Install packages non-interactively. The hint is printed first because a quiet
# sudo/apt step that takes a minute otherwise reads as a hang.
# Args: <hint> <package...>
apt_install() {
  local hint="$1"
  shift
  (($# > 0)) || return 0

  if ! run_quiet_hint "$hint" $RUN_WITH_SUDO "${APT_ENV[@]}" apt-get install -y "$@"; then
    print_error "❌ Failed to install packages: $*"
    return 1
  fi
}

# HELPERS :: apt remove --------------------------------------------------------
# Remove packages, then drop their now-unused dependencies.
# Args: <hint> <package...>
apt_remove() {
  local hint="$1"
  shift
  (($# > 0)) || return 0

  if ! run_quiet_hint "$hint" $RUN_WITH_SUDO "${APT_ENV[@]}" apt-get remove -y "$@"; then
    print_error "❌ Failed to remove packages: $*"
    return 1
  fi
  run_quiet $RUN_WITH_SUDO "${APT_ENV[@]}" apt-get -y autoremove -qqq || true
  run_quiet $RUN_WITH_SUDO "${APT_ENV[@]}" apt-get -y autoclean -qqq || true
}

# HELPERS :: snap install -------------------------------------------------------
# Install a snap only when it is missing. `snap install` exits non-zero for an
# already-installed snap, which aborts the caller under `set -euo pipefail`.
# Refreshing installed snaps belongs to the update workflow, not to setup.
# Args: <snap> [snap install flags...]
snap_install() {
  local name="$1"
  shift
  if snap list "$name" >/dev/null 2>&1; then
    print_notes "   💡 snap '$name' already installed, skipping"
    return 0
  fi
  if ! run_quiet $RUN_WITH_SUDO snap install "$name" "$@"; then
    print_error "❌ Failed to install snap: $name"
    return 1
  fi
}

# HELPERS :: run a command quietly -----------------------------------------------
# Spew from apt, cmake and git is not the script talking, so it is captured to a
# temp log and shown only when the command actually fails. Usage:
#   run_quiet <command> [args...]
# REF: passes 2 = lines of log to show on failure.
run_quiet() {
  local log lines="${RUN_QUIET_TAIL_LINES:-20}" rc=0
  log=$(mktemp)
  "$@" >"$log" 2>&1 || rc=$?
  if ((rc == 0)); then
    rm -f "$log"
    return 0
  fi
  print_error "❌ command failed (exit $rc): $*"
  print_notes "   ↳ last $lines lines of output:"
  tail -n "$lines" "$log" | while IFS= read -r line; do
    print_notes "      $line"
  done
  print_notes "   ↳ full log: $log"
  return $rc
}

# HELPERS :: run a command quietly, with a "this may take a while" line --------
# Silence is fine for a fast command, but a quiet sudo/apt/build that takes a
# minute reads as a hang - and users assume the password prompt is broken. This
# prints the hint first, then behaves exactly like run_quiet.
run_quiet_hint() {
  local hint="$1"
  shift
  print_notes "   $hint"
  run_quiet "$@"
}

# Print the first line a command reports as its version, or 'not installed'.
# stdout wins and stderr is only read as a fallback, so a tool that logs noise
# to stderr still reports its real version. The 'not installed' fallback keeps
# a missing binary from surfacing as an empty '' in the output.
installed_version() {
  local version
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'not installed'
    return 0
  fi
  version=$("$@" 2>/dev/null)
  if [[ -z ${version//[[:space:]]/} ]]; then
    version=$("$@" 2>&1 >/dev/null)
  fi
  version=${version%%$'\n'*}
  # sed, not glob: in bash patterns '[0-9;]*' means one digit then *anything*,
  # which matches greedily across the version and eats it.
  [[ $version == *$'\e'* ]] && version=$(printf '%s' "$version" | sed $'s/\033\\[[0-9;]*m//g')
  version=${version#"${version%%[![:space:]]*}"}
  version=${version%"${version##*[![:space:]]}"}
  printf '%s' "$version"
}

# HELPERS :: github api --------------------------------------------------------
# Adds an Authorization header when GITHUB_TOKEN is set (raises rate limit to 5000/h)
github_api() {
  local url="$1"
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    curl -s -H "Authorization: Bearer $GITHUB_TOKEN" "$url"
  else
    curl -s "$url"
  fi
}

# ******************************************************************************

install_dependencies_needs() {
  DEPS_PACKAGES_TO_REMOVE=()

  local -n tools_ref="${1%\[@\]}"
  local -n build_ref="${2%\[@\]}"
  local packages_tools=("${tools_ref[@]}")
  local packages_build=("${build_ref[@]}")

  local packages_to_install=()
  local pkg

  # Check packages_tools: install if missing, but never mark for removal.
  for pkg in "${packages_tools[@]}"; do
    if ! is_package_installed "$pkg"; then
      packages_to_install+=("$pkg")
    fi
  done

  # Check packages_build: install if missing and add to removal list.
  for pkg in "${packages_build[@]}"; do
    if ! is_package_installed "$pkg"; then
      packages_to_install+=("$pkg")
      DEPS_PACKAGES_TO_REMOVE+=("$pkg")
    fi
  done

  # Nothing missing: one line and out, no sudo, no empty [ ] lists.
  if [[ ${#packages_to_install[@]} -eq 0 ]]; then
    print_notes "   📥 All dependencies already installed, skipping"
    return 0
  fi

  print_notes "   📥 Packages to install: [${packages_to_install[*]}]"
  [[ ${#DEPS_PACKAGES_TO_REMOVE[@]} -gt 0 ]] && print_notes "   📥 Packages to remove afterward: [${DEPS_PACKAGES_TO_REMOVE[*]}]"

  apt_update || return 1
  apt_install "   ⏳ installing build dependencies, this can take a minute..." "${packages_to_install[@]}" || return 1
  [[ $IS_SUDO_INSTALL -eq 1 ]] && sudo -k
  print_notes "   📥 Build dependencies installed"
}

install_dependencies_needs_rm() {
  if [[ ${#DEPS_PACKAGES_TO_REMOVE[@]} -eq 0 ]]; then
    print_notes "   📥 No packages to remove."
    return 0
  fi

  print_notes "   📥 Removing build dependencies: [${DEPS_PACKAGES_TO_REMOVE[*]}]..."
  apt_remove "   ⏳ removing packages (sudo may ask for your password)..." "${DEPS_PACKAGES_TO_REMOVE[@]}" || return 1

  [[ $IS_SUDO_INSTALL -eq 1 ]] && sudo -k
  print_notes "   📥 Packages removed: [${DEPS_PACKAGES_TO_REMOVE[*]}]"
  DEPS_PACKAGES_TO_REMOVE=()
}

# PY :: install a PyPI package into the user prefix ----------------------------
install_python_package() {
  local package="$1"
  local command_name="$2"
  local min_version="${3:-}"
  local current_version

  current_version="$("$command_name" --version 2>/dev/null | grep -Eo '[0-9]+(\.[0-9]+)+' | head -n1 || true)"

  if [[ -n "$min_version" && -n "$current_version" ]] && version_ge "$current_version" "$min_version"; then
    print_notes "   💡 $command_name $current_version already satisfies $package >= $min_version"
    return 0
  fi

  if command -v uv >/dev/null 2>&1; then
    print_notes "   📦 installing $package with 'uv tool'..."
    uv tool install --upgrade "$package" || {
      print_error "❌ PY :: 'uv tool install $package' failed."
      return 1
    }
  elif command -v pip3 >/dev/null 2>&1; then
    print_notes "   📦 installing $package with pip..."
    python3 -m pip install --user --break-system-packages --upgrade "$package" || {
      print_error "❌ PY :: 'pip install $package' failed."
      return 1
    }
  else
    print_error "❌ PY :: install 'uv' (./setup -idev) or 'python3-pip' to install $package."
    return 1
  fi

  if ! command -v "$command_name" >/dev/null 2>&1; then
    print_error "❌ PY :: $command_name not found after installing $package."
    return 1
  fi
  current_version="$("$command_name" --version 2>/dev/null | grep -Eo '[0-9]+(\.[0-9]+)+' | head -n1 || true)"
  print_notes "   💡 $command_name ${current_version:-version unknown}"
}

download_github_binary() {
  # "Usage: download_github_binary <repo_url> <binary_regex> [output_dir]"
  local repo_url="$1"
  local binary_regex="$2"
  local out_dir="${3:-$USER_LOCAL_PREFIX_BIN}"

  if [[ -z "$repo_url" || -z "$binary_regex" ]]; then
    print_error "❌ Missing argument."
    return 1
  fi

  require_cmds file curl jq || return 1

  # Extract owner/repo from URL
  local repo_path
  if [[ "$repo_url" =~ ^https://github\.com/([^/]+)/([^/]+)$ ]]; then
    local owner="${BASH_REMATCH[1]}"
    local repo="${BASH_REMATCH[2]}"
    repo="${repo%.git}"
    repo_path="${owner}/${repo}"
  else
    print_error "❌ Could not parse GitHub repository path from URL."
    return 1
  fi

  print_info2 "🚀 BINARY :: Fetching latest release for '$repo_path'..."

  # Get the asset URL matching regex
  local api_url="https://api.github.com/repos/$repo_path/releases/latest"
  local release_json
  release_json=$(github_api "$api_url") || {
    print_error "   ❌ Failed to fetch GitHub-api '$api_url'."
    return 1
  }

  # Validate response is a JSON object with assets (GitHub returns an error object instead)
  if ! echo "$release_json" | jq -e 'type == "object" and has("assets")' >/dev/null 2>&1; then
    local api_error
    api_error=$(echo "$release_json" | jq -r '.message // "unknown error"' 2>/dev/null)
    print_error "   ❌ GitHub API error for '$repo_path': $api_error"
    return 1
  fi

  local asset_url
  asset_url=$(echo "$release_json" | jq -r --arg regex "$binary_regex" '
    .assets[] | select(.name | test($regex)) | .browser_download_url
  ' 2>/dev/null | head -n 1)

  if [[ -z "$asset_url" || "$asset_url" == "null" ]]; then
    print_error "   ❌ No asset matching regex '$binary_regex' found in latest release."
    return 1
  fi

  print_info2 "   🔍 Found asset '$asset_url'"

  # Create temp dir and download asset
  local tmp_dir
  tmp_dir=$(mktemp -d)
  local file_name="${asset_url##*/}"

  print_info2 "   ⬇️ Downloading to '$tmp_dir' dir..."
  curl -sL "$asset_url" -o "$tmp_dir/$file_name"

  mkdir -p "$out_dir"

  # Handle archive or direct binary
  local bin_path=
  if [[ "$file_name" == *.tar.gz || "$file_name" == *.tgz ]]; then
    print_info2 "   ⚙️ Extracting 'tar.gz'..."
    tar -xzf "$tmp_dir/$file_name" -C "$tmp_dir"
  elif [[ "$file_name" == *.zip ]]; then
    print_info2 "   ⚙️ Extracting 'zip'..."
    unzip -q "$tmp_dir/$file_name" -d "$tmp_dir"
  fi
  # Search for actual binary using `file` command
  bin_path=$(find "$tmp_dir" -type f | while read -r f; do
    if file "$f" | grep -qE 'ELF|Mach-O|PE32'; then
      echo "$f"
      break
    fi
  done)

  if [[ -z "$bin_path" ]]; then
    print_error "   ❌ No binary file detected in asset."
    return 1
  fi

  local bin_name
  bin_name=$(basename "$bin_path")

  print_info2 "   📌 Installing '$bin_name' to '$out_dir'..."
  mv "$bin_path" "$out_dir/$bin_name"
  chmod 755 "$out_dir/$bin_name"

  # Cleanup
  rm -rf "$tmp_dir"

  print_info2 "🚀 BINARY :: '$repo_path : $bin_name' installed!"
}

