# SETUP :: zsh -----------------------------------------------------------------
# NOTE: runs inside 'install_zsh'
setup_zsh() {
  print_info2 "\n📦 ZSH :: loading git submodules"
  git submodule update -q --init --remote \
    zsh/themes/spaceship \
    zsh/plugins/zsh-autosuggestions \
    zsh/plugins/zsh-syntax-highlighting \
    zsh/plugins/zsh-history-substring-search

  print_info2 "🔗 ZSH :: linking zsh/themes/* -> $LN_ZSH/custom/themes/*"
  create_symlink "${PWD}/zsh/themes/spaceship/spaceship.zsh-theme" "$LN_ZSH/custom/themes/spaceship.zsh-theme"
  print_info2 "🔗 ZSH :: linking zsh/plugins/* -> $LN_ZSH/custom/plugins/*"
  create_symlink "${PWD}/zsh/plugins/zsh-autosuggestions" "$LN_ZSH/custom/plugins/zsh-autosuggestions"
  create_symlink "${PWD}/zsh/plugins/zsh-syntax-highlighting" "$LN_ZSH/custom/plugins/zsh-syntax-highlighting"
  create_symlink "${PWD}/zsh/plugins/zsh-history-substring-search" "$LN_ZSH/custom/plugins/zsh-history-substring-search"

  print_info2 "🔗 ZSH :: linking zsh/zshrc -> $LN_ZSHRC"
  create_symlink "${PWD}/zsh/zshrc" "${LN_ZSHRC}"
  print_info2 "✅ ZSH :: symlinks created."
}

