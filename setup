# CODE :: install extensions ---------------------------------------------------
install_code_ext() {
  if command -v code >/dev/null 2>&1; then
    print_info2 "\n📦 CODE :: installing VS Code extensions"

    # james-yu.latex-workshop  ms-vscode.live-server ryanluker.vscode-coverage-gutters
    # "github.copilot" "github.copilot-chat"
    # "ms-python.debugpy" "ms-python.mypy-type-checker" "ms-python.vscode-pylance" "ms-python.vscode-python-envs"
    # "astral-sh.ty" "donjayamanne.githistory"
    VS_CODE_EXTS=(
      "aaron-bond.better-comments" "adpyke.vscode-sql-formatter" "analytic-signal.preview-pdf"
      "bibhasdn.unique-lines" "bierner.markdown-preview-github-styles" "charliermarsh.ruff"
      "eamodio.gitlens" "esbenp.prettier-vscode" "foxundermoon.shell-format"
      "ms-python.python" "mushan.vscode-paste-image" "pkief.material-icon-theme" "redhat.ansible"
      "redhat.vscode-xml" "redhat.vscode-yaml" "samuelcolvin.jinjahtml" "silofy.hackthebox"
      "streetsidesoftware.code-spell-checker" "streetsidesoftware.code-spell-checker-german" "tamasfe.even-better-toml"
      "timonwong.shellcheck" "wayou.vscode-todo-highlight" "yzane.markdown-pdf" "yzhang.markdown-all-in-one"
    )

    for vs_code_ext in "${VS_CODE_EXTS[@]}"; do
      print_info2 "  📌 installing extension '$vs_code_ext'"
      code --force --install-extension "$vs_code_ext" 1>/dev/null || true
    done
  else
    print_error "❌ CODE :: code not found, extension install skipped!"
  fi
}

# FONTS :: install -------------------------------------------------------------
install_fonts() {
  print_info2 "\n📦 FONTS :: downloading fonts"

  # Define packages needed for build and install
  # shellcheck disable=SC2034
  local packages_tools=()
  # shellcheck disable=SC2034
  local packages_build=(curl file unzip)
  install_dependencies_needs packages_tools[@] packages_build[@]

  FONTS_URLS=(
    "${VERSION_FONTS_REPO}/releases/download/${VERSION_FONTS_RELEASE}/NerdFontsSymbolsOnly.tar.xz"
    "${VERSION_FONTS_REPO}/releases/download/${VERSION_FONTS_RELEASE}/FiraCode.tar.xz"
    "${VERSION_FONTS_REPO}/releases/download/${VERSION_FONTS_RELEASE}/Hack.tar.xz"
    "${VERSION_FONTS_REPO}/releases/download/${VERSION_FONTS_RELEASE}/UbuntuMono.tar.xz"
    "${VERSION_FONTS_REPO}/releases/download/${VERSION_FONTS_RELEASE}/FiraMono.tar.xz"
    "${VERSION_FONTS_REPO}/releases/download/${VERSION_FONTS_RELEASE}/RobotoMono.tar.xz"
    "${VERSION_FONTS_REPO}/releases/download/${VERSION_FONTS_RELEASE}/ProggyClean.tar.xz"
    "https://github.com/fonsecapeter/brass_mono/releases/download/v1.101/BrassMono.zip"
  )
  local fonts_dir="$USER_LOCAL_PREFIX/share/fonts"

  for url in "${FONTS_URLS[@]}"; do
    file_name=$(basename "$url")
    temp_file="/tmp/$file_name"

    print_info2 "  ⬇️ downloading $file_name..."
    curl -sL -o "$temp_file" "$url" || {
      print_error "  ❌ failed to download $file_name"
      return 1
    }

    if [[ "$url" =~ github.com/([^/]+)/([^/]+) ]]; then
      repo_name="${BASH_REMATCH[2]}"
    else
      repo_name="custom-font"
    fi

    local repo_dir="$fonts_dir/$repo_name"
    mkdir -p "$repo_dir"

    archive_type=$(file --mime-type -b "$temp_file")

    print_info2 "  📦 extracting $file_name..."
    case "$archive_type" in
    application/x-xz) # .tar.xz
      tar -xf "$temp_file" -C "$repo_dir" || {
        print_error "  ❌ failed to extract $file_name"
        return 1
      }
      ;;
    application/zip) # .zip
      unzip -qo "$temp_file" -d "$repo_dir" || {
        print_error "  ❌ failed to extract $file_name"
        return 1
      }
      ;;
    *)
      print_error "  ❌ unsupported archive type: $archive_type for $file_name"
      return 1
      ;;
    esac

    rm "$temp_file"
  done

  install_dependencies_needs_rm

  print_info2 "✅ FONTS :: all fonts downloaded and extracted"
}

# ******************************************************************************

# CLI :: usage -----------------------------------------------------------------
usage() {
  print_info "\n📖 Usage: $0 [options]"
  print_info "   Symlink dotfiles and optionally install/update tools"
  print_info ""
  print_info "   🎯 Examples:"
  print_info "     $0                                           Only run config symlinks, no installations"
  print_info "     $0 -ifont                                     Run config symlinks + install fonts"
  print_info "     $0 -ds -invim                                 Install nvim only (no symlinks)"
  print_info "     $0 -itools -idev                              Install CLI tools + dev deps + symlinks"
  print_info "     $0 -it -invim -izsh -ighost                   Install nvim, zsh, ghostty + tools + symlinks"
  print_info "     $0 -upc                                       Check for newer versions of all tools"
  print_info ""
  print_info "   ⚙️ Install flags (enable tool installations):"
  print_info "     -itools    --install-additional-tools         CLI tools: curl, git, git-delta, jq, fzf, eza, bat, ripgrep, fd-find, ..."
  print_info "     -idev      --install-additional-dev           Dev tools: node, rust, go, shellcheck, lazygit, uv, prek"
  print_info "     -invim     --install-dependencies-nvim        Build and install neovim from source"
  print_info "     -itmux     --install-dependencies-tmux        Build and install tmux from source"
  print_info "     -izsh      --install-dependencies-zsh         Install zsh (source build with -s, else apt)"
  print_info "     -ighost    --install-dependencies-ghostty     Build and install ghostty terminal"
  print_info "     -ibtop     --install-btop                     Build and install btop system monitor"
  print_info "     -ibtop-amd --install-btop-amd                 btop with AMD GPU support (ROCm)"
  print_info "     -ibtop-intel --install-btop-intel             btop + Intel GPU support"
  print_info "     -ihunk     --install-hunk                     Install hunk git diff pager"
  print_info "     -iemu      --install-android-emulator         Interactive Android emulator setup"
  print_info "     -igh       --install-github-cli               Install GitHub CLI from releases"
  print_info "     -ice       --install-code-ext                 Install VS Code extensions"
  print_info "     -ifont     --install-fonts                    Download and install Nerd Fonts"
  print_info ""
  print_info "   🔗 Setup flags (symlink configs, enabled by default):"
  print_info "     -nsb       --not-setup-bin                    Skip linking ~/bin scripts"
  print_info "     -nsv       --not-setup-nvim                   Skip linking nvim config"
  print_info "     -nsz       --not-setup-zed                    Skip linking zed config"
  print_info "     -nsp       --not-setup-profiles               Skip linking shell profiles"
  print_info "     -nsg       --not-setup-gitconfig              Skip git config setup"
  print_info "     -nsgt      --not-setup-ghostty                Skip linking ghostty config"
  print_info "     -ds        --disable-setups                   Skip all symlink setups"
  print_info "     -stx       --setup-tmux                       Force tmux symlink setup"
  print_info "     -szh       --setup-zsh                        Force zsh symlink setup"
  print_info "     -scd       --setup-code                       Link VS Code config"
  print_info ""
  print_info "   🛠️ Meta flags:"
  print_info "     -h         --help                             Show this help"
  print_info "     -s                                             Build services from source (instead of release)"
  print_info "     -d         --debug                            Enable bash debug mode (set -x)"
  print_info "     -upc       --update-check                     Check all tools for newer versions"
  print_info ""
  print_info "   💡 Quick combos:"
  print_info "     -ioall     --install-dependencies-old-all     Install tmux + nvim + zsh + tools"
  print_info "     -inall     --install-dependencies-new-all     Install ghostty + nvim + tools"
}

# CLI :: parse args ------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
    -h | --help)
      usage
      exit 0
      ;;
    -itools | --install-additional-tools)
      RUN_INSTALL_DEPENDENCIES_ADDITIONAL=1
      ;;
    -idev | --install-additional-dev)
      RUN_INSTALL_DEPENDENCIES_DEV=1
      ;;
    -ighost | --install-dependencies-ghostty)
      RUN_INSTALL_GHOSTTY=1
      ;;
    -invim | --install-dependencies-nvim)
      RUN_INSTALL_NVIM=1
      ;;
    -izsh | --install-dependencies-zsh)
      RUN_INSTALL_ZSH=1
      ;;
    -itmux | --install-dependencies-tmux)
      RUN_INSTALL_TMUX=1
      ;;
    -ibtop | --install-btop)
      RUN_INSTALL_BTOP=1
      ;;
    -ibtop-amd | --install-btop-amd)
      RUN_INSTALL_BTOP=1
      RUN_INSTALL_BTOP_AMD=1
      ;;
    -ibtop-intel | --install-btop-intel)
      RUN_INSTALL_BTOP=1
      RUN_INSTALL_BTOP_INTEL=1
      ;;
    -ihunk | --install-hunk)
      RUN_INSTALL_HUNK=1
      ;;
    -iemu | --install-android-emulator)
      RUN_INSTALL_ANDROID=1
      ;;
    -ioall | --install-dependencies-old-all)
      RUN_INSTALL_DEPENDENCIES_ADDITIONAL=1
      RUN_INSTALL_TMUX=1
      RUN_INSTALL_NVIM=1
      RUN_INSTALL_ZSH=1
      ;;
    -inall | --install-dependencies-new-all)
      RUN_INSTALL_DEPENDENCIES_ADDITIONAL=1
      RUN_INSTALL_NVIM=1
      RUN_INSTALL_GHOSTTY=1
      # RUN_SETUP_TMUX=0
      ;;
    -nsb | --not-setup-bin)
      RUN_SETUP_BIN=0
      ;;
    -nsgt | --not-setup-ghostty)
      RUN_SETUP_GHOSTTY=0
      ;;
    -nsv | --not-setup-nvim)
      RUN_SETUP_NVIM=0
      ;;
    -nsz | --not-setup-zed)
      RUN_SETUP_ZED=0
      ;;
    -nsp | --not-setup-profiles)
      RUN_SETUP_PROFILES=0
      ;;
    -nsg | --not-setup-gitconfig)
      RUN_SETUP_GITCONFIG=0
      ;;
    -ds | --disable-setups)
      RUN_SETUP_BIN=0
      RUN_SETUP_GHOSTTY=0
      RUN_SETUP_NVIM=0
      RUN_SETUP_ZED=0
      RUN_SETUP_PROFILES=0
      RUN_SETUP_GITCONFIG=0
      # RUN_SETUP_TMUX=0
      # RUN_SETUP_ZSH=0
      # RUN_SETUP_CODE=0
      ;;
    -szh | --setup-zsh)
      RUN_SETUP_ZSH=1
      ;;
    -stx | --setup-tmux)
      RUN_SETUP_TMUX=1
      ;;
    -scd | --setup-code)
      RUN_SETUP_CODE=1
      ;;
    -ice | --install-code-ext)
      RUN_INSTALL_CODE_EXT=1
      ;;
    -ifont | --install-fonts)
      RUN_INSTALL_FONTS=1
      ;;
    -igh | --install-github-cli)
      RUN_INSTALL_GH=1
      ;;
    -s)
      INSTALL_SOURCE_FROM=source
      ;;
    -d | --debug)
      set -x
      ;;
    -upc | --update-check)
      RUN_SETUP_BIN=0
      RUN_SETUP_NVIM=0
      RUN_SETUP_ZED=0
      RUN_SETUP_PROFILES=0
      RUN_SETUP_GITCONFIG=0
      # RUN_SETUP_TMUX=0
      # RUN_SETUP_ZSH=0
      # RUN_SETUP_CODE=0

      echo
      check_for_newer_tag "$VERSION_GHOSTTY_REPO" "$VERSION_GHOSTTY"
      check_for_newer_tag "$VERSION_NVIM_REPO" "$VERSION_NVIM"
      check_for_newer_tag "$VERSION_ZSH_REPO" "$VERSION_ZSH" "-test"
      check_for_newer_tag "$VERSION_TMUX_REPO" "$VERSION_TMUX"
      check_for_newer_tag "$VERSION_BTOP_REPO" "$VERSION_BTOP"
      check_for_newer_tag "$VERSION_RSMI_REPO" "$VERSION_RSMI" "rocm"
      check_for_newer_tag "$VERSION_HUNK_REPO" "$VERSION_HUNK"
      check_for_newer_tag "$VERSION_FONTS_REPO" "$VERSION_FONTS_RELEASE"
      ;;
    *)
      print_error "❌ Unknown option: $key"
      usage
      exit 1
      ;;
    esac
    shift
  done
}

# ******************************************************************************

print_info2 "▶️ Starting script $0 ..."

parse_args "$@"

main
exit 0
