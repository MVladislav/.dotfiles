#!/usr/bin/env bash
PATH="/usr/bin/:/usr/local/bin/:/bin:/usr/sbin/:/sbin:/snap/bin/:$HOME/.local/bin"
set -euo pipefail

# editorconfig-checker-disable
cat <<'EOF'
     .--.
    |o_o |  Let's get your system ready!
    |:_/ |
   //   \ \
  (|     | )
 /'\_   _/`\
 \___)=(___/

EOF
# editorconfig-checker-enable

[[ -f "./setup-helper" ]] || { echo 'ERROR: "./setup-helper" not found.'; exit 1; }
source "./setup-helper"

[[ -f "./setup-install" ]] || { echo 'ERROR: "./setup-install" not found.'; exit 1; }
# shellcheck source=setup-install
source "./setup-install"

[[ -f "./setup-config" ]] || { echo 'ERROR: "./setup-config" not found.'; exit 1; }
# shellcheck source=setup-config
source "./setup-config"

[[ -f "./setup-upc" ]] || { echo 'ERROR: "./setup-upc" not found.'; exit 1; }
# shellcheck source=setup-upc
source "./setup-upc"

# ******************************************************************************

# CONFIG :: toggle flags -------------------------------------------------------
RUN_INSTALL_DEPENDENCIES_ADDITIONAL=0
RUN_INSTALL_DEPENDENCIES_DEV=0
RUN_INSTALL_TMUX=0
RUN_INSTALL_NVIM=0
RUN_INSTALL_ZSH=0
RUN_INSTALL_GHOSTTY=0

RUN_SETUP_BIN=1
RUN_SETUP_GHOSTTY=1
RUN_SETUP_NVIM=1
RUN_SETUP_ZED=1
RUN_SETUP_PROFILES=1
RUN_SETUP_GITCONFIG=1

RUN_SETUP_BTOP=0
RUN_SETUP_HUNK=0
RUN_SETUP_OPENLOGI=0
RUN_SETUP_TMUX=0
RUN_SETUP_ZSH=0

RUN_SETUP_CODE=0
RUN_INSTALL_CODE_EXT=0

RUN_INSTALL_FONTS=0
RUN_INSTALL_BTOP=0
RUN_INSTALL_BTOP_AMD=0
RUN_INSTALL_BTOP_INTEL=0
RUN_INSTALL_ANDROID=0
RUN_INSTALL_HUNK=0
RUN_INSTALL_OPENLOGI=0
RUN_INSTALL_INPUT_LINUX=0

RUN_INSTALL_GH=0

RUN_UPDATE_CHECK=0
RUN_UPDATE_SUBMODULES=0

# CONFIG :: version pins -------------------------------------------------------
VERSION_ZIG_V=0.17.1
VERSION_ZIG_URL="https://ziglang.org/download/${VERSION_ZIG_V}/zig-x86_64-linux-${VERSION_ZIG_V}.tar.xz"
VERSION_GHOSTTY=v1.4.0
VERSION_GHOSTTY_REPO=https://github.com/ghostty-org/ghostty.git
VERSION_NVIM=v0.12.6
VERSION_NVIM_REPO=https://github.com/neovim/neovim.git
VERSION_ZSH=zsh-5.9.2
VERSION_ZSH_REPO=https://github.com/zsh-users/zsh.git
VERSION_TMUX=3.8
VERSION_TMUX_REPO=https://github.com/tmux/tmux.git
VERSION_BTOP=v1.4.8
VERSION_BTOP_REPO=https://github.com/aristocratos/btop.git
VERSION_RSMI=rocm-7.2.4
VERSION_RSMI_REPO=https://github.com/ROCm/rocm-systems.git
VERSION_HUNK=v0.25.0
VERSION_HUNK_REPO=https://github.com/modem-dev/hunk.git
VERSION_OPENLOGI=v0.9.0
VERSION_OPENLOGI_REPO=https://github.com/AprilNEA/OpenLogi.git
VERSION_INPUT_LINUX=v1.1.0-Community
VERSION_INPUT_LINUX_REPO=https://github.com/worklouder/input-linux
VERSION_FONTS_RELEASE=v3.5.1
VERSION_FONTS_REPO=https://github.com/ryanoasis/nerd-fonts
VERSION_GH_REPO=https://github.com/cli/cli

# CONFIG :: ghostty iTerm2 theme overrides -------------------------------------
# GHOSTTY_ITERM_RO='https://github.com/mbadolato/iTerm2-Color-Schemes/releases/download/release-20251002-142451-4a5043e/ghostty-themes.tgz'
# GHOSTTY_ITERM_ROH='N-V-__8AALIsAwDyo88G5mGJGN2lSVmmFMx4YePfUvp_2o3Y' # pragma: allowlist secret
# GHOSTTY_ITERM_RN='https://github.com/mbadolato/iTerm2-Color-Schemes/releases/download/release-20251110-150531-d5f3d53/ghostty-themes.tgz'
# GHOSTTY_ITERM_RNH='N-V-__8AAPZCAwDJ0OsIn2nbr3FMvBw68oiv-hC2pFuY1eLN' # pragma: allowlist secret

# CONFIG :: paths --------------------------------------------------------------
LN_VM_BIN="${LN_VM_BIN:-"$USER_LOCAL_PREFIX_BIN/vm"}"

LN_GHOSTTY="${LN_GHOSTTY:-"$HOME/.config/ghostty"}"

LN_NVIM="${LN_NVIM:-"$HOME/.config/nvim"}"

LN_ZSH="${LN_ZSH:-"$HOME/.zsh"}"
LN_ZSHRC="${LN_ZSHRC:-"$HOME/.zshrc"}"

LN_TMUX="${LN_TMUX:-"$HOME/.tmux"}"
LN_TMUX_CONF="${LN_TMUX_CONF:-"$HOME/.tmux.conf"}"

LN_ZED_FLATPAK="$HOME/.var/app/dev.zed.Zed/config/zed"
LN_ZED="${LN_ZED:-"$LN_ZED_FLATPAK"}"
LN_ZED_CODEBOOK="${LN_ZED_CODEBOOK:-"$HOME/.config/codebook"}"

LN_VS_CODE="${LN_VS_CODE:-"$HOME/.config/Code/User"}"

LN_PROFILES_01="${LN_PROFILES_01:-"$HOME/.profile-append"}"
LN_PROFILES_02="${LN_PROFILES_02:-"$HOME/.profile-sec"}"

LN_LAZYGIT="${LN_LAZYGIT:-"$HOME/.config/lazygit/config.yml"}"

LN_GIT_HOOK_COMMIT_MSG="${LN_GIT_HOOK_COMMIT_MSG:-"$HOME/.git-hooks/commit-msg"}"
LN_GIT_HOOK_PRE_COMMIT="${LN_GIT_HOOK_PRE_COMMIT:-"$HOME/.git-hooks/pre-commit"}"

LN_BTOP="${LN_BTOP:-"$HOME/.config/btop/btop.conf"}"
LN_HUNK="${LN_HUNK:-"$HOME/.config/hunk/config.toml"}"

LN_OPENLOGI_CONFIG="${LN_OPENLOGI_CONFIG:-"${XDG_CONFIG_HOME:-$HOME/.config}/openlogi/config.toml"}"
LN_OPENLOGI_AGENT="${LN_OPENLOGI_AGENT:-"$HOME/.config/systemd/user/openlogi-agent.service"}"
LN_OPENLOGI_APPLICATIONS="${LN_OPENLOGI_APPLICATIONS:-"$HOME/.local/share/applications"}"
LN_OPENLOGI_ICONS="${LN_OPENLOGI_ICONS:-"$HOME/.local/share/icons/hicolor"}"
LN_OPENLOGI_UDEV="${LN_OPENLOGI_UDEV:-/etc/udev/rules.d/70-openlogi.rules}"
LN_INPUT_LINUX_APPLICATIONS="${LN_INPUT_LINUX_APPLICATIONS:-"$HOME/.local/share/applications"}"
LN_INPUT_LINUX_ICONS="${LN_INPUT_LINUX_ICONS:-"$HOME/.local/share/icons/hicolor"}"
LN_INPUT_LINUX_UDEV="${LN_INPUT_LINUX_UDEV:-/etc/udev/rules.d/70-worklouder.rules}"

# ******************************************************************************

# HELPERS :: disable setup flags -----------------------------------------------
disable_setups() {
  RUN_SETUP_BIN=0
  RUN_SETUP_GHOSTTY=0
  RUN_SETUP_NVIM=0
  RUN_SETUP_ZED=0
  RUN_SETUP_PROFILES=0
  RUN_SETUP_GITCONFIG=0
  RUN_SETUP_BTOP=0
  RUN_SETUP_HUNK=0
  RUN_SETUP_OPENLOGI=0
  RUN_SETUP_TMUX=0
  RUN_SETUP_ZSH=0
  RUN_SETUP_CODE=0
}

# MAIN :: entry point ----------------------------------------------------------
main() {
  if [[ $INSTALL_SOURCE_FROM != "source" && $INSTALL_SOURCE_FROM != "release" ]]; then
    print_error "❌ Invalid value for INSTALL_SOURCE_FROM: $INSTALL_SOURCE_FROM"
    exit 1
  fi

  if [[ $RUN_UPDATE_CHECK -eq 1 ]]; then
    run_update_check
    print_info2 "\n✅ Update check finished!"
    exit 0
  fi

  if [[ $RUN_UPDATE_SUBMODULES -eq 1 ]]; then
    run_submodule_bump
    print_info2 "\n✅ Submodule pins bumped - commit the gitlink changes when ready."
    exit 0
  fi

  sudo_drop
  mkdir -p "$HOME/.config" "$DEPS_INSTALL_PATH"
  run_if $RUN_INSTALL_DEPENDENCIES_ADDITIONAL && install_dependencies_additional
  run_if $RUN_INSTALL_DEPENDENCIES_DEV && install_dependencies_dev

  run_if $RUN_INSTALL_GHOSTTY && install_ghostty
  run_if $RUN_INSTALL_NVIM && install_nvim
  run_if $RUN_INSTALL_ZSH && install_zsh
  run_if $RUN_INSTALL_TMUX && install_tmux

  run_if $RUN_INSTALL_BTOP && install_btop
  run_if $RUN_INSTALL_ANDROID && install_android_emulator
  run_if $RUN_INSTALL_HUNK && install_hunk
  run_if $RUN_INSTALL_OPENLOGI && install_openlogi
  run_if $RUN_INSTALL_INPUT_LINUX && install_input_linux

  run_if $RUN_SETUP_BIN && setup_bin
  run_if $RUN_SETUP_GHOSTTY && setup_ghostty
  run_if $RUN_SETUP_NVIM && setup_nvim
  run_if $RUN_SETUP_ZED && setup_zed
  run_if $RUN_SETUP_PROFILES && setup_profiles
  run_if $RUN_SETUP_GITCONFIG && setup_gitconfig

  run_if $RUN_SETUP_ZSH && setup_zsh
  run_if $RUN_SETUP_TMUX && setup_tmux
  run_if $RUN_SETUP_CODE && setup_code
  run_if $RUN_SETUP_BTOP && setup_btop
  run_if $RUN_SETUP_HUNK && setup_hunk
  run_if $RUN_SETUP_OPENLOGI && setup_openlogi

  run_if $RUN_INSTALL_CODE_EXT && install_code_ext
  run_if $RUN_INSTALL_FONTS && install_fonts

  run_if $RUN_INSTALL_GH && install_gh

  print_info2 "\n✅ All finished!"
}

# ******************************************************************************

# CLI :: usage -----------------------------------------------------------------
usage() {
  print_info "\n📖 Usage: $0 [options]"
  print_info "   Symlink dotfiles and optionally install/update tools"
  print_info ""
  print_info "   🎯 Examples:"
  print_info "     $0                                           Only run config symlinks, no installations"
  print_info "     $0 -ifont                                    Run config symlinks + install fonts"
  print_info "     $0 -ds -invim                                Install nvim only (no symlinks)"
  print_info "     $0 -itools -idev                             Install CLI tools + dev deps + symlinks"
  print_info "     $0 -it -invim -izsh -ighost                  Install nvim, zsh, ghostty + tools + symlinks"
  print_info "     $0 -upc                                      Check for newer versions of all tools"
  print_info ""
  print_info "     Install and config are separate steps. Pair the -i flag"
  print_info "     with the -s flag for tools whose config is not on by default:"
  print_info "     $0 -ibtop -sbt                             Install btop, then copy its config"
  print_info "     $0 -ihunk -shk                             Install hunk, link config + set git pager"
  print_info "     $0 -izsh -szh                              Install zsh, then link its config"
  print_info "     $0 -itmux -stx                             Install tmux, then link its config"
  print_info "     $0 -ice -scd                               Install VS Code extensions, link config"
  print_info ""
  print_info "     nvim and ghostty configs are linked by default, so they need"
  print_info "     no -s flag: $0 -invim | $0 -ighost"
  print_info ""
  print_info "   ⚙️ Install flags (enable tool installations):"
  print_info "     -itools      --install-additional-tools         CLI tools: curl, git, git-delta, jq, fzf, eza, bat, ripgrep, fd-find, ..."
  print_info "     -idev        --install-additional-dev           Dev tools: node, rust, go, shellcheck, lazygit, uv, prek"
  print_info "     -invim       --install-dependencies-nvim        Build and install neovim from source"
  print_info "     -itmux       --install-dependencies-tmux        Build and install tmux from source"
  print_info "     -izsh        --install-dependencies-zsh         Install zsh (source build with -s, else apt)"
  print_info "     -ighost      --install-dependencies-ghostty     Build and install ghostty terminal"
  print_info "     -ibtop       --install-btop                     Build and install btop system monitor"
  print_info "     -ibtop-amd   --install-btop-amd                 btop with AMD GPU support (ROCm)"
  print_info "     -ibtop-intel --install-btop-intel               btop + Intel GPU support"
  print_info "     -ihunk       --install-hunk                     Install hunk git diff pager"
  print_info "     -iolog       --install-openlogi                 Build and install OpenLogi from source (user prefix)"
  print_info "     -iin         --install-input-linux              Install Work Louder Input AppImage (user prefix)"
  print_info "     -iemu        --install-android-emulator         Interactive Android emulator setup"
  print_info "     -igh         --install-github-cli               Install GitHub CLI from releases"
  print_info "     -ice         --install-code-ext                 Install VS Code extensions"
  print_info "     -ifont       --install-fonts                    Download and install Nerd Fonts"
  print_info ""
  print_info "   🔗 Setup flags (symlink configs, enabled by default):"
  print_info "     -nsb         --not-setup-bin                    Skip linking ~/bin scripts"
  print_info "     -nsv         --not-setup-nvim                   Skip linking nvim config"
  print_info "     -nsz         --not-setup-zed                    Skip linking zed config"
  print_info "     -nsp         --not-setup-profiles               Skip linking shell profiles"
  print_info "     -nsg         --not-setup-gitconfig              Skip git config setup"
  print_info "     -nsgt        --not-setup-ghostty                Skip linking ghostty config"
  print_info "     -ds          --disable-setups                   Skip all symlink setups"
  print_info "     -stx         --setup-tmux                       Force tmux symlink setup"
  print_info "     -szh         --setup-zsh                        Force zsh symlink setup"
  print_info "     -scd         --setup-code                       Link VS Code config"
  print_info "     -sbt         --setup-btop                       Copy btop config"
  print_info "     -shk         --setup-hunk                       Link hunk config + git pager"
  print_info "     -solog       --setup-openlogi                   Seed OpenLogi config if missing"
  print_info ""
  print_info "   🛠️ Meta flags:"
  print_info "     -h           --help                             Show this help"
  print_info "     -s                                              Build services from source (instead of release)"
  print_info "     -d           --debug                            Enable bash debug mode (set -x)"
  print_info "     -upc         --update-check                     Check all tools for newer versions"
  print_info "     -usub        --update-submodules                Refresh submodules to upstream tips (no configs)"
  print_info ""
  print_info "   💡 Quick combos:"
  print_info "     -ioall       --install-dependencies-old-all     Install tmux + nvim + zsh + tools"
  print_info "     -inall       --install-dependencies-new-all     Install ghostty + nvim + tools"
}

# CLI :: parse args ------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
    -h | --help)
      usage
      exit 0
      ;;
    -itools | --install-additional-tools)
      RUN_INSTALL_DEPENDENCIES_ADDITIONAL=1
      ;;
    -idev | --install-additional-dev)
      RUN_INSTALL_DEPENDENCIES_DEV=1
      ;;
    -ighost | --install-dependencies-ghostty)
      RUN_INSTALL_GHOSTTY=1
      ;;
    -invim | --install-dependencies-nvim)
      RUN_INSTALL_NVIM=1
      ;;
    -izsh | --install-dependencies-zsh)
      RUN_INSTALL_ZSH=1
      ;;
    -itmux | --install-dependencies-tmux)
      RUN_INSTALL_TMUX=1
      ;;
    -ibtop | --install-btop)
      RUN_INSTALL_BTOP=1
      ;;
    -ibtop-amd | --install-btop-amd)
      RUN_INSTALL_BTOP=1
      RUN_INSTALL_BTOP_AMD=1
      ;;
    -ibtop-intel | --install-btop-intel)
      RUN_INSTALL_BTOP=1
      RUN_INSTALL_BTOP_INTEL=1
      ;;
    -ihunk | --install-hunk)
      RUN_INSTALL_HUNK=1
      ;;
    -iolog | --install-openlogi)
      RUN_INSTALL_OPENLOGI=1
      ;;
    -iin | --install-input-linux)
      RUN_INSTALL_INPUT_LINUX=1
      ;;
    -iemu | --install-android-emulator)
      RUN_INSTALL_ANDROID=1
      ;;
    -ioall | --install-dependencies-old-all)
      RUN_INSTALL_DEPENDENCIES_ADDITIONAL=1
      RUN_INSTALL_TMUX=1
      RUN_INSTALL_NVIM=1
      RUN_INSTALL_ZSH=1
      ;;
    -inall | --install-dependencies-new-all)
      RUN_INSTALL_DEPENDENCIES_ADDITIONAL=1
      RUN_INSTALL_NVIM=1
      RUN_INSTALL_GHOSTTY=1
      ;;
    -nsb | --not-setup-bin)
      RUN_SETUP_BIN=0
      ;;
    -nsgt | --not-setup-ghostty)
      RUN_SETUP_GHOSTTY=0
      ;;
    -nsv | --not-setup-nvim)
      RUN_SETUP_NVIM=0
      ;;
    -nsz | --not-setup-zed)
      RUN_SETUP_ZED=0
      ;;
    -nsp | --not-setup-profiles)
      RUN_SETUP_PROFILES=0
      ;;
    -nsg | --not-setup-gitconfig)
      RUN_SETUP_GITCONFIG=0
      ;;
    -ds | --disable-setups)
      disable_setups
      ;;
    -szh | --setup-zsh)
      RUN_SETUP_ZSH=1
      ;;
    -stx | --setup-tmux)
      RUN_SETUP_TMUX=1
      ;;
    -sbt | --setup-btop)
      RUN_SETUP_BTOP=1
      ;;
    -shk | --setup-hunk)
      RUN_SETUP_HUNK=1
      ;;
    -solog | --setup-openlogi)
      RUN_SETUP_OPENLOGI=1
      ;;
    -scd | --setup-code)
      RUN_SETUP_CODE=1
      ;;
    -ice | --install-code-ext)
      RUN_INSTALL_CODE_EXT=1
      ;;
    -ifont | --install-fonts)
      RUN_INSTALL_FONTS=1
      ;;
    -igh | --install-github-cli)
      RUN_INSTALL_GH=1
      ;;
    -s)
      INSTALL_SOURCE_FROM=source
      ;;
    -d | --debug)
      set -x
      ;;
    -upc | --update-check)
      RUN_UPDATE_CHECK=1
      ;;
    -usub | --update-submodules)
      RUN_UPDATE_SUBMODULES=1
      ;;
    *)
      print_error "❌ Unknown option: $key"
      usage
      exit 1
      ;;
    esac
    shift
  done
}

# ******************************************************************************

print_info2 "▶️ Starting script $0 ..."

parse_args "$@"

main
exit 0
