#!/usr/bin/env bash
PATH="/usr/bin/:/usr/local/bin/:/bin:/usr/sbin/:/sbin:/snap/bin/:$HOME/.local/bin"
set -euo pipefail

cat <<'EOF'
     .--.
    |o_o |  Let's get your system ready!
    |:_/ |
   //   \ \
  (|     | )
 /'\_   _/`\
 \___)=(___/

EOF

[[ -f "./setup-helper" ]] || { echo 'ERROR: "./setup-helper" not found.'; exit 1; }
# shellcheck disable=SC1091
source "./setup-helper"

# ******************************************************************************

# CONFIG :: toggle flags -------------------------------------------------------
RUN_INSTALL_DEPENDENCIES_ADDITIONAL=0
RUN_INSTALL_DEPENDENCIES_DEV=0
RUN_INSTALL_TMUX=0
RUN_INSTALL_NVIM=0
RUN_INSTALL_ZSH=0
RUN_INSTALL_GHOSTTY=0

RUN_SETUP_BIN=1
RUN_SETUP_GHOSTTY=1
RUN_SETUP_NVIM=1
RUN_SETUP_ZED=1
RUN_SETUP_PROFILES=1
RUN_SETUP_GITCONFIG=1

RUN_SETUP_TMUX=0
RUN_SETUP_ZSH=0

RUN_SETUP_CODE=0
RUN_INSTALL_CODE_EXT=0

RUN_INSTALL_FONTS=0
RUN_INSTALL_BTOP=0
RUN_INSTALL_BTOP_AMD=0
RUN_INSTALL_BTOP_INTEL=0
RUN_INSTALL_ANDROID=0
RUN_INSTALL_HUNK=0

RUN_INSTALL_GH=0

# CONFIG :: version pins -------------------------------------------------------
VERSION_ZIG_V=0.15.2
VERSION_ZIG_URL="https://ziglang.org/download/${VERSION_ZIG_V}/zig-x86_64-linux-${VERSION_ZIG_V}.tar.xz"
VERSION_GHOSTTY=v1.3.1
VERSION_GHOSTTY_REPO=https://github.com/ghostty-org/ghostty.git
VERSION_NVIM=v0.12.3
VERSION_NVIM_REPO=https://github.com/neovim/neovim.git
VERSION_ZSH=zsh-5.9.1
VERSION_ZSH_REPO=https://github.com/zsh-users/zsh.git
VERSION_TMUX=3.7b
VERSION_TMUX_REPO=https://github.com/tmux/tmux.git
VERSION_BTOP=v1.4.7
VERSION_BTOP_REPO=https://github.com/aristocratos/btop.git
VERSION_RSMI=rocm-7.2.4
VERSION_RSMI_REPO=https://github.com/ROCm/rocm-systems.git
VERSION_HUNK=v0.17.6
VERSION_HUNK_REPO=https://github.com/modem-dev/hunk.git
VERSION_FONTS_RELEASE=v3.4.0
VERSION_FONTS_REPO=https://github.com/ryanoasis/nerd-fonts

# CONFIG :: ghostty iTerm2 theme overrides -------------------------------------
GHOSTTY_ITERM_RO='https://github.com/mbadolato/iTerm2-Color-Schemes/releases/download/release-20251002-142451-4a5043e/ghostty-themes.tgz'
GHOSTTY_ITERM_ROH='N-V-__8AALIsAwDyo88G5mGJGN2lSVmmFMx4YePfUvp_2o3Y' # pragma: allowlist secret
GHOSTTY_ITERM_RN='https://github.com/mbadolato/iTerm2-Color-Schemes/releases/download/release-20251110-150531-d5f3d53/ghostty-themes.tgz'
GHOSTTY_ITERM_RNH='N-V-__8AAPZCAwDJ0OsIn2nbr3FMvBw68oiv-hC2pFuY1eLN' # pragma: allowlist secret

# CONFIG :: paths --------------------------------------------------------------
LN_VM_BIN="${LN_VM_BIN:-"$USER_LOCAL_PREFIX_BIN/vm"}"

LN_GHOSTTY="${LN_GHOSTTY:-"$HOME/.config/ghostty"}"

LN_NVIM="${LN_NVIM:-"$HOME/.config/nvim"}"

LN_ZSH="$HOME/.zsh"
LN_ZSHRC="$HOME/.zshrc"

LN_TMUX="${LN_TMUX:-"$HOME/.tmux"}"
LN_TMUX_CONF="${LN_TMUX_CONF:-"$HOME/.tmux.conf"}"

LN_ZED_FLATPAK="$HOME/.var/app/dev.zed.Zed/config/zed"
# LN_ZED=$HOME/.config/zed
LN_ZED="${LN_ZED:-"$LN_ZED_FLATPAK"}"
LN_ZED_CODEBOOK="$HOME/.config/codebook"

LN_VS_CODE="${LN_VS_CODE:-"$HOME/.config/Code/User"}"

LN_PROFILES_01="$HOME/.profile-append"
LN_PROFILES_02="$HOME/.profile-sec"

LN_LAZYGIT="${LN_LAZYGIT:-"$HOME/.config/lazygit/config.yml"}"

LN_GIT_HOOK_COMMIT_MSG="$HOME/.git-hooks/commit-msg"
LN_GIT_HOOK_PRE_COMMIT="$HOME/.git-hooks/pre-commit"

LN_BTOP="${LN_BTOP:-"$HOME/.config/btop/btop.conf"}"
LN_HUNK="${LN_HUNK:-"$HOME/.config/hunk/config.toml"}"

# ******************************************************************************

# MAIN :: entry point ----------------------------------------------------------
main() {
  if [[ $INSTALL_SOURCE_FROM != "source" && $INSTALL_SOURCE_FROM != "release" ]]; then
    print_error "❌ Invalid value for INSTALL_SOURCE_FROM: $INSTALL_SOURCE_FROM"
    exit 1
  fi

  sudo_drop
  initialize_base
  run_if $RUN_INSTALL_DEPENDENCIES_ADDITIONAL && install_dependencies_additional
  run_if $RUN_INSTALL_DEPENDENCIES_DEV && install_dependencies_dev

  run_if $RUN_INSTALL_GHOSTTY && install_ghostty
  run_if $RUN_INSTALL_NVIM && install_nvim
  run_if $RUN_INSTALL_ZSH && install_zsh
  run_if $RUN_INSTALL_TMUX && install_tmux

  run_if $RUN_INSTALL_BTOP && install_btop
  run_if $RUN_INSTALL_ANDROID && install_setup_android_emulator
  run_if $RUN_INSTALL_HUNK && install_hunk

  run_if $RUN_SETUP_BIN && setup_bin
  run_if $RUN_SETUP_GHOSTTY && setup_ghostty
  run_if $RUN_SETUP_NVIM && setup_nvim
  run_if $RUN_SETUP_ZED && setup_zed
  run_if $RUN_SETUP_PROFILES && setup_profiles
  run_if $RUN_SETUP_GITCONFIG && setup_gitconfig

  run_if $RUN_SETUP_ZSH && setup_zsh
  run_if $RUN_SETUP_TMUX && setup_tmux
  run_if $RUN_SETUP_CODE && setup_code

  run_if $RUN_INSTALL_CODE_EXT && install_code_ext
  run_if $RUN_INSTALL_FONTS && install_fonts

  run_if $RUN_INSTALL_GH && download_github_binary 'https://github.com/cli/cli' 'gh_.*_linux_amd64\.tar\.gz'

  print_info2 "\n✅ All finished!"
}

# ******************************************************************************

# BASE :: initialize -----------------------------------------------------------
initialize_base() {
  mkdir -p "$HOME/.config"
}

# ******************************************************************************

# DEPS :: additional -----------------------------------------------------------
install_dependencies_additional() {
  print_info2 "\n🚀 DEPS :: installing additional base services"

  if ! command -v fzf &>/dev/null; then
    print_notes "   📦 installing fzf (needed for package selection)..."
    $RUN_WITH_SUDO apt-get install -y fzf 1>/dev/null
  fi

  local tools=(
    "curl:URL retrieval tool"
    "git:Version control system"
    "git-delta:Git diff viewer"
    "pigz:Parallel gzip"
    "jq:JSON processor"
    "rsync:File synchronization"
    "wl-clipboard:Wayland clipboard tools"
    "eza:Modern ls replacement"
    "bat:Cat with syntax highlighting"
    "ripgrep:Fast text search"
    "fd-find:Find alternative"
  )

  local selections
  selections=$(
    printf '%s\n' "${tools[@]}" \
      | fzf --height=~40% --multi --cycle --border \
        --prompt="Select packages > " --preview-window=hidden \
        --bind 'start:select-all+down' \
        --footer="📦 select packages (Tab to toggle, Enter to confirm):" \
      | awk -F: '{print $1}'
  )

  if [[ -n "$selections" ]]; then
    local -a pkgs
    mapfile -t pkgs <<< "$selections"
    print_notes "   📦 installing: ${pkgs[*]}"
    $RUN_WITH_SUDO apt-get install -y "${pkgs[@]}" 1>/dev/null
  else
    print_notes "   💡 no packages selected, skipping"
  fi

  if echo "$selections" | grep -qx 'rsync'; then
    print_notes "   ⚙️ disabling rsync systemd service..."
    $RUN_WITH_SUDO systemctl disable rsync.service &>/dev/null
    $RUN_WITH_SUDO systemctl mask rsync.service &>/dev/null
  fi

  sudo_drop
  print_info2 "✅ DEPS :: base services installed!"
}

# DEPS :: dev ------------------------------------------------------------------
install_dependencies_dev() {
  print_info2 "\n🚀 DEPS :: installing dev dependencies"

  local tools=(
    "node:Node.js runtime (snap)"
    "rustup:Rust toolchain manager (snap)"
    "go:Go programming language (snap)"
    "shellcheck:Shell script analyzer (snap)"
    "httpie:HTTPie API client (snap)"
    "python-dev:Python dev tools (pip, venv) (apt)"
    "lazygit:Git TUI (go install)"
    "uv-prek:uv + prek package tools (pip)"
  )

  local selections
  selections=$(
    printf '%s\n' "${tools[@]}" \
      | fzf --height=~40% --multi --cycle --border \
        --prompt="Select dev tools > " --preview-window=hidden \
        --footer="📦 select dev packages (Tab to toggle, Enter to confirm):" \
      | awk -F: '{print $1}'
  )

  [[ -z "$selections" ]] && { print_notes "   💡 no dev packages selected, skipping"; return 0; }

  # Phase 1: install packages
  local apt_pkgs=()
  for sel in $selections; do
    case "$sel" in
      node)     print_notes "   📦 installing npm...";       $RUN_WITH_SUDO snap install node --classic 1>/dev/null ;;
      rustup)   print_notes "   📦 installing rust...";      $RUN_WITH_SUDO snap install rustup --classic 1>/dev/null ;;
      go)       print_notes "   📦 installing go...";        $RUN_WITH_SUDO snap install go --classic 1>/dev/null ;;
      shellcheck) print_notes "   📦 installing shellcheck..."; $RUN_WITH_SUDO snap install shellcheck 1>/dev/null ;;
      httpie)   print_notes "   📦 installing httpie...";    $RUN_WITH_SUDO snap install httpie 1>/dev/null ;;
      python-dev) apt_pkgs+=(python3-pip python3-venv python3-dev) ;;
    esac
  done
  ((${#apt_pkgs[@]} > 0)) && { print_notes "   📦 installing python3 pip, venv and dev..."; $RUN_WITH_SUDO apt-get install -y "${apt_pkgs[@]}" 1>/dev/null; }

  sudo_drop

  # Phase 2: post-install setup
  for sel in $selections; do
    case "$sel" in
      rustup)   print_notes "   ⚙️ setting up rustup...";   rustup default stable 1>/dev/null ;;
      lazygit)
        if ! command -v go &>/dev/null; then
          print_error "  ❌ 'go' not found — install 'go' first or install it manually"
        else
          print_notes "   📦 installing lazygit..."
          go install github.com/jesseduffield/lazygit@latest 1>/dev/null
        fi
        ;;
      uv-prek)
        if ! command -v python3 &>/dev/null; then
          print_error "  ❌ 'python3' not found — install 'python-dev' first"
        else
          print_notes "   📦 installing uv and prek..."
          python3 -m venv "$HOME/.venv"
          # shellcheck disable=SC1091
          source "$HOME/.venv/bin/activate"
          python3 -m pip install uv prek 1>/dev/null
        fi
        ;;
    esac
  done

  # cargo install impala    # https://github.com/pythops/impala
  # cargo install wiremix   # https://github.com/tsowell/wiremix

  print_info2 "✅ DEPS :: dev dependencies installed!"
}

# ******************************************************************************

# SERVICE :: install ghostty ---------------------------------------------------
install_ghostty() {
  print_info2 "\n🚀 GHOSTTY :: install ghostty ..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/ghostty" --version 2>/dev/null | head -n1)'"
  rm -rf "$DEPS_INSTALL_PATH/ghostty" 1>/dev/null

  # Define packages needed for build and install
  local packages_tools=(libgtk4-layer-shell0)
  local packages_build=(curl git libgtk-4-dev libgtk4-layer-shell-dev libadwaita-1-dev gettext libxml2-utils blueprint-compiler)
  install_dependencies_needs packages_tools[@] packages_build[@]

  local ZIG_COMMAND=zig
  if ! command -v zig >/dev/null 2>&1; then
    print_notes "   📦 downloading zig binary..."
    curl -L -so "$DEPS_INSTALL_PATH/zig.tar.xz" "$VERSION_ZIG_URL"
    mkdir -p "$DEPS_INSTALL_PATH/zig"
    tar xf "$DEPS_INSTALL_PATH/zig.tar.xz" -C "$DEPS_INSTALL_PATH/zig" --strip-components=1
    ZIG_COMMAND="$DEPS_INSTALL_PATH/zig/zig"
  fi

  print_notes "   📦 cloning ghostty..."
  git clone -q "$VERSION_GHOSTTY_REPO" "$DEPS_INSTALL_PATH/ghostty"
  pushd "$DEPS_INSTALL_PATH/ghostty" 1>/dev/null
  [[ $INSTALL_SOURCE_FROM == 'release' ]] && git checkout -q "$VERSION_GHOSTTY"

  print_notes "   🔧 building and installing ghostty..."
  sed -i "s|$GHOSTTY_ITERM_RO|$GHOSTTY_ITERM_RN|g" ./build.zig.zon
  sed -i "s|$GHOSTTY_ITERM_ROH|$GHOSTTY_ITERM_RNH|g" ./build.zig.zon
  "$ZIG_COMMAND" build -p "$USER_LOCAL_PREFIX" -Doptimize=ReleaseFast 1>/dev/null
  popd 1>/dev/null
  rm -rf "$DEPS_INSTALL_PATH/ghostty" 1>/dev/null
  update-desktop-database "$USER_LOCAL_PREFIX/share/applications/" -q
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/ghostty" --version 2>/dev/null | head -n1)'"

  if command -v gsettings &>/dev/null; then
    print_notes "   ⚙️ switching default keybind to open terminal ('<Ctrl><Alt>T')"
    gsettings set org.gnome.settings-daemon.plugins.media-keys terminal "['']"
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/ name "'Open Custom Terminal'"
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/ binding "'<Ctrl><Alt>T'"
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/ command "'ghostty'"
    gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']"
  fi

  print_notes "   💡 for 'xterm compatibility', use vm_xterm_cp_local (sudo) or vm_xterm_cp_ssh (SSH)"

  # Remove build dependencies if any
  install_dependencies_needs_rm

  print_info2 "✅ GHOSTTY :: ghostty installed!"

  setup_ghostty
}

# SERVICE :: install nvim ------------------------------------------------------
install_nvim() {
  print_info2 "\n🚀 NVIM :: install nvim..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/nvim" -v 2>/dev/null | head -n1)'"
  rm -rf "$DEPS_INSTALL_PATH/nvim" 1>/dev/null

  # Define packages needed for build and install
  local packages_tools=(python3-venv)
  local packages_build=(git curl ninja-build gettext cmake build-essential)
  install_dependencies_needs packages_tools[@] packages_build[@]

  print_notes "   📦 cloning nvim..."
  git clone -q "$VERSION_NVIM_REPO" "$DEPS_INSTALL_PATH/nvim"
  pushd "$DEPS_INSTALL_PATH/nvim" 1>/dev/null
  [[ $INSTALL_SOURCE_FROM == 'release' ]] && git checkout -q "$VERSION_NVIM"

  print_notes "   🔧 building and installing nvim..."
  # CMAKE_BUILD_TYPE: Release | RelWithDebInfo
  make CMAKE_BUILD_TYPE=Release CMAKE_INSTALL_PREFIX="$USER_LOCAL_PREFIX/" 1>/dev/null
  make install 1>/dev/null
  popd 1>/dev/null
  rm -rf "$DEPS_INSTALL_PATH/nvim" 1>/dev/null
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/nvim" -v 2>/dev/null | head -n1)'"

  # Remove build dependencies if any
  install_dependencies_needs_rm

  print_notes "   💡 install 'node' for Mason plugin support"
  print_info2 "✅ NVIM :: nvim installed!"
}

# SERVICE :: install zsh -------------------------------------------------------
install_zsh() {
  print_info2 "\n🚀 ZSH :: install zsh ..."
  print_notes "   💡 current installed version :: '$(zsh --version 2>/dev/null | head -n1)'"
  rm -rf "$DEPS_INSTALL_PATH/zsh" 1>/dev/null

  if [[ $INSTALL_SOURCE_FROM == 'source' ]]; then
    # Define packages needed for build and install
    local packages_tools=()
    local packages_build=(gcc make autoconf yodl texinfo libncurses-dev)
    install_dependencies_needs packages_tools[@] packages_build[@]
  fi

  if [[ $INSTALL_SOURCE_FROM == 'source' ]]; then
    print_notes "   📦 cloning zsh..."
    git clone -q "$VERSION_ZSH_REPO" "$DEPS_INSTALL_PATH/zsh"
    pushd "$DEPS_INSTALL_PATH/zsh" 1>/dev/null
    git checkout -q "${VERSION_ZSH}"

    print_notes "   🔧 building and installing zsh..."
    ./Util/preconfig 1>/dev/null
    ./configure --prefix="$USER_LOCAL_PREFIX/" 1>/dev/null
    make 1>/dev/null
    make install 1>/dev/null
    popd 1>/dev/null
    rm -rf "$DEPS_INSTALL_PATH/zsh" 1>/dev/null
  elif [[ $INSTALL_SOURCE_FROM == 'release' ]]; then
    print_notes "   📦 installing zsh..."
    $RUN_WITH_SUDO apt-get install -y zsh 1>/dev/null
  fi
  sudo_drop

  local zsh_install_bin_path
  zsh_install_bin_path=$(command -v zsh >/dev/null 2>&1 || echo "/usr/bin/zsh")
  # zsh_install_bin_path="$USER_LOCAL_PREFIX/bin/zsh"

  print_notes "   💡 new installed version :: '$(zsh --version 2>/dev/null | head -n1)'"

  setup_zsh

  if [[ "$(basename "$SHELL")" != "zsh" ]]; then
    print_info2 "🚀 ZSH :: setting zsh as default shell for user '$USER'"
    # sudo chsh -s "$(which zsh)" "$USER"
    $RUN_WITH_SUDO chsh -s "$zsh_install_bin_path" "$USER" || {
      print_error "  ❌ failed to change default shell to ZSH. Run 'sudo chsh -s \"$(which zsh)\" \"$USER\"' manually."
    }
    sudo_drop
  fi

  # Remove build dependencies if any
  [[ $INSTALL_SOURCE_FROM == 'source' ]] && install_dependencies_needs_rm

  print_info2 "✅ ZSH :: zsh installed!"
}

# SERVICE :: install tmux ------------------------------------------------------
install_tmux() {
  print_info2 "\n🚀 TMUX :: install tmux..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/tmux" -V 2>/dev/null)'"
  rm -rf "$DEPS_INSTALL_PATH/tmux" 1>/dev/null

  # Define packages needed for build and install
  local packages_tools=(libevent-dev)
  local packages_build=(git unzip curl jq build-essential pkg-config libncurses-dev bison)
  install_dependencies_needs packages_tools[@] packages_build[@]

  print_notes "   📦 cloning tmux..."
  git clone -q "$VERSION_TMUX_REPO" "$DEPS_INSTALL_PATH/tmux"
  pushd "$DEPS_INSTALL_PATH/tmux" 1>/dev/null
  [[ $INSTALL_SOURCE_FROM == 'release' ]] && git checkout -q "$VERSION_TMUX"
  bash ./autogen.sh 1>/dev/null

  print_notes "   🔧 building and installing tmux..."
  bash ./configure --prefix="$USER_LOCAL_PREFIX/" 1>/dev/null
  make 1>/dev/null
  make install 1>/dev/null
  popd 1>/dev/null
  rm -rf "$DEPS_INSTALL_PATH/tmux" 1>/dev/null
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/tmux" -V 2>/dev/null)'"

  setup_tmux

  # Remove build dependencies if any
  install_dependencies_needs_rm

  print_info2 "✅ TMUX :: tmux installed!"
}

# ******************************************************************************

# SERVICE :: install btop ------------------------------------------------------
install_btop() {
  print_info2 "\n🚀 BTOP :: install btop..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/btop" -v 2>/dev/null | head -n1)'"
  rm -rf "$DEPS_INSTALL_PATH/btop" 1>/dev/null

  # Define packages needed for build and install
  local packages_tools=()
  local packages_build=(git build-essential cmake libdrm-dev pkg-config)
  install_dependencies_needs packages_tools[@] packages_build[@]

  print_notes "   📦 cloning btop..."
  git clone -q "$VERSION_BTOP_REPO" "$DEPS_INSTALL_PATH/btop"
  pushd "$DEPS_INSTALL_PATH/btop" 1>/dev/null
  [[ $INSTALL_SOURCE_FROM == 'release' ]] && git checkout -q "$VERSION_BTOP"

  local RSMI_STATIC='false'
  local ROCM_DIR='lib/rocm_smi_lib'
  local ROCM_PROJECT='rocm-smi-lib' # amdsmi
  if [[ $RUN_INSTALL_BTOP_AMD -eq 1 ]]; then
    print_notes "   📦 cloning and building rocm..."
    rm -rf $ROCM_DIR /tmp/rocm-systems 1>/dev/null
    mkdir -p lib
    git -c advice.detachedHead=false clone -q -b "$VERSION_RSMI" "$VERSION_RSMI_REPO" /tmp/rocm-systems
    mv "/tmp/rocm-systems/projects/$ROCM_PROJECT" "$ROCM_DIR"
    mkdir -p "${ROCM_DIR}/build"
    pushd "${ROCM_DIR}/build" 1>/dev/null
    cmake .. 1>/dev/null           # -DBUILD_TESTS=OFF -DENABLE_ESMI_LIB=ON -DBUILD_SHARED_LIBS=OFF
    make -j "$(nproc)" 1>/dev/null # amd_smi
    popd 1>/dev/null
    RSMI_STATIC='true'
  fi

  print_notes "   🔧 building and installing btop..."
  make -j "$(nproc)" GPU_SUPPORT="true" RSMI_STATIC="$RSMI_STATIC" ROCM_DIR="$ROCM_DIR" ADDFLAGS="-Wno-dangling-reference -march=native" 1>/dev/null
  make install PREFIX="$USER_LOCAL_PREFIX" 1>/dev/null

  popd 1>/dev/null
  rm -rf "$DEPS_INSTALL_PATH/btop" 1>/dev/null
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/btop" -v 2>/dev/null | head -n1)'"

  if [[ $RUN_INSTALL_BTOP_INTEL -eq 1 ]]; then
    print_notes "   ⚙️ configuring btop with setcap for GPU and CPU watts access without sudo"
    $RUN_WITH_SUDO setcap cap_perfmon,cap_dac_read_search,cap_sys_admin+ep "$USER_LOCAL_PREFIX_BIN/btop" 1>/dev/null
    sudo_drop
  else
    print_notes "   ⚙️ configuring btop with setcap for CPU watts access without sudo"
    $RUN_WITH_SUDO setcap cap_perfmon,cap_dac_read_search+ep "$USER_LOCAL_PREFIX_BIN/btop" 1>/dev/null
    sudo_drop
  fi

  # Remove build dependencies if any
  install_dependencies_needs_rm

  print_info2 "✅ BTOP :: btop installed!"

  setup_btop
}

# SERVICE :: install hunk ------------------------------------------------------
install_hunk() {
  print_info2 "\n🚀 HUNK :: install hunk..."
  print_notes "   💡 current installed version :: '$("$USER_LOCAL_PREFIX_BIN/hunk" --version 2>/dev/null)'"
  download_github_binary "$VERSION_HUNK_REPO" 'hunkdiff-linux-x64\.tar\.gz'
  print_notes "   💡 new installed version :: '$("$USER_LOCAL_PREFIX_BIN/hunk" --version 2>/dev/null)'"
  print_info2 "✅ HUNK :: hunk installed!"

  print_info2 "\n🔧 HUNK :: setting hunk as git pager"
  git config --global core.pager "hunk pager"

  print_info2 "🔗 HUNK :: linking configs-single/hunk.toml -> $LN_HUNK"
  create_symlink "${PWD}/configs-single/hunk.toml" "${LN_HUNK}"
  print_info2 "✅ HUNK :: all symlinks created."
}

# SERVICE :: install android emulator ------------------------------------------
install_setup_android_emulator() {
  # sudo apt install openjdk-26-jre-headless
  # --- Paths ----------------------------------------------------------
  export VM_ANDROID_PATH="${VM_ANDROID_PATH:-"$HOME/.android"}"
  export ANDROID_HOME="${ANDROID_HOME:-"$VM_ANDROID_PATH/Sdk"}"
  export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-"$ANDROID_HOME"}"
  mkdir -p "$ANDROID_HOME"

  command -v fzf >/dev/null 2>&1 || {
    print_error "❌ fzf not installed"
    exit 1
  }

  if [[ ! -x "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" ]]; then
    print_info2 "📦 downloading Android command-line tools..."
    # https://developer.android.com/studio#command-line-tools-only
    # - https://dl.google.com/android/repository/commandlinetools-<os>-<version>_latest.zip
    curl -sLo "$ANDROID_HOME/cmdline-tools.zip" \
      https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip

    unzip -q "$ANDROID_HOME/cmdline-tools.zip" -d "$ANDROID_HOME/cmdline-tools"
    mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"
    rm "$ANDROID_HOME/cmdline-tools.zip"
  fi

  SDKMANAGER="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
  AVDMANAGER="$ANDROID_HOME/cmdline-tools/latest/bin/avdmanager"
  EMULATOR="$ANDROID_HOME/emulator/emulator"

  # --- Accept licenses automatically ---------------------------------
  yes | "$SDKMANAGER" --licenses >/dev/null || true

  # --- Update SDK tools ----------------------------------------------
  # "$SDKMANAGER" --uninstall emulator
  "$SDKMANAGER" --update

  # --- Install build tools ----------------------
  print_info2 "📋 available build-tools:"
  BUILD_TOOLS=$("$SDKMANAGER" --list | grep -Eo 'build-tools;[0-9][^ ]+' | sort -ur)
  SELECTED_BUILD_TOOL=$(echo "$BUILD_TOOLS" | fzf --prompt="Select build-tools version: ")
  "$SDKMANAGER" "$SELECTED_BUILD_TOOL"

  # --- Show available system images and devices ----------------------
  print_info2 "📋 available system images:"
  IMAGES=$("$SDKMANAGER" --list | grep -Eo 'system-images;android-[0-9][^ ]+' | sort -ur)
  SELECTED_IMAGE=$(echo "$IMAGES" | fzf --prompt="Select system image: " --query="x86_64 api !store")

  print_info2 "📦 installing: $SELECTED_IMAGE ..."
  "$SDKMANAGER" "platform-tools" "emulator" "$SELECTED_IMAGE"

  # --- Choose device profile -----------------------------------------
  DEVICES=$("$AVDMANAGER" list devices | grep 'id:' | awk -F'"' '{print $2}' | grep 'pixel_' | sort -ur)
  SELECTED_DEVICE=$(echo "$DEVICES" | fzf --prompt="Select device profile: " --query="pro")

  # --- Create AVD ----------------------------------------------------
  SELECTED_IMAGE_NAME=$(basename "$SELECTED_IMAGE" | tr ';:' '_' | tr -d '[:punct:]')
  AVD_NAME=${SELECTED_IMAGE_NAME}_$(basename "$SELECTED_DEVICE")_"$(date +%s)"
  print_info2 "📱 creating AVD: $AVD_NAME ..."
  "$AVDMANAGER" create avd -n "$AVD_NAME" -k "$SELECTED_IMAGE" -d "$SELECTED_DEVICE" --force

  # --- Verify --------------------------------------------------------
  print_info2 "✅ available AVDs:"
  "$EMULATOR" -list-avds
}

