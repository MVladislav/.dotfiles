# UPDATE :: submodule pins -----------------------------------------------------
run_submodule_bump() {
  print_section "GIT :: submodule pin bump"
  print_info2 "📦 GIT :: following the upstream branch of every submodule"
  git submodule update -q --init --remote
  print_notes "   💡 '.gitmodules' sets 'ignore = all', so 'git status' stays quiet: review with"
  print_notes "      'git diff --submodule=log' and record a bump with 'git add <submodule-path>'"
  print_notes "      ('git add -A' and 'git commit -a' deliberately skip moved submodules)"
  print_section_end "✅ GIT :: submodule pins updated."
}

# SETUP :: zsh -----------------------------------------------------------------
setup_zsh() {
  print_section "ZSH :: config"
  print_info2 "📦 ZSH :: loading git submodules"
  git submodule update -q --init --remote \
    zsh/themes/spaceship \
    zsh/plugins/zsh-autosuggestions \
    zsh/plugins/zsh-syntax-highlighting \
    zsh/plugins/zsh-history-substring-search

  link_config "ZSH" "${PWD}/zsh/themes/spaceship/spaceship.zsh-theme" "$LN_ZSH/custom/themes/spaceship.zsh-theme"
  link_config "ZSH" "${PWD}/zsh/plugins/zsh-autosuggestions" "$LN_ZSH/custom/plugins/zsh-autosuggestions"
  link_config "ZSH" "${PWD}/zsh/plugins/zsh-syntax-highlighting" "$LN_ZSH/custom/plugins/zsh-syntax-highlighting"
  link_config "ZSH" "${PWD}/zsh/plugins/zsh-history-substring-search" "$LN_ZSH/custom/plugins/zsh-history-substring-search"
  link_config "ZSH" "${PWD}/zsh/zshrc" "$LN_ZSHRC"
  print_section_end "✅ ZSH :: config ready."
}

# SETUP :: tmux ----------------------------------------------------------------
setup_tmux() {
  print_section "TMUX :: config"
  link_config "TMUX" "${PWD}/tmux/tmux" "$LN_TMUX"
  link_config "TMUX" "${PWD}/tmux/tmux.conf" "$LN_TMUX_CONF"

  print_info2 "📦 TMUX :: loading git submodules"
  git submodule update -q --init --remote tmux/tmux/plugins/tpm
  if command -v tmux >/dev/null 2>&1; then
    print_info2 "🔧 TMUX :: running tpm to install plugins"
    PATH="$USER_LOCAL_PREFIX_BIN:$PATH" bash "${LN_TMUX}/plugins/tpm/bin/install_plugins" 1>/dev/null
  fi

  print_section_end "✅ TMUX :: config ready."
}

